@{
    Layout = null;
    ViewBag.Title = "Iniciar Sesion";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesion - APIS</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & FontAwesome -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background-color: #0f172a;
            overflow: hidden;
            position: relative;
        }

        /* Animated gradient orbs */
        body::before, body::after {
            content: '';
            position: fixed;
            border-radius: 50%;
            filter: blur(80px);
            opacity: 0.45;
            animation: floatOrb 8s ease-in-out infinite;
            pointer-events: none;
        }
        body::before {
            width: 500px; height: 500px;
            background: radial-gradient(circle, #1e40af 0%, #1d4ed8 60%, transparent 70%);
            top: -150px; left: -100px;
        }
        body::after {
            width: 400px; height: 400px;
            background: radial-gradient(circle, #7c3aed 0%, #4f46e5 60%, transparent 70%);
            bottom: -100px; right: -80px;
            animation-delay: -4s;
            animation-duration: 10s;
        }
        @@keyframes floatOrb {
            0%, 100% { transform: translate(0, 0) scale(1); }
            33%       { transform: translate(30px, -20px) scale(1.05); }
            66%       { transform: translate(-20px, 30px) scale(0.97); }
        }

        /* Subtle grid pattern */
        .login-bg-grid {
            position: fixed; inset: 0;
            background-image:
                linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
            background-size: 40px 40px;
            pointer-events: none;
        }

        .login-wrapper {
            width: 100%; max-width: 420px;
            animation: cardAppear 0.55s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative; z-index: 10;
        }
        @@keyframes cardAppear {
            from { opacity: 0; transform: translateY(24px) scale(0.97); }
            to   { opacity: 1; transform: translateY(0) scale(1); }
        }

        .login-card {
            background: rgba(255,255,255,0.97);
            border-radius: 22px;
            box-shadow:
                0 24px 48px -12px rgba(0,0,0,0.5),
                0 0 0 1px rgba(255,255,255,0.08),
                inset 0 1px 0 rgba(255,255,255,0.6);
            padding: 40px 36px 34px;
            position: relative; overflow: hidden;
        }

        /* Shimmer accent bar */
        .login-card::before {
            content: '';
            position: absolute; top: 0; left: 0; right: 0; height: 4px;
            background: linear-gradient(90deg, #1565c0, #3b82f6, #60a5fa, #818cf8);
            background-size: 200% 100%;
            animation: shimmerBar 3s ease infinite;
        }
        @@keyframes shimmerBar {
            0%   { background-position: 100% 0; }
            100% { background-position: -100% 0; }
        }

        .login-logo-wrap { text-align: center; margin-bottom: 20px; }
        .login-logo {
            height: 66px; border-radius: 14px;
            box-shadow: 0 4px 16px rgba(21,101,192,0.15), 0 0 0 4px rgba(21,101,192,0.06);
            background: #fff; padding: 4px;
            transition: transform 0.3s ease;
        }
        .login-logo:hover { transform: scale(1.04); }

        .login-title { font-size: 1.5rem; font-weight: 800; color: #0f172a; text-align: center; margin-bottom: 4px; letter-spacing: -0.03em; }
        .login-subtitle { font-size: 0.86rem; color: #64748b; text-align: center; margin-bottom: 28px; }

        .input-group-custom { margin-bottom: 18px; }
        .input-group-custom label { font-size: 0.83rem; font-weight: 600; color: #334155; margin-bottom: 7px; display: block; }

        .input-wrapper { position: relative; display: flex; align-items: center; }
        .input-wrapper i {
            position: absolute; left: 13px; color: #94a3b8; font-size: 0.95rem;
            transition: color 0.25s ease, transform 0.25s ease; pointer-events: none;
        }
        .input-wrapper input {
            width: 100%; padding: 13px 14px 13px 40px;
            border: 1.5px solid #e2e8f0; border-radius: 11px;
            font-size: 0.95rem; color: #1e293b; background: #f8fafc;
            transition: all 0.25s ease; font-family: inherit;
        }
        .input-wrapper input:focus {
            background: #fff; border-color: #1565c0;
            box-shadow: 0 0 0 4px rgba(21,101,192,0.1); outline: none;
        }
        .input-wrapper:focus-within i { color: #1565c0; transform: scale(1.1); }

        .btn-login {
            background: linear-gradient(135deg, #1565c0 0%, #1e88e5 100%);
            border: none; border-radius: 11px; color: #fff; font-weight: 700; font-size: 1rem;
            padding: 14px 20px; width: 100%; margin-top: 12px;
            box-shadow: 0 4px 16px rgba(21,101,192,0.35);
            transition: all 0.25s ease;
            display: flex; align-items: center; justify-content: center; gap: 9px;
            cursor: pointer; position: relative; overflow: hidden;
        }
        .btn-login::after {
            content: ''; position: absolute; top: 0; left: -75%;
            width: 50%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.18), transparent);
            transform: skewX(-20deg); transition: left 0.5s ease;
        }
        .btn-login:hover::after { left: 125%; }
        .btn-login:hover { background: linear-gradient(135deg, #0d47a1 0%, #1565c0 100%); box-shadow: 0 8px 24px rgba(21,101,192,0.45); transform: translateY(-1px); }
        .btn-login:active { transform: translateY(0); }
        .btn-login:disabled { opacity: 0.7; cursor: not-allowed; transform: none; }

        .alert-error-custom {
            background: #fef2f2; border: 1.5px solid #fecaca; color: #991b1b;
            border-radius: 11px; padding: 12px 16px; font-size: 0.88rem; font-weight: 500;
            margin-bottom: 22px; display: flex; align-items: center; gap: 10px;
            animation: errorShake 0.4s ease;
        }
        @@keyframes errorShake {
            0%,100% { transform: translateX(0); }
            20%     { transform: translateX(-5px); }
            40%     { transform: translateX(5px); }
            60%     { transform: translateX(-3px); }
            80%     { transform: translateX(3px); }
        }

        .login-footer {
            text-align: center; margin-top: 22px; font-size: 0.76rem; color: #94a3b8;
            border-top: 1px solid #f1f5f9; padding-top: 16px;
        }
        .version-badge {
            display: inline-flex; align-items: center; gap: 5px;
            background: #f1f5f9; padding: 3px 10px; border-radius: 100px;
            font-size: 0.72rem; font-weight: 500; color: #64748b; margin-bottom: 6px;
        }
    </style>
</head>
<body>
    <div class="login-bg-grid"></div>
    <div class="login-wrapper">
        <div class="login-card">
            <div class="login-logo-wrap">
                <img src="@Url.Content("~/Content/Zulia_log.bmp")" alt="Logo APIS" class="login-logo" />
            </div>

            <h1 class="login-title">Bienvenido</h1>
            <p class="login-subtitle">Ingresa tus credenciales para acceder al sistema</p>

            @if (ViewBag.Error != null)
            {
                <div class="alert-error-custom" role="alert">
                    <i class="fas fa-exclamation-circle fs-5"></i>
                    <div>@ViewBag.Error</div>
                </div>
            }

            <form method="post" action="@Url.Action("Login", "Account")" id="loginForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                <div class="input-group-custom">
                    <label for="username">Usuario</label>
                    <div class="input-wrapper">
                        <input type="text" id="username" name="username"
                               value="@(ViewBag.Username ?? string.Empty)"
                               required autocomplete="username"
                               placeholder="Codigo o nombre de usuario" autofocus />
                        <i class="fas fa-user"></i>
                    </div>
                </div>

                <div class="input-group-custom">
                    <label for="password">Contrasena</label>
                    <div class="input-wrapper">
                        <input type="password" id="password" name="password"
                               required autocomplete="current-password"
                               placeholder="Ingresa tu contrasena" />
                        <i class="fas fa-lock"></i>
                    </div>
                </div>

                <button type="submit" class="btn-login" id="loginButton">
                    <span id="buttonText"><i class="fas fa-sign-in-alt"></i> Iniciar Sesion</span>
                    <span id="loadingSpinner" style="display:none;">
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        Validando...
                    </span>
                </button>
            </form>

            <div class="login-footer">
                <div class="version-badge">
                    <i class="fas fa-circle-check" style="color:#059669;font-size:0.65rem;"></i>
                    APIS v2.0
                </div>
                <div>&copy; @DateTime.Now.Year APIS WM TOOLS &middot; Todos los derechos reservados</div>
            </div>
        </div>
    </div>

    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.getRegistrations().then(function (regs) {
                regs.forEach(function (reg) { reg.unregister(); });
            });
            if (window.caches && caches.keys) {
                caches.keys().then(function (keys) {
                    keys.forEach(function (key) { caches.delete(key); });
                });
            }
        }

        (function () {
            var form = document.getElementById('loginForm');
            var button = document.getElementById('loginButton');
            var buttonText = document.getElementById('buttonText');
            var loadingSpinner = document.getElementById('loadingSpinner');

            form.addEventListener('submit', function () {
                button.disabled = true;
                buttonText.style.display = 'none';
                loadingSpinner.style.display = 'inline-flex';
            });

            window.addEventListener('pageshow', function (event) {
                if (event.persisted) {
                    button.disabled = false;
                    buttonText.style.display = 'inline-flex';
                    loadingSpinner.style.display = 'none';
                }
            });
        })();
    </script>
</body>
</html>

