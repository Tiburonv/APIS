@{
    ViewBag.Title = "Iniciar Sesión";
}
<style>
    body {
        background: #f0f2f5;
        min-height: 100vh;
    }

    h4 {
        color: #388e3c;
    }
    .login-container {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.10);
        padding: 32px 28px 24px 28px;
        margin-top: 24px;
        max-width: 370px;
    }

    .login-logo {
        height: 60px;
        margin-bottom: 16px;
    }

    .form-group label {
        font-weight: 500;
        color: #374151;
    }

    .btn-primary {
        background: #2563eb;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        transition: background 0.2s;
    }

        .btn-primary:hover {
            background: #1d4ed8;
        }
        
    /* Estilos para el indicador de carga */
    .spinner-border {
        width: 1rem;
        height: 1rem;
        margin-right: 0.5rem;
        vertical-align: middle;
    }
    
    .btn-loading {
        pointer-events: none;
        opacity: 0.8;
    }
</style>
<div class="d-flex justify-content-center align-items-start" style="min-height:100vh; padding-top:40px;">
@*<div class="d-flex justify-content-center align-items-center" style="min-height:100vh;">*@
    <div class="login-container">
        <div class="text-center mb-3">
            <img src="~/Content/Zulia_log.bmp" alt="Logo Zulia" class="login-logo" />
        </div>
        <h2 class="text-center mb-4" style="font-weight:700; color:#1e293b;">Iniciar Sesión</h2>
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }
        <form method="post" id="loginForm">
            <div class="form-group mb-3">
                <label>Usuario</label>
                <input type="text" name="username" class="form-control" required autocomplete="username" />
            </div>
            <div class="form-group mb-4">
                <label>Contraseña</label>
                <input type="password" name="password" class="form-control" required autocomplete="current-password" />
            </div>
            <button type="submit" class="btn btn-primary btn-block w-100" id="loginButton">
                <span id="buttonText">Entrar</span>
                <span id="loadingSpinner" style="display:none;">
                    <span class="spinner-border" role="status" aria-hidden="true"></span>
                    Iniciando sesión...
                </span>
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#loginForm').on('submit', function(e) {
                // Obtener el botón
                var button = $('#loginButton');
                var buttonText = $('#buttonText');
                var loadingSpinner = $('#loadingSpinner');
                
                // Deshabilitar el botón y agregar clase de carga
                button.prop('disabled', true).addClass('btn-loading');
                
                // Ocultar el texto normal y mostrar el spinner
                buttonText.hide();
                loadingSpinner.show();
                
                // Si hay un error, el formulario se recargará y el botón volverá a estar habilitado
                // No necesitamos preventDefault() porque queremos que el formulario se envíe
            });
        });
    </script>
}