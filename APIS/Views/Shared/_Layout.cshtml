<!DOCTYPE html>
<html lang="es">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>@ViewBag.Title - APIS Sistema de Gestión</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- PWA Meta Tags -->
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="APIS">
    <meta name="application-name" content="APIS">
    <meta name="msapplication-TileColor" content="#1565c0">
    <meta name="msapplication-config" content="/browserconfig.xml">
    <meta name="theme-color" content="#0f172a">

    <!-- iOS Specific Meta Tags -->
    <meta name="format-detection" content="telephone=no">
    <meta name="apple-touch-fullscreen" content="yes">

    <!-- PWA Manifest -->
    <link rel="manifest" href="/Content/manifest.json?v=3">

    <!-- Apple Touch Icons -->
    <link rel="apple-touch-icon" href="/Content/Imagen/logo-152x152.png">
    <link rel="apple-touch-icon" sizes="152x152" href="/Content/Imagen/logo-152x152.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/Content/Imagen/logo-180x180.png">

    <!-- iOS Splash Screens -->
    <link rel="apple-touch-startup-image" href="/Content/Imagen/splash-2048x2732.png" media="(device-width: 1024px) and (device-height: 1366px) and (-webkit-device-pixel-ratio: 2)">
    <link rel="apple-touch-startup-image" href="/Content/Imagen/splash-1668x2388.png" media="(device-width: 834px) and (device-height: 1194px) and (-webkit-device-pixel-ratio: 2)">
    <link rel="apple-touch-startup-image" href="/Content/Imagen/splash-1536x2048.png" media="(device-width: 768px) and (device-height: 1024px) and (-webkit-device-pixel-ratio: 2)">
    <link rel="apple-touch-startup-image" href="/Content/Imagen/splash-1125x2436.png" media="(device-width: 375px) and (device-height: 812px) and (-webkit-device-pixel-ratio: 3)">
    <link rel="apple-touch-startup-image" href="/Content/Imagen/splash-1242x2688.png" media="(device-width: 414px) and (device-height: 896px) and (-webkit-device-pixel-ratio: 3)">
    <link rel="apple-touch-startup-image" href="/Content/Imagen/splash-750x1334.png" media="(device-width: 375px) and (device-height: 667px) and (-webkit-device-pixel-ratio: 2)">
    <link rel="apple-touch-startup-image" href="/Content/Imagen/splash-640x1136.png" media="(device-width: 320px) and (device-height: 568px) and (-webkit-device-pixel-ratio: 2)">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <style>
        /* =============================================
           NAVBAR v2 - Dark Gradient + Premium Feel
           ============================================= */
        .navbar-custom {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #1a3a6e 100%);
            box-shadow: 0 2px 16px rgba(0,0,0,0.2), 0 1px 0 rgba(255,255,255,0.04);
            padding-top: 0.6rem;
            padding-bottom: 0.6rem;
            border-bottom: 1px solid rgba(255,255,255,0.06);
        }

        .navbar-custom .navbar-brand {
            font-weight: 800;
            font-size: 1.25rem;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 10px;
            letter-spacing: -0.03em;
            transition: opacity 0.2s ease;
        }
        .navbar-custom .navbar-brand:hover { opacity: 0.85; }

        .navbar-brand .brand-logo {
            height: 34px;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.3);
            background: #fff;
            padding: 2px;
            transition: transform 0.2s ease;
        }
        .navbar-custom .navbar-brand:hover .brand-logo { transform: scale(1.05); }

        .brand-text-wrap { display: flex; flex-direction: column; line-height: 1.1; }
        .brand-name { font-size: 1.1rem; font-weight: 800; color: #fff; letter-spacing: -0.02em; }
        .brand-tagline { font-size: 0.62rem; font-weight: 400; color: rgba(255,255,255,0.45); letter-spacing: 0.12em; text-transform: uppercase; }

        /* Nav Links */
        .navbar-custom .nav-link {
            color: rgba(255,255,255,0.78) !important;
            font-weight: 500;
            font-size: 0.9rem;
            padding: 0.5rem 0.9rem !important;
            border-radius: 8px;
            margin: 0 2px;
            transition: all 0.2s ease;
            position: relative;
        }
        .navbar-custom .nav-link i { margin-right: 5px; width: 16px; text-align: center; opacity: 0.8; }
        .navbar-custom .nav-link:hover {
            color: #fff !important;
            background: rgba(255,255,255,0.1);
        }
        .navbar-custom .nav-link.active {
            color: #fff !important;
            background: rgba(59,130,246,0.25);
        }
        .navbar-custom .nav-link.active::after {
            content: '';
            position: absolute;
            bottom: -1px; left: 50%;
            transform: translateX(-50%);
            width: 24px; height: 2px;
            background: #60a5fa;
            border-radius: 2px;
        }

        /* Toggler */
        .navbar-custom .navbar-toggler {
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 8px;
            padding: 0.4rem 0.65rem;
        }
        .navbar-custom .navbar-toggler:focus { box-shadow: 0 0 0 3px rgba(96,165,250,0.3); }

        /* User Dropdown Button */
        .user-dropdown-btn {
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.12);
            border-radius: 20px;
            padding: 5px 14px 5px 7px !important;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .user-dropdown-btn:hover {
            background: rgba(255,255,255,0.15) !important;
            border-color: rgba(255,255,255,0.22);
        }

        .user-avatar {
            width: 30px; height: 30px;
            border-radius: 50%;
            background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
            display: flex; align-items: center; justify-content: center;
            font-size: 0.75rem; font-weight: 700; color: #fff;
            flex-shrink: 0;
            text-transform: uppercase;
            letter-spacing: 0.02em;
        }

        .user-info { display: flex; flex-direction: column; line-height: 1.15; }
        .user-name { font-size: 0.85rem; font-weight: 600; color: #fff; }
        .user-role { font-size: 0.65rem; font-weight: 500; color: rgba(255,255,255,0.45); text-transform: uppercase; letter-spacing: 0.08em; }

        /* Breadcrumb Bar */
        .global-breadcrumb {
            background: rgba(15, 23, 42, 0.65);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            padding: 6px 0;
            position: relative;
            z-index: 1;
        }
        .global-breadcrumb .breadcrumb {
            margin-bottom: 0;
            background: transparent;
        }
        .global-breadcrumb .breadcrumb-item,
        .global-breadcrumb .breadcrumb-item a {
            color: #94a3b8;
            text-decoration: none;
            font-size: 0.85rem;
        }
        .global-breadcrumb .breadcrumb-item a:hover {
            color: #60a5fa;
        }
        .global-breadcrumb .breadcrumb-item.active {
            color: #f1f5f9;
            font-weight: 600;
        }
        .global-breadcrumb .breadcrumb-item + .breadcrumb-item::before {
            color: rgba(255, 255, 255, 0.3);
        }

        @@media (max-width: 991px) {
            .navbar-custom .navbar-collapse {
                background: rgba(15,23,42,0.97);
                border-radius: 12px;
                margin-top: 8px;
                padding: 12px;
                border: 1px solid rgba(255,255,255,0.06);
            }
            .navbar-custom .nav-link { margin: 2px 0; }
            .user-dropdown-btn { margin-top: 8px; border-radius: 12px !important; padding: 10px 14px !important; }
            .user-info { display: flex; }
        }
    </style>
</head>
<body>
    <!-- Fondo Tecnológico Global (Rayas y destellos del Login) -->
    <div class="app-bg-glow" aria-hidden="true"></div>
    <div class="app-bg-grid" aria-hidden="true"></div>

    @{
        var currentController = ViewContext.RouteData.Values["controller"] != null ? ViewContext.RouteData.Values["controller"].ToString() : "";
        var currentAction = ViewContext.RouteData.Values["action"] != null ? ViewContext.RouteData.Values["action"].ToString() : "";
        var usuario = (Session["Usuario"] as string) ?? (User.Identity.IsAuthenticated ? User.Identity.Name : string.Empty);
        var nombreUsuario = (Session["NombreUsuario"] as string) ?? usuario;
        var esAdmin = usuario == "999";
    }
    @{
        var displayName = string.IsNullOrEmpty(nombreUsuario) ? usuario : nombreUsuario;
        var avatarInitials = !string.IsNullOrEmpty(displayName) && displayName.Length >= 2
            ? displayName.Substring(0, 2).ToUpper()
            : (!string.IsNullOrEmpty(displayName) ? displayName.Substring(0, 1).ToUpper() : "U");
        var rolLabel = esAdmin ? "Admin" : "Vendedor";

        // Breadcrumb mapping
        var bcSection = "";
        var bcPage = "";
        if (currentController == "Home")           { bcSection = "Clientes"; bcPage = currentAction == "DetalleDocumento" ? "Detalle" : "Facturas"; }
        else if (currentController == "Pedidos")   { bcSection = "Clientes"; bcPage = "Pedidos"; }
        else if (currentController == "Precios")   { bcSection = "Artículos"; bcPage = "Lista de Precios"; }
        else if (currentController == "ConfigEmpresa") { bcSection = "Administración"; bcPage = "Empresa"; }
        else if (currentController == "DocumentoCP") { bcSection = "Proveedores"; bcPage = "Documentos"; }
        else if (currentController == "Pago")      { bcSection = "Proveedores"; bcPage = "Pagos"; }
        else if (currentController == "Cotizacion") { bcSection = "Cotización"; bcPage = currentAction == "Vercotizacion" ? "Buscar" : "Crear"; }
    }
    @if (User.Identity.IsAuthenticated)
    {
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom sticky-top">
            <div class="container-fluid">
                <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                    <img src="~/Content/Zulia_log.bmp" alt="Logo" class="brand-logo" />
                    <div class="brand-text-wrap">
                        <span class="brand-name">APIS</span>
                        <span class="brand-tagline">Gestión Empresarial</span>
                    </div>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(currentController == "Home" || currentController == "Pedidos" ? "active" : "")"
                               href="#" id="clientsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-users"></i> Clientes
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="clientsDropdown">
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Home")"><i class="fas fa-file-invoice" style="color:#1565c0"></i> Facturas</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Ped", "Pedidos")"><i class="fas fa-shopping-cart" style="color:#059669"></i> Pedidos</a></li>
                            </ul>
                        </li>

                        @if (esAdmin || usuario == "04" || usuario == "05" || usuario == "11")
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Precios" ? "active" : "")" href="@Url.Action("Precios", "Precios")">
                                    <i class="fas fa-tags"></i> Artículos
                                </a>
                            </li>
                        }
                        @if (esAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "ConfigEmpresa" ? "active" : "")" href="@Url.Action("Index", "ConfigEmpresa")">
                                    <i class="fas fa-building"></i> Empresa
                                </a>
                            </li>
                        }
                        @if (esAdmin || usuario == "04" || usuario == "05")
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(currentController == "DocumentoCP" || currentController == "Pago" ? "active" : "")"
                                   href="#" id="proveedoresDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-truck-moving"></i> Proveedores
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="proveedoresDropdown">
                                    <li><a class="dropdown-item" href="@Url.Action("Index", "DocumentoCP")"><i class="fas fa-file-invoice-dollar" style="color:#1565c0"></i> Documentos</a></li>
                                    <li><a class="dropdown-item" href="@Url.Action("Pagos", "Pago")"><i class="fas fa-money-check-alt" style="color:#059669"></i> Pagos</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(currentController == "Cotizacion" ? "active" : "")"
                                   href="#" id="quotesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-file-signature"></i> Cotización
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="quotesDropdown">
                                    <li><a class="dropdown-item" href="@Url.Action("Cotizacion", "Cotizacion")"><i class="fas fa-plus-circle" style="color:#1565c0"></i> Crear</a></li>
                                    <li><a class="dropdown-item" href="@Url.Action("Vercotizacion", "Cotizacion")"><i class="fas fa-search" style="color:#64748b"></i> Buscar</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <!-- User dropdown -->
                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle user-dropdown-btn" href="#" id="userDropdown"
                               role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="user-avatar">@avatarInitials</div>
                                <div class="user-info d-none d-lg-flex">
                                    <span class="user-name">@displayName</span>
                                    <span class="user-role">@rolLabel</span>
                                </div>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                <li>
                                    <div style="padding:10px 14px 8px; border-bottom:1px solid #f1f5f9; margin-bottom:4px;">
                                        <div style="font-weight:700;font-size:0.9rem;color:#0f172a;">@displayName</div>
                                        <div style="font-size:0.75rem;color:#64748b;">@rolLabel · Cód. @usuario</div>
                                    </div>
                                </li>
                                <li>
                                    <a class="dropdown-item text-danger" href="@Url.Action("Logout", "Account")">
                                        <i class="fas fa-sign-out-alt"></i> Cerrar sesión
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        if (!string.IsNullOrEmpty(bcSection))
        {
            <div class="global-breadcrumb">
                <div class="container-fluid" style="padding: 0 16px;">
                    <nav class="breadcrumb-bar" aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="fas fa-home" style="font-size:0.75rem;"></i> Inicio</a></li>
                            <li class="breadcrumb-item">@bcSection</li>
                            <li class="breadcrumb-item active" aria-current="page">@bcPage</li>
                        </ol>
                    </nav>
                </div>
            </div>
        }
    }

    <!-- Contenedor Global de Notificaciones Toast -->
    <div id="toast-container" aria-live="polite" aria-atomic="true"></div>

    <div class="container-fluid body-content">
        @RenderBody()
        <footer style="text-align:center; color: #94a3b8; padding: 24px 0 16px; border-top: 1px solid rgba(255,255,255,0.08); margin-top: 32px;">
            <strong style="color:#ffffff;">APIS</strong> · WM Tools &nbsp;·&nbsp; Sistema de Gestión Empresarial &nbsp;&copy; @DateTime.Now.Year
        </footer>
    </div>

    <!-- Scripts Base -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.6/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Sistema Global de Notificaciones Toasts
        window.mostrarNotificacion = function(tipo, mensaje, duracion = 3800) {
            const container = document.getElementById('toast-container');
            if (!container) return;

            const iconMap = {
                'success': '<i class="fas fa-check-circle text-success fs-5"></i>',
                'error': '<i class="fas fa-exclamation-circle text-danger fs-5"></i>',
                'warning': '<i class="fas fa-exclamation-triangle text-warning fs-5"></i>',
                'info': '<i class="fas fa-info-circle text-info fs-5"></i>'
            };

            const toast = document.createElement('div');
            toast.className = `custom-toast toast-${tipo || 'info'}`;
            toast.innerHTML = `
                ${iconMap[tipo] || iconMap['info']}
                <div class="flex-grow-1">${mensaje}</div>
                <button type="button" class="btn-close btn-close-sm" style="font-size:0.75rem;"></button>
            `;

            toast.querySelector('.btn-close').onclick = function() {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(40px)';
                setTimeout(() => toast.remove(), 250);
            };

            container.appendChild(toast);

            setTimeout(function() {
                if (toast.parentNode) {
                    toast.style.opacity = '0';
                    toast.style.transform = 'translateX(40px)';
                    toast.style.transition = 'all 0.25s ease';
                    setTimeout(() => toast.remove(), 250);
                }
            }, duracion);
        };

        $(document).ready(function() {
            // Función para mantener viva la sesión
            function keepSessionAlive() {
                $.get('@Url.Action("Ping", "KeepAlive")')
                    .fail(function(xhr, status, error) {
                        console.warn('Keep-alive status:', status);
                    });
            }

            // Temporizador de keep-alive (cada 5 minutos)
            setInterval(keepSessionAlive, 5 * 60 * 1000);

            // Redirección por inactividad (60 minutos)
            var inactivityTime = 60 * 60 * 1000;
            var inactivityTimer;

            function resetInactivityTimer() {
                clearTimeout(inactivityTimer);
                inactivityTimer = setTimeout(function () {
                    $.get('@Url.Action("Logout", "Account")')
                        .always(function() {
                            window.location.href = '@Url.Action("Login", "Account")';
                        });
                }, inactivityTime);
            }

            ['click', 'mousemove', 'keydown', 'scroll', 'touchstart'].forEach(function (evt) {
                document.addEventListener(evt, resetInactivityTimer, { passive: true });
            });

            resetInactivityTimer();
            keepSessionAlive();
        });

        // PWA: registro de Service Worker seguro
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () {
                navigator.serviceWorker.getRegistrations()
                    .then(function (regs) {
                        return Promise.all(regs.map(function (reg) { return reg.unregister(); }));
                    })
                    .then(function () {
                        if (!window.caches || !caches.keys) return;
                        return caches.keys().then(function (keys) {
                            return Promise.all(keys.map(function (key) { return caches.delete(key); }));
                        });
                    })
                    .then(function () {
                        return navigator.serviceWorker.register('/sw.js');
                    })
                    .then(function (registration) {
                        console.log('SW activo:', registration.scope);
                    })
                    .catch(function (error) {
                        console.log('SW:', error);
                    });
            });
        }

        // PWA Install Prompt
        let deferredPrompt;
        window.addEventListener('beforeinstallprompt', function(e) {
            e.preventDefault();
            deferredPrompt = e;
            showInstallButton();
        });

        function showInstallButton() {
            if (!document.getElementById('installButton')) {
                const installBtn = document.createElement('button');
                installBtn.id = 'installButton';
                installBtn.className = 'btn btn-primary position-fixed shadow-lg';
                installBtn.style.cssText = 'bottom: 24px; right: 24px; z-index: 990; border-radius: 50px; padding: 10px 22px; font-weight:600;';
                installBtn.innerHTML = '<i class="fas fa-download me-1"></i> Instalar APIS';
                installBtn.onclick = installPWA;
                document.body.appendChild(installBtn);
            }
        }

        function installPWA() {
            if (deferredPrompt) {
                deferredPrompt.prompt();
                deferredPrompt.userChoice.then(function(choiceResult) {
                    deferredPrompt = null;
                });
            }
        }
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>