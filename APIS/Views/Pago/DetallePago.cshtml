@model APIS.Models.DetallePagoViewModel
@using System.Linq
@{
    ViewBag.Title = "Detalle del Pago";
    Response.ContentType = "text/html; charset=utf-8";
}

<style>
    body {
        background: #f4f6fb;
        -webkit-overflow-scrolling: touch;
        scroll-behavior: smooth;
    }

    .container {
        overflow-x: hidden;
        -webkit-overflow-scrolling: touch;
    }

    /* Scroll personalizado para móviles */
    ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
    }

    ::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 4px;
    }

    ::-webkit-scrollbar-thumb {
        background: #1565c0;
        border-radius: 4px;
    }

    ::-webkit-scrollbar-thumb:hover {
        background: #0d47a1;
    }

    .table-responsive {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: thin;
        scrollbar-color: #1565c0 #f1f1f1;
    }

    h4 {
        color: #1565c0;
    }

    .cabecera-azul-claro {
        background-color: #1565c0 !important;
        color: #fff;
        border-radius: 6px 6px 0 0;
        font-size: 1.1rem;
        letter-spacing: 0.5px;
    }

    .table-hover tbody tr:hover {
        background-color: #e3f2fd !important;
        transition: background 0.2s;
    }

    .table-striped tbody tr:nth-of-type(odd) {
        background-color: #f9f9f9;
    }

    .card {
        border-radius: 8px;
        box-shadow: 0 2px 12px rgba(21,101,192,0.10);
        margin-bottom: 20px;
    }

    .card-header {
        background: #1565c0 !important;
        color: #fff !important;
        font-weight: 600;
        font-size: 1.15rem;
        letter-spacing: 0.5px;
        border-radius: 8px 8px 0 0;
    }

    .btn-back {
        background: linear-gradient(135deg, #6c757d 0%, #495057 100%);
        border: none;
        color: white;
        font-weight: 600;
        padding: 10px 20px;
        border-radius: 8px;
        box-shadow: 0 3px 10px rgba(108, 117, 125, 0.4);
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-back:hover {
        color: white;
        text-decoration: none;
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(108, 117, 125, 0.6);
    }

    .info-badge {
        background: #e3f2fd;
        color: #1565c0;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .total-amount {
        font-size: 1.2rem;
        font-weight: 700;
        color: #1565c0;
    }

    .status-badge {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
    }

    .status-active {
        background: #d4edda;
        color: #155724;
    }

    .status-cancelled {
        background: #f8d7da;
        color: #721c24;
    }

    /* Anchos fijos para columnas específicas */
    .table th:nth-child(1), /* Tipo Doc */
    .table td:nth-child(1) {
        width: 100px;
        min-width: 100px;
        max-width: 100px;
        text-align: center;
    }

    .table th:nth-child(2), /* Nro. Doc */
    .table td:nth-child(2) {
        width: 120px;
        min-width: 120px;
        max-width: 120px;
        text-align: center;
    }

    .table th:nth-child(3), /* Num. Doc */
    .table td:nth-child(3) {
        width: 120px;
        min-width: 120px;
        max-width: 120px;
        text-align: center;
    }

    .table th:nth-child(4), /* Forma Pago */
    .table td:nth-child(4) {
        width: 130px;
        min-width: 130px;
        max-width: 130px;
        text-align: center;
    }

    .table th:nth-child(5), /* Código Cta */
    .table td:nth-child(5) {
        width: 120px;
        min-width: 120px;
        max-width: 120px;
        text-align: center;
    }

    .table th:nth-child(6), /* Total */
    .table td:nth-child(6) {
        width: 120px;
        min-width: 120px;
        max-width: 120px;
        text-align: right;
    }

    /* Mejoras para móviles */
    @@media (max-width: 768px) {
        .table-responsive {
            margin: 16px -16px;
            padding: 16px;
            border-radius: 0;
        }

        .table {
            font-size: 0.875rem;
        }

        .table td, .table th {
            padding: 0.5rem 0.25rem;
            white-space: nowrap;
        }

        .btn-back {
            padding: 8px 16px;
            font-size: 0.9rem;
        }

        /* Ajustar anchos fijos en móviles */
        .table th:nth-child(1),
        .table td:nth-child(1) {
            width: 80px;
            min-width: 80px;
            max-width: 80px;
        }

        .table th:nth-child(2),
        .table td:nth-child(2) {
            width: 100px;
            min-width: 100px;
            max-width: 100px;
        }

        .table th:nth-child(3),
        .table td:nth-child(3) {
            width: 100px;
            min-width: 100px;
            max-width: 100px;
        }

        .table th:nth-child(4),
        .table td:nth-child(4) {
            width: 110px;
            min-width: 110px;
            max-width: 110px;
        }

        .table th:nth-child(5),
        .table td:nth-child(5) {
            width: 100px;
            min-width: 100px;
            max-width: 100px;
        }

        .table th:nth-child(6),
        .table td:nth-child(6) {
            width: 100px;
            min-width: 100px;
            max-width: 100px;
        }
    }
</style>

<div class="container">
    <!-- Boton de regreso -->
    <div class="mb-3">
        <a href="@Url.Action("Pagos", "Pago")" class="btn-back">
            <i class="fa fa-arrow-left"></i>
            Volver a Pagos
        </a>
    </div>

    <!-- Información del Pago -->
    <div class="card">
        <div class="card-header">
            <i class="fa fa-file-text mr-2"></i>
            Información del Pago
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Número de Pago:</strong> <span class="info-badge">@Model.cob_num</span></p>
                    <p><strong>Código Proveedor:</strong> @Model.co_prov</p>
                    <p><strong>Nombre Proveedor:</strong> @Model.prov_des</p>
                    <p><strong>Tasa:</strong> @(Model.tasa != null ? Model.tasa.Value.ToString("N4") : "0.0000")</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Fecha:</strong> @Model.Fecha.ToString("dd/MM/yyyy")</p>
                    <p><strong>Dias:</strong> @(Model.Dias != null ? Model.Dias.ToString() : "N/A")</p>
                    <p><strong>Estado:</strong> 
                        <span class="status-badge @(Model.anulado ? "status-cancelled" : "status-active")">
                            @(Model.anulado ? "Anulado" : "Activo")
                        </span>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Detalle de Renglones -->
    <div class="card">
        <div class="card-header">
            <i class="fa fa-list mr-2"></i>
            Detalle de Documentos del Pago
        </div>
        <div class="card-body">
            @if (Model.Renglones != null && Model.Renglones.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-striped table-hover">
                        <thead>
                            <tr class="cabecera-azul-claro">
                                <th class="text-center">
                                    <i class="fa fa-file-text"></i> Tipo Doc
                                </th>
                                <th class="text-center">
                                    <i class="fa fa-hashtag"></i> Factura
                                </th>
                                <th class="text-center">
                                    <i class="fa fa-file"></i> Transf. Nro
                                </th>
                                <th class="text-center">
                                    <i class="fa fa-credit-card"></i> Forma Pago
                                </th>
                                <th class="text-center">
                                    <i class="fa fa-bank"></i> Código Cta
                                </th>
                                <th class="text-center">
                                    @*<i class="fa fa-dollar"></i>*@ Total Bs
                                </th>
                                <th class="text-center">
                                    @*<i class="fa fa-calculator"></i>*@ Total $
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var renglon in Model.Renglones)
                            {
                                <tr>
                                    <td class="text-center">@renglon.co_tipo_doc</td>
                                    <td class="text-center">@renglon.nro_doc</td>
                                    <td class="text-center">@renglon.num_doc</td>
                                    <td class="text-center">@renglon.forma_pag</td>
                                    <td class="text-center">@renglon.cod_cta</td>
                                    <td class="text-end font-weight-bold" style="color: #1565c0;">
                                        @(renglon.Total != null ? ((decimal)renglon.Total).ToString("N2") : "0.00")
                                    </td>
                                    <td class="text-end font-weight-bold" style="color: #e65100;">
                                        @{
                                            decimal totalDolar = 0;
                                            if (renglon.Total != null && Model.tasa != null && Model.tasa != 0)
                                            {
                                                totalDolar = ((decimal)renglon.Total) / (decimal)Model.tasa;
                                            }
                                        }
                                        @totalDolar.ToString("N2")
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-info">
                                <td colspan="5" class="text-end font-weight-bold">TOTAL Bs:</td>
                                <td class="text-end total-amount">
                                    @((Model.Renglones != null ? Model.Renglones.Sum(r => r.Total != null ? (decimal)r.Total : 0) : 0).ToString("N2"))
                                </td>
                                <td class="text-end total-amount" style="color: #e65100;">
                                    @{
                                        decimal totalDolarGeneral = 0;
                                        if (Model.Renglones != null && Model.tasa != null && Model.tasa != 0)
                                        {
                                            decimal totalBs = Model.Renglones.Sum(r => r.Total != null ? (decimal)r.Total : 0);
                                            totalDolarGeneral = totalBs / (decimal)Model.tasa;
                                        }
                                    }
                                    @totalDolarGeneral.ToString("N2")
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <!-- Resumen -->
                <div class="row mt-3">
                    <div class="col-md-6">
                        <div class="alert alert-info">
                            <h6><i class="fa fa-info-circle mr-2"></i>Resumen</h6>
                            <p class="mb-1"><strong>Total de Documentos:</strong> @(Model.Renglones != null ? Model.Renglones.Count : 0)</p>
                            <p class="mb-1"><strong>Monto Total Bs:</strong> <span class="total-amount">@((Model.Renglones != null ? Model.Renglones.Sum(r => r.Total != null ? (decimal)r.Total : 0) : 0).ToString("N2"))</span></p>
                            <p class="mb-0"><strong>Monto Total $:</strong> <span class="total-amount" style="color: #e65100;">
                                @{
                                    decimal totalDolarResumen = 0;
                                    if (Model.Renglones != null && Model.tasa != null && Model.tasa != 0)
                                    {
                                        decimal totalBsResumen = Model.Renglones.Sum(r => r.Total != null ? (decimal)r.Total : 0);
                                        totalDolarResumen = totalBsResumen / (decimal)Model.tasa;
                                    }
                                }
                                @totalDolarResumen.ToString("N2")
                            </span></p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="alert alert-success">
                            <h6><i class="fa fa-check-circle mr-2"></i>Estado del Pago</h6>
                            <p class="mb-1"><strong>Estado:</strong> 
                                <span class="status-badge @(Model.anulado ? "status-cancelled" : "status-active")">
                                    @(Model.anulado ? "Anulado" : "Activo")
                                </span>
                            </p>
                            <p class="mb-0"><strong>Fecha:</strong> @Model.Fecha.ToString("dd/MM/yyyy")</p>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning">
                    <i class="fa fa-exclamation-triangle mr-2"></i>
                    No se encontraron renglones para este pago.
                </div>
            }
        </div>
    </div>
</div>

@section scripts{
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
}
