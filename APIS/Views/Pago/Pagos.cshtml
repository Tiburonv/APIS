    <!-- Paginación solo para resultados normales (no agrupados por dia) -->
    <nav v-if="!mostrarPorDias && totalPaginas > 1">
        <ul class="pagination justify-content-center">
            <li :class="['page-item', {disabled: paginaActual === 1}]">
