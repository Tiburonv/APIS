                        <span v-if="columnaOrden==='prov_des'">
                            <span v-if="ordenAscendente">&#9650;</span>
                            <span v-else>&#9660;</span>
                        </span>
                    </th>
                    <th class="cabecera-azul-claro" v-on:click="ordenarPor('Fecha')" style="cursor:pointer;">
                        <i class="fa fa-calendar"></i> Fecha
                        <span v-if="columnaOrden==='Fecha'">
                            <span v-if="ordenAscendente">&#9650;</span>
                            <span v-else>&#9660;</span>
                        </span>
                    </th>
                    <th class="cabecera-azul-claro text-center">
