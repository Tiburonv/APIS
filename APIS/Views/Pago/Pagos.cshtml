        border-top: 2px solid #1565c0;
    }

    .table tfoot tr.table-info td {
        border-top: 2px solid #1565c0;
        font-weight: 700;
        font-size: 1.05rem;
    }

    /* Estilos para las filas de sumatoria de ADEL y FACT */
