    /* Estilos para enlaces de documentos */
    .document-link {
        color: #1565c0 !important;
        text-decoration: none;
        font-weight: 600;
        transition: color 0.2s ease;
    }

        .document-link:hover {
            color: #0d47a1 !important;
            text-decoration: underline;
        }

        .document-link:focus {
            outline: 2px solid #1565c0;
            outline-offset: 2px;
        }

        /* Indicador de que es clickeable */
        .document-link::after {
            content: " 🔗";
            font-size: 0.8em;
            opacity: 0.7;
        }

        .document-link:hover::after {
            opacity: 1;
        }

    /* Estilos para filas clickeables */
    .table tbody tr {
        transition: all 0.2s ease;
        position: relative;
    }

    .table tbody tr:hover {
        background-color: #e3f2fd !important;
        transform: translateY(-1px);
        box-shadow: 0 2px 8px rgba(21, 101, 192, 0.15);
    }


    /* Boton de scroll hacia arriba para móviles */
    .scroll-to-top {
        position: fixed;
        bottom: 20px;
        right: 20px;
        background: #1565c0;
        color: white;
        border: none;
        border-radius: 50%;
        width: 50px;
        height: 50px;
        font-size: 20px;
        cursor: pointer;
        opacity: 0;
        transition: opacity 0.3s, transform 0.3s;
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 12px rgba(21, 101, 192, 0.3);
    }

    .scroll-to-top.show {
        opacity: 1;
    }

    .scroll-to-top:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(21, 101, 192, 0.4);
    }
    
    /* Estilos para el indicador de carga */
    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 9999;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    
    .loading-spinner {
        background: white;
        padding: 20px 40px;
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        align-items: center;
        box-shadow: 0 4px 20px rgba(0,0,0,0.2);
    }
    
    .spinner-border-custom {
        width: 3rem;
        height: 3rem;
        border-width: 0.3em;
    }
    
    .loading-text {
        margin-top: 10px;
        font-weight: 600;
        color: #1565c0;
    }
    
    /* Animación de búsqueda */
    .search-loading {
        position: relative;
        pointer-events: none;
        opacity: 0.7;
    }
    
    .search-loading::after {
        content: "";
        position: absolute;
        top: 50%;
        right: 15px;
        transform: translateY(-50%);
        width: 20px;
        height: 20px;
        border: 3px solid #f3f3f3;
        border-top: 3px solid #1565c0;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }
    
    @@keyframes spin {
        0% { transform: translateY(-50%) rotate(0deg); }
        100% { transform: translateY(-50%) rotate(360deg); }
    }

    /* Estilos para el boton de proveedores con saldo */
    .proveedores-saldo-btn {
        background: linear-gradient(135deg, #ff6b35 0%, #f7931e 100%);
        border: none;
        color: white;
        font-weight: 700;
        font-size: 0.95rem;
        padding: 10px 20px;
        border-radius: 8px;
        box-shadow: 0 3px 10px rgba(255, 107, 53, 0.4);
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        min-width: 80px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .proveedores-saldo-btn::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
        transition: left 0.5s;
    }

    .proveedores-saldo-btn:hover::before {
        left: 100%;
    }

    .proveedores-saldo-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(255, 107, 53, 0.6);
        background: linear-gradient(135deg, #ff5722 0%, #ff9800 100%);
    }

    .proveedores-saldo-btn:active {
        transform: translateY(0);
        box-shadow: 0 2px 10px rgba(255, 107, 53, 0.4);
    }

    .proveedores-saldo-btn:disabled,
    .proveedores-saldo-btn.btn-loading {
        opacity: 0.7;
        cursor: not-allowed;
        transform: none;
        box-shadow: 0 2px 8px rgba(255, 107, 53, 0.3);
    }

    .proveedores-saldo-btn:disabled:hover,
    .proveedores-saldo-btn.btn-loading:hover {
        transform: none;
        box-shadow: 0 2px 8px rgba(255, 107, 53, 0.3);
    }

    /* Efecto de pulso para el boton cuando esta cargando */
    .proveedores-saldo-btn.btn-loading {
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0% {
            box-shadow: 0 4px 15px rgba(255, 107, 53, 0.4);
        }
        50% {
            box-shadow: 0 4px 20px rgba(255, 107, 53, 0.8);
        }
        100% {
            box-shadow: 0 4px 15px rgba(255, 107, 53, 0.4);
        }
    }

    /* Mejoras para móviles */
    @@media (max-width: 768px) {
        /* Scroll horizontal mejorado para móviles */
        .table-responsive {
            margin: 16px -16px;
            padding: 16px;
            border-radius: 0;
        }

        /* Indicador de scroll visible en móviles */
        .scroll-indicator {
            opacity: 1;
            right: 5px;
            padding: 6px 3px;
            font-size: 10px;
        }

        /* Mejoras para tablas en móvil */
        .table {
            font-size: 0.875rem;
        }

        .table td, .table th {
            padding: 0.5rem 0.25rem;
            white-space: nowrap;
        }

        /* Scroll suave para navegacion móvil */
        html {
            scroll-behavior: smooth;
        }

        .scroll-to-top {
            bottom: 15px;
            right: 15px;
            width: 45px;
