    .dia-card .seccion-adel .table-striped tbody tr:nth-of-type(even),
    .dia-card .seccion-adel .table tbody tr:nth-of-type(even) {
        background-color: #f1f8e9 !important;
        border-left: 3px solid #dcedc8 !important;
    }

    .dia-card .seccion-adel .table tbody tr:hover {
        background-color: #c8e6c9 !important;
        transform: translateY(-1px);
        box-shadow: 0 2px 8px rgba(76, 175, 80, 0.25) !important;
