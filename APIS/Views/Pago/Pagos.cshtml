@section scripts{
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/vue@2/dist/vue.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.9.0/axios.min.js"></script>

    <script>
        function debounce(func, wait) {
            let timeout;
            return function (...args) {
                clearTimeout(timeout);
                timeout = setTimeout(() => func.apply(this, args), wait);
            };
        }

        var app = new Vue({
            el: "#root",
            delimiters: ['[[', ']]'],
            data: {
                txtBusqueda: '',
                sugerencias: [],
                resultadosFiltrados: [],
                todosLosPagosRango: [],
                filtroProveedorEnRango: '',
                filtroProveedorSeleccionado: '',
                filtroProveedorModal: '',
                pagoSeleccionado: null,
                paginaActual: 1,
                resultadosPorPagina: 20,
                totalRecords: 0,
                columnaOrden: '',
                ordenAscendente: true,
                cargando: false,
                buscando: false,
                textoCargar: 'Cargando...',
                mostrarPorDias: false,
                fechaDesde: '',
                fechaHasta: new Date().toISOString().split('T')[0], // Fecha actual como predeterminado
                filtrandoPorFechas: false,
                fechaActual: new Date().toISOString().split('T')[0], // Fecha actual en formato YYYY-MM-DD
                imagenPago: {
                    cob_num: '',
                    des_imag: '',
                    picture: null
                },
                cargandoImagen: false
            },
            computed: {
                resultadosPaginados() {
                    return this.resultadosFiltrados; // Simplified
                },
                totalPaginas() {
                    return Math.ceil(this.totalRecords / this.resultadosPorPagina); // Calculated from totalRecords
                },
                proveedoresDisponiblesEnRango() {
                    if (!this.todosLosPagosRango || !this.todosLosPagosRango.length) return [];
                    const provMap = new Map();
                    this.todosLosPagosRango.forEach(pago => {
                        const coProv = (pago.co_prov || '').trim();
                        const provDes = (pago.prov_des || '').trim();
                        const monto = parseFloat((pago.Total || 0).toString().replace(/[^\d.,-]/g, '').replace(',', '.')) || 0;
                        if (coProv || provDes) {
                            if (!provMap.has(coProv)) {
                                provMap.set(coProv, {
                                    co_prov: coProv,
                                    prov_des: provDes,
                                    nombreCompleto: (coProv ? coProv + ' - ' : '') + provDes,
                                    cantidad: 0,
                                    total: 0
                                });
                            }
                            const p = provMap.get(coProv);
                            p.cantidad += 1;
                            p.total += monto;
                        }
                    });
                    return Array.from(provMap.values()).sort((a, b) => a.prov_des.localeCompare(b.prov_des));
                },
                textoRangoFechasActivo() {
                    if (!this.filtrandoPorFechas) {
                        return 'Últimos 7 días';
                    }
                    if (this.fechaDesde && this.fechaHasta) {
                        if (this.fechaDesde === this.fechaHasta) {
                            return 'Fecha: ' + this.formatFecha(this.fechaDesde);
                        }
                        return 'Desde ' + this.formatFecha(this.fechaDesde) + ' hasta ' + this.formatFecha(this.fechaHasta);
                    }
                    return 'Rango de fechas';
                },
                pagosAgrupadosPorDia() {
                    if (!this.mostrarPorDias || !this.resultadosFiltrados.length) {
                        return [];
                    }
                    
                    const agrupados = {};
                    
                    this.resultadosFiltrados.forEach(pago => {
                        const fecha = pago.Fecha;
                        if (!agrupados[fecha]) {
                            agrupados[fecha] = {
                                ADEL: [],
                                FACT: [],
                                otros: []
                            };
                        }
                        
                        // Clasificar por tipo de documento
                        const tipoDoc = (pago.co_tipo_doc || '').trim().toUpperCase();
                        if (tipoDoc === 'ADEL') {
                            agrupados[fecha].ADEL.push(pago);
                        } else if (tipoDoc === 'FACT') {
                            agrupados[fecha].FACT.push(pago);
                        } else {
                            agrupados[fecha].otros.push(pago);
                        }
                    });
                    
                    // Convertir a array y ordenar por fecha descendente
                    return Object.keys(agrupados)
                        .sort((a, b) => new Date(b) - new Date(a))
                        .map(fecha => ({
                            fecha: fecha,
                            pagosADEL: agrupados[fecha].ADEL,
                            pagosFACT: agrupados[fecha].FACT,
                            pagosOtros: agrupados[fecha].otros,
                            cantidadADEL: agrupados[fecha].ADEL.length,
                            cantidadFACT: agrupados[fecha].FACT.length,
                            totalADEL: agrupados[fecha].ADEL.reduce((sum, pago) => sum + (Number(pago.Total) || 0), 0),
                            totalFACT: agrupados[fecha].FACT.reduce((sum, pago) => sum + (Number(pago.Total) || 0), 0)
                        }));
                }
            },
            methods: {
                getBsuqueda(page) {
                    if (this.txtBusqueda.trim() !== '') {
                        let cadena = this.txtBusqueda.trim();
                        
                        this.buscando = true;
                        this.cargando = true;
                        this.textoCargar = 'Buscando pagos...';
                        this.mostrarPorDias = false; // Desactivar vista por dias en búsquedas específicas
                        this.filtrandoPorFechas = false;
                        this.todosLosPagosRango = [];
                        this.filtroProveedorEnRango = '';
                        this.filtroProveedorSeleccionado = '';
                        this.filtroProveedorModal = '';

                        axios.get('/DocumentoCP/buscarPagosCP', {
                            params: {
                                nombre: cadena,
                                page: page || this.paginaActual,
                                pageSize: this.resultadosPorPagina
                            }
                        })
                            .then((response) => {
                                this.resultadosFiltrados = response.data.datos || [];
                                this.totalRecords = response.data.totalRecords || 0;
                                this.pagoSeleccionado = null;
                                this.sugerencias = [];

                                if (initialCoCli && initialCliDes) {
                                    const pago = this.resultadosFiltrados.find(x => {
                                        const xCoProv = x.co_prov || '';
                                        const xProvDes = x.prov_des || '';
                                        return xCoProv === initialCoCli && xProvDes === initialCliDes;
                                    });
                                    if (pago) {
                                        this.seleccionarPago(pago);
                                    }
                                }
                                this.buscando = false;
                                this.cargando = false;
                            })
                            .catch(() => {
                                this.resultadosFiltrados = [];
                                this.totalRecords = 0;
                                this.pagoSeleccionado = null;
                                this.sugerencias = [];
                                this.buscando = false;
                                this.cargando = false;
                            });
                    } else {
                        this.resultadosFiltrados = [];
                        this.totalRecords = 0;
                        this.pagoSeleccionado = null;
                        this.sugerencias = [];
                        this.buscando = false;
                        this.cargando = false;
                    }
                },
                buscarSugerencias() {
                    if (this.txtBusqueda.length < 2) {
                        this.sugerencias = [];
                        return;
                    }
                    const texto = this.txtBusqueda.toLowerCase();
                    const sugerenciasSet = new Set();
                    this.resultadosFiltrados.forEach(item => {
                        const provDes = item.prov_des || '';
                        const coProv = item.co_prov || '';

                        if (provDes && provDes.toLowerCase().includes(texto)) {
                            sugerenciasSet.add(provDes);
                        }
                        if (coProv && coProv.toLowerCase().includes(texto)) {
                            sugerenciasSet.add(coProv);
                        }
                    });
                    this.sugerencias = Array.from(sugerenciasSet).slice(0, 10);
                },
                seleccionarSugerencia(s) {
                    this.txtBusqueda = s;
                    this.sugerencias = [];
                    this.paginaActual = 1;
                    this.getBsuqueda();
                },
                seleccionarPago(item) {
                    this.pagoSeleccionado = item;
                    this.txtBusqueda = '';
                    this.sugerencias = [];
                    this.paginaActual = 1;
                },
                verDetallePago(item) {
                    // Redirigir a la página de detalle del pago
                    window.location.href = '/Pago/DetallePago?cob_num=' + encodeURIComponent(item.cob_num);
                },
                cargarTodosLosPagos() {
                    this.cargando = true;
                    this.textoCargar = 'Cargando pagos de los ultimos 7 dias...';
                    this.buscando = true;
                    this.filtrandoPorFechas = false;
                    this.filtroProveedorEnRango = '';
                    this.filtroProveedorSeleccionado = '';
                    this.filtroProveedorModal = '';
                    
                    axios.get('/DocumentoCP/buscarPagosCP', {
                        params: {
                            nombre: '', // Busqueda vacia para obtener todos
                            page: 1,
                            pageSize: 8000 // Obtener todos los registros
                        }
                    })
                    .then((response) => {
                        const todosLosPagos = response.data.datos || [];
                        
                        // Calcular fecha de hace 7 dias
                        const fechaHace7Dias = new Date();
                        fechaHace7Dias.setDate(fechaHace7Dias.getDate() - 7);
                        fechaHace7Dias.setHours(0, 0, 0, 0);
                        
                        // Filtrar solo los pagos de los ultimos 7 dias
                        const pagosUltimos7Dias = todosLosPagos.filter(pago => {
                            const fechaPago = new Date(pago.Fecha);
                            fechaPago.setHours(0, 0, 0, 0);
                            return fechaPago >= fechaHace7Dias;
                        });
                        
                        this.todosLosPagosRango = pagosUltimos7Dias;
                        this.resultadosFiltrados = pagosUltimos7Dias;
                        this.totalRecords = pagosUltimos7Dias.length;
                        this.pagoSeleccionado = null;
                        this.sugerencias = [];
                        this.txtBusqueda = '';
                        this.paginaActual = 1;
                        this.mostrarPorDias = true; // Activar vista por dias
                        this.cargando = false;
                        this.buscando = false;
                    })
                    .catch(() => {
                        this.todosLosPagosRango = [];
                        this.resultadosFiltrados = [];
                        this.totalRecords = 0;
                        this.pagoSeleccionado = null;
                        this.sugerencias = [];
                        this.paginaActual = 1;
                        this.txtBusqueda = '';
                        this.mostrarPorDias = false;
                        this.cargando = false;
                        this.buscando = false;
                    });
                },
                cambiarPagina(pagina) {
                    if (pagina > 0 && pagina <= this.totalPaginas) {
                        this.paginaActual = pagina;
                        this.getBsuqueda(pagina);
                    }
                },
                ordenarPor(columna) {
                    if (this.columnaOrden === columna) {
                        this.ordenAscendente = !this.ordenAscendente;
                    } else {
                        this.columnaOrden = columna;
                        this.ordenAscendente = true;
                    }
                    this.resultadosFiltrados.sort((a, b) => {
                        if (a[columna] < b[columna]) return this.ordenAscendente ? -1 : 1;
                        if (a[columna] > b[columna]) return this.ordenAscendente ? 1 : -1;
                        return 0;
                    });
                },
                formatNumero(valor) {
                    if (valor == null || valor === '') return '0.00';
                    
                    // Convertir a numero
                    let num;
                    if (typeof valor === 'string') {
                        const cleaned = valor.toString().replace(/[^\d.,-]/g, '');
                        num = parseFloat(cleaned.replace(',', '.'));
                    } else {
                        num = Number(valor);
                    }
                    
                    if (isNaN(num)) {
                        return '0.00';
                    }
                    
                    try {
                        return num.toLocaleString('en-US', { 
                            minimumFractionDigits: 2, 
                            maximumFractionDigits: 2 
                        });
                    } catch (e) {
                        return num.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
                    }
                },
                calcularTotalTasa(total, tasa) {
                    if (!total || !tasa || tasa === 0) {
                        return 0;
                    }
                    
                    const totalNum = typeof total === 'string' 
                        ? parseFloat(total.replace(/[^\d.,-]/g, '').replace(',', '.')) 
                        : Number(total);
                    const tasaNum = typeof tasa === 'string' 
                        ? parseFloat(tasa.replace(/[^\d.,-]/g, '').replace(',', '.')) 
                        : Number(tasa);
                    
                    if (isNaN(totalNum) || isNaN(tasaNum) || tasaNum === 0) {
                        return 0;
                    }
                    
                    return totalNum / tasaNum;
                },
                formatFecha(valor) {
                    if (!valor) return '';
                    let fecha;

                    if (typeof valor === 'string' && valor.match(/\/Date\((\d+)\)\//)) {
                        const ms = parseInt(valor.match(/\/Date\((\d+)\)\//)[1], 10);
                        fecha = new Date(ms);
                    } else if (typeof valor === 'string' && valor.length === 10 && valor.match(/^\d{4}-\d{2}-\d{2}$/)) {
                        const [anio, mes, dia] = valor.split('-');
                        fecha = new Date(Number(anio), Number(mes) - 1, Number(dia));
                    } else {
                        fecha = new Date(valor);
                    }

                    if (isNaN(fecha)) return valor;

                    const dia = ('0' + fecha.getDate()).slice(-2);
                    const mes = ('0' + (fecha.getMonth() + 1)).slice(-2);
                    const anio = fecha.getFullYear();
                    return `${dia}/${mes}/${anio}`;
                },
                formatFechaCompleta(valor) {
                    if (!valor) return '';
                    let fecha;

                    if (typeof valor === 'string' && valor.match(/\/Date\((\d+)\)\//)) {
                        const ms = parseInt(valor.match(/\/Date\((\d+)\)\//)[1], 10);
                        fecha = new Date(ms);
                    } else if (typeof valor === 'string' && valor.length === 10 && valor.match(/^\d{4}-\d{2}-\d{2}$/)) {
                        const [anio, mes, dia] = valor.split('-');
                        fecha = new Date(Number(anio), Number(mes) - 1, Number(dia));
                    } else {
                        fecha = new Date(valor);
                    }

                    if (isNaN(fecha)) return valor;

                    const diasSemana = ['Domingo', 'Lunes', 'Martes', 'Miercoles', 'Jueves', 'Viernes', 'Sabado'];
                    const meses = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 
                                 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
                    
                    const diaSemana = diasSemana[fecha.getDay()];
                    const dia = fecha.getDate();
                    const mes = meses[fecha.getMonth()];
                    const anio = fecha.getFullYear();
                    
                    return `${diaSemana}, ${dia} de ${mes} de ${anio}`;
                },
                limpiarBusqueda() {
                    this.txtBusqueda = '';
                    this.sugerencias = [];
                    this.resultadosFiltrados = [];
                    this.todosLosPagosRango = [];
                    this.filtroProveedorEnRango = '';
                    this.filtroProveedorSeleccionado = '';
                    this.filtroProveedorModal = '';
                    this.totalRecords = 0;
                    this.pagoSeleccionado = null;
                    this.paginaActual = 1;
                    this.resultadosPorPagina = 20;
                    this.buscando = false;
                    this.cargando = false;
                },
                sumaTotalPagos() {
                    if (!this.resultadosFiltrados || this.resultadosFiltrados.length === 0) return 0;
                    const total = this.resultadosFiltrados.reduce((acc, item) => {
                        let val = 0;
                        if (item.Total !== null && item.Total !== undefined) {
                            if (typeof item.Total === 'string') {
                                val = parseFloat(item.Total.replace(/[^\d.,-]/g, '').replace(',', '.')) || 0;
                            } else {
                                val = Number(item.Total) || 0;
                            }
                        }
                        return acc + val;
                    }, 0);
                    return total;
                },
                proveedoresUnicos() {
                    if (!this.resultadosFiltrados || this.resultadosFiltrados.length === 0) return 0;
                    const unique = new Set();
                    this.resultadosFiltrados.forEach(item => {
                        const key = (item.co_prov || '') + '|' + (item.prov_des || '');
                        unique.add(key);
                    });
                    return unique.size;
                },
                promedioPagos() {
                    if (!this.resultadosFiltrados || this.resultadosFiltrados.length === 0) return 0;
                    const totalPagos = this.sumaTotalPagos();
                    return totalPagos / this.resultadosFiltrados.length;
                },
                calcularTotalDiaTotalDolar(pagos) {
                    if (!pagos || pagos.length === 0) return 0;
                    
                    const total = pagos.reduce((sum, pago) => {
                        const totalDolar = this.calcularTotalTasa(pago.Total, pago.tasa);
                        return sum + totalDolar;
                    }, 0);
                    
                    return total;
                },
                sumaTotalPagosDolar() {
                    if (!this.resultadosFiltrados || this.resultadosFiltrados.length === 0) return 0;
                    
                    const total = this.resultadosFiltrados.reduce((sum, item) => {
                        const totalDolar = this.calcularTotalTasa(item.Total, item.tasa);
                        return sum + totalDolar;
                    }, 0);
                    
                    return total;
                },
                // Escapa caracteres HTML para evitar XSS al usar v-html con datos del servidor
                escaparHtml(texto) {
                    if (texto == null || texto === undefined) return '';
                    return String(texto)
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;')
                        .replace(/"/g, '&quot;')
                        .replace(/'/g, '&#39;');
                },
                highlight(text) {
                    if (text == null || text === undefined) return '';

                    // Escapar SIEMPRE el contenido antes de insertarlo con v-html (mitiga XSS)
                    const texto = this.escaparHtml(text);

                    const termino = this.txtBusqueda || this.filtroProveedorEnRango;
                    if (!termino) return texto;

                    const escapedTerm = termino.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&');
                    const regex = new RegExp(`(${escapedTerm})`, 'gi');
                    return texto.toString().replace(regex, '<span class="highlight">$1</span>');
                },
                mostrarValorOpcional(valor) {
                    if (valor == null || valor === undefined || valor === '') {
                        return '<span style="color: #6c757d; font-style: italic;">-</span>';
                    }
                    // Escapar el valor (puede venir del servidor) antes de usarlo con v-html
                    return this.escaparHtml(valor);
                },
                mostrarDocumentoPorTipo(item, tipoDocumento) {
                    // Verificar si el tipo de documento coincide con el tipo solicitado
                    if (item.co_tipo_doc && item.co_tipo_doc.trim().toUpperCase() === tipoDocumento.trim().toUpperCase()) {
                        const monto = item.Total;
                        if (!monto || monto === '') {
                            return '<span style="color: #6c757d; font-style: italic;">-</span>';
                        }
                        
                        let claseColor = '';
                        switch (tipoDocumento.trim().toUpperCase()) {
                            case 'ADEL':
                                claseColor = 'documento-adel';
                                break;
                            case 'FACT':
                                claseColor = 'documento-fact';
                                break;
                            case 'N/CR':
                                claseColor = 'documento-ncr';
                                break;
                        }
                        
                        const montoFormateado = this.formatNumero(monto);
                        return `<span class="${claseColor}">${montoFormateado}</span>`;
                    }
                    return '<span style="color: #6c757d; font-style: italic;">-</span>';
                },
                scrollToResults() {
                    const resultsSection = document.querySelector('.card.border-primary');
                    if (resultsSection) {
                        resultsSection.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                },
                setupMobileScroll() {
                    const scrollToTopBtn = document.getElementById('scrollToTop');
                    const scrollIndicator = document.getElementById('scrollIndicator');
                    let scrollTimeout;

                    window.addEventListener('scroll', () => {
                        if (window.pageYOffset > 300) {
                            scrollToTopBtn.classList.add('show');
                        } else {
                            scrollToTopBtn.classList.remove('show');
                        }

                        clearTimeout(scrollTimeout);
                        scrollIndicator.classList.add('show');
                        
                        scrollTimeout = setTimeout(() => {
                            scrollIndicator.classList.remove('show');
                        }, 2000);
                    });

                    scrollToTopBtn.addEventListener('click', () => {
                        window.scrollTo({
                            top: 0,
                            behavior: 'smooth'
                        });
                    });

                    const tables = document.querySelectorAll('.table-responsive');
                    tables.forEach(table => {
                        let isScrolling = false;
                        let startX, startScrollLeft;

                        table.addEventListener('touchstart', (e) => {
                            isScrolling = true;
                            startX = e.touches[0].pageX - table.offsetLeft;
                            startScrollLeft = table.scrollLeft;
                        });

                        table.addEventListener('touchmove', (e) => {
                            if (!isScrolling) return;
                            e.preventDefault();
                            const x = e.touches[0].pageX - table.offsetLeft;
                            const walk = (x - startX) * 2;
                            table.scrollLeft = startScrollLeft - walk;
                        });

                        table.addEventListener('touchend', () => {
                            isScrolling = false;
                        });
                    });
                },
                filtrarPorFechas() {
                    if (!this.fechaDesde || !this.fechaHasta) {
                        alert('Por favor seleccione ambas fechas (desde y hasta)');
                        return;
                    }

                    if (new Date(this.fechaDesde) > new Date(this.fechaHasta)) {
                        alert('La fecha "desde" no puede ser mayor que la fecha "hasta"');
                        return;
                    }

                    this.cargando = true;
                    this.textoCargar = 'Filtrando pagos por fechas...';
                    this.buscando = true;
                    this.filtrandoPorFechas = true;
                    this.mostrarPorDias = true; // Activar vista por dias igual que el boton "Todos"

                    axios.get('/DocumentoCP/buscarPagosCP', {
                        params: {
                            nombre: '', // Busqueda vacia para obtener todos
                            page: 1,
                            pageSize: 8000 // Obtener todos los registros
                        }
                    })
                    .then((response) => {
                        const todosLosPagos = response.data.datos || [];
                        
                        const fechaDesde = new Date(this.fechaDesde);
                        const fechaHasta = new Date(this.fechaHasta);
                        fechaDesde.setHours(0, 0, 0, 0);
                        fechaHasta.setHours(23, 59, 59, 999);

                        // Filtrar por rango de fechas
                        const pagosFiltrados = todosLosPagos.filter(pago => {
                            const fechaPago = new Date(pago.Fecha);
                            fechaPago.setHours(0, 0, 0, 0);
                            return fechaPago >= fechaDesde && fechaPago <= fechaHasta;
                        });

                        this.todosLosPagosRango = pagosFiltrados;
                        
                        // Si se indicó un proveedor en el modal, prellenarlo y filtrar
                        if (this.filtroProveedorModal && this.filtroProveedorModal.trim() !== '') {
                            this.filtroProveedorEnRango = this.filtroProveedorModal.trim();
                        } else {
                            this.filtroProveedorEnRango = '';
                            this.filtroProveedorSeleccionado = '';
                        }
                        
                        this.filtrarResultadosPorProveedor();

                        this.pagoSeleccionado = null;
                        this.sugerencias = [];
                        this.txtBusqueda = '';
                        this.paginaActual = 1;
                        this.cargando = false;
                        this.buscando = false;
                    })
                    .catch(() => {
                        this.todosLosPagosRango = [];
                        this.resultadosFiltrados = [];
                        this.totalRecords = 0;
                        this.pagoSeleccionado = null;
                        this.sugerencias = [];
                        this.paginaActual = 1;
                        this.txtBusqueda = '';
                        this.filtrandoPorFechas = false;
                        this.mostrarPorDias = false;
                        this.cargando = false;
                        this.buscando = false;
                    });
                },
                filtrarResultadosPorProveedor() {
                    if (!this.todosLosPagosRango) {
                        this.resultadosFiltrados = [];
                        this.totalRecords = 0;
                        return;
                    }
                    
                    const texto = (this.filtroProveedorEnRango || '').toLowerCase().trim();
                    if (!texto) {
                        this.resultadosFiltrados = [...this.todosLosPagosRango];
                        this.filtroProveedorSeleccionado = '';
                    } else {
                        this.resultadosFiltrados = this.todosLosPagosRango.filter(pago => {
                            const coProv = (pago.co_prov || '').toLowerCase();
                            const provDes = (pago.prov_des || '').toLowerCase();
                            const cobNum = (pago.cob_num || '').toLowerCase();
                            const numDoc = (pago.num_doc || '').toLowerCase();
                            return coProv.includes(texto) || provDes.includes(texto) || cobNum.includes(texto) || numDoc.includes(texto);
                        });
                        
                        // Si el texto coincide con un código de proveedor, sincronizar el select
                        const provExacto = this.proveedoresDisponiblesEnRango.find(p => p.co_prov.toLowerCase() === texto);
                        if (provExacto) {
                            this.filtroProveedorSeleccionado = provExacto.co_prov;
                        } else {
                            this.filtroProveedorSeleccionado = '';
                        }
                    }
                    this.totalRecords = this.resultadosFiltrados.length;
                },
                seleccionarProveedorDeLista() {
                    if (!this.filtroProveedorSeleccionado) {
                        this.filtroProveedorEnRango = '';
                    } else {
                        const prov = this.proveedoresDisponiblesEnRango.find(p => p.co_prov === this.filtroProveedorSeleccionado);
                        if (prov) {
                            this.filtroProveedorEnRango = prov.prov_des || prov.co_prov;
                        } else {
                            this.filtroProveedorEnRango = this.filtroProveedorSeleccionado;
                        }
                    }
                    this.filtrarResultadosPorProveedor();
                },
                limpiarFiltroProveedorEnRango() {
                    this.filtroProveedorEnRango = '';
                    this.filtroProveedorSeleccionado = '';
                    this.filtroProveedorModal = '';
                    this.filtrarResultadosPorProveedor();
                },
                limpiarFiltroFechas() {
                    this.fechaDesde = '';
                    this.fechaHasta = this.fechaActual; // Restaurar fecha actual como predeterminado
                    this.filtrandoPorFechas = false;
                    this.filtroProveedorEnRango = '';
                    this.filtroProveedorSeleccionado = '';
                    this.filtroProveedorModal = '';
                    this.todosLosPagosRango = [];
                    this.resultadosFiltrados = [];
                    this.totalRecords = 0;
                    this.pagoSeleccionado = null;
                    this.sugerencias = [];
                    this.paginaActual = 1;
                    this.mostrarPorDias = false;
                    
                    // Cerrar el modal si esta abierto
                    const modal = document.getElementById('filtroFechasModal');
                    if (modal) {
                        const modalInstance = bootstrap.Modal.getInstance(modal);
                        if (modalInstance) {
                            modalInstance.hide();
                        }
                    }
                },
                calcularTotalPorTipo(tipoDocumento) {
                    if (!this.resultadosFiltrados || this.resultadosFiltrados.length === 0) {
                        return this.formatNumero(0);
                    }
                    
                    const total = this.resultadosFiltrados.reduce((sum, item) => {
                        if (item.co_tipo_doc && item.co_tipo_doc.trim().toUpperCase() === tipoDocumento.trim().toUpperCase()) {
                            let monto = 0;
                            if (item.Total !== null && item.Total !== undefined) {
                                if (typeof item.Total === 'string') {
                                    monto = parseFloat(item.Total.replace(/[^\d.,-]/g, '').replace(',', '.')) || 0;
                                } else {
                                    monto = Number(item.Total) || 0;
                                }
                            }
                            return sum + monto;
                        }
                        return sum;
                    }, 0);
                    
                    return this.formatNumero(total);
                },
                calcularTotalPorTipoEnGrupo(pagos, tipoDocumento) {
                    if (!pagos || pagos.length === 0) {
                        return this.formatNumero(0);
                    }
                    
                    const total = pagos.reduce((sum, pago) => {
                        if (pago.co_tipo_doc && pago.co_tipo_doc.trim().toUpperCase() === tipoDocumento.trim().toUpperCase()) {
                            let monto = 0;
                            if (pago.Total !== null && pago.Total !== undefined) {
                                if (typeof pago.Total === 'string') {
                                    monto = parseFloat(pago.Total.replace(/[^\d.,-]/g, '').replace(',', '.')) || 0;
                                } else {
                                    monto = Number(pago.Total) || 0;
                                }
                            }
                            return sum + monto;
                        }
                        return sum;
                    }, 0);
                    
                    return this.formatNumero(total);
                },
                verImagenPago(cob_num) {
                    // Limpiar datos previos
                    this.imagenPago = {
                        cob_num: cob_num,
                        des_imag: '',
                        picture: null
                    };
                    this.cargandoImagen = true;
                    
                    // Abrir modal
                    const modal = new bootstrap.Modal(document.getElementById('modalImagenPago'));
                    modal.show();
                    
                    // Cargar imagen bajo demanda (solo cuando se hace clic)
                    axios.get('/DocumentoCP/ObtenerImagenPago', {
                        params: { cob_num: cob_num }
                    })
                    .then((response) => {
                        if (response.data.success) {
                            this.imagenPago.des_imag = response.data.des_imag || 'Imagen del pago';
                            this.imagenPago.picture = response.data.picture;
                        } else {
                            alert('No se pudo cargar la imagen: ' + (response.data.message || 'Error desconocido'));
                            this.imagenPago.picture = null;
                        }
                        this.cargandoImagen = false;
                    })
                    .catch((error) => {
                        console.error('Error al cargar imagen:', error);
                        alert('Error al cargar la imagen del pago');
                        this.imagenPago.picture = null;
                        this.cargandoImagen = false;
                    });
                }
            },
            created() {
                this.buscarSugerenciasDebounced = debounce(this.buscarSugerencias, 300);
                if (initialCoCli && initialCliDes) {
                    this.txtBusqueda = initialCliDes;
                    this.getBsuqueda();
                }
            },
            mounted() {
                this.setupMobileScroll();
            }
        });
    </script>
}