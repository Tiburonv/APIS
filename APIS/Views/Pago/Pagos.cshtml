    }

    /* Estilos específicos para las filas de FACT - fondo naranja/rojizo claro */
    .dia-card .seccion-fact .table-striped tbody tr:nth-of-type(odd),
    .dia-card .seccion-fact .table tbody tr:nth-of-type(odd) {
        background-color: #ffebee !important;
        border-left: 3px solid #ffcdd2 !important;
    }

    .dia-card .seccion-fact .table-striped tbody tr:nth-of-type(even),
    .dia-card .seccion-fact .table tbody tr:nth-of-type(even) {
        background-color: #fff3e0 !important;
        border-left: 3px solid #ffe0b2 !important;
    }

    .dia-card .seccion-fact .table tbody tr:hover {
        background-color: #ffcdd2 !important;
        transform: translateY(-1px);
        box-shadow: 0 2px 8px rgba(244, 67, 54, 0.25) !important;
        border-left-color: #f44336 !important;
    }

    /* Asegurar que las columnas Tasa y Total $ tengan el mismo tamaño de fuente que el resto */
    .table tbody td.font-weight-bold {
        font-size: inherit !important;
    }

    .dia-card .table tbody td.font-weight-bold {
        font-size: inherit !important;
    }

    /* Específicamente para las columnas Tasa y Total $ */
    .table tbody td[style*="color: #2e7d32"],
    .table tbody td[style*="color: #e65100"] {
        font-size: inherit !important;
    }

    .dia-card .table tbody td[style*="color: #2e7d32"],
    .dia-card .table tbody td[style*="color: #e65100"] {
        font-size: inherit !important;
    }

    .table tfoot tr.table-info td:first-child {
        background-color: #1565c0 !important;
        color: white !important;
        font-size: 1.1rem;
        letter-spacing: 0.5px;
    }

    /* Responsive para los botones */
    @@media (max-width: 768px) {
        .search-container .d-flex.gap-3 {
            flex-direction: column;
            gap: 0.75rem !important;
        }
        
        .search-container .btn {
            width: 100%;
            min-width: auto;
        }

        /* Estilos responsivos para la fila de sumatoria */
        .table tfoot tr.table-info td {
            font-size: 0.9rem;
            padding: 8px 4px;
        }

        .table tfoot tr.table-info td:first-child {
            font-size: 0.95rem;
        }
    }
</style>

<script>
    var initialCoCli = '@(co_prov ?? "")';
    var initialCliDes = '@(prov_des ?? "")';
</script>

<div class="container" id="root">
    <!-- Indicador de carga global -->
    <div v-if="cargando" class="loading-overlay">
        <div class="loading-spinner">
            <div class="spinner-border spinner-border-custom text-primary" role="status">
                <span class="sr-only">Cargando...</span>
            </div>
            <div class="loading-text">[[ textoCargar ]]</div>
        </div>
    </div>
    
    <div class="search-container">
        <h4><i class="fa fa-search"></i> Buscar Documentos Pagados</h4>
        <div style="position:relative;">
            <div class="search-flex">
                <input type="text"
                       :class="['form-control', {'search-loading': buscando}]"
                       v-model="txtBusqueda"
                       v-on:focus="limpiarBusqueda"
                       v-on:input="buscarSugerenciasDebounced"
                       v-on:keyup.enter="getBsuqueda()"
                       placeholder="Buscar por código o nombre de proveedor..."
                       autocomplete="off"
                       v-bind:disabled="buscando || cargando" />
            </div>
            <ul v-if="sugerencias.length > 0" class="list-group autocomplete-list">
                <li class="list-group-item autocomplete-item"
                    v-for="(s, i) in sugerencias"
                    :key="i"
                    v-on:click="seleccionarSugerencia(s)">
                    <i class="fa fa-user"></i> [[ s ]]
                </li>
            </ul>
        </div>
        
        <!-- Botones debajo del cuadro de busqueda -->
        <div class="d-flex justify-content-center gap-3 mt-3">
            <button type="button" 
                    class="btn proveedores-saldo-btn"
                    v-on:click="cargarTodosLosPagos"
                    v-bind:disabled="cargando || buscando"
                    v-bind:class="{'btn-loading': cargando || buscando}"
                    title="Mostrar todos los pagos">
                <i class="fa fa-calendar mr-1" v-if="!cargando && !buscando"></i>
                <i class="fa fa-spinner fa-spin mr-1" v-if="cargando || buscando"></i>
                <span v-if="!cargando && !buscando">Todos</span>
                <span v-if="cargando || buscando">...</span>
            </button>
            
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#filtroFechasModal">
                <i class="fas fa-calendar-alt me-1"></i> Filtrar por Fechas
            </button>
        </div>

        <!-- Modal para el filtro de fechas -->
        <div class="modal fade" id="filtroFechasModal" tabindex="-1" aria-labelledby="filtroFechasModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="filtroFechasModalLabel"><i class="fas fa-calendar-alt me-2 text-primary"></i>Filtrar por Rango de Fechas</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="fechaInicio" class="form-label">Fecha de Inicio</label>
                            <input type="date" class="form-control" id="fechaInicio" v-model="fechaDesde" v-bind:disabled="cargando || buscando">
                        </div>
                        <div class="mb-3">
                            <label for="fechaFin" class="form-label">Fecha de Fin</label>
                            <input type="date" class="form-control" id="fechaFin" v-model="fechaHasta" v-bind:disabled="cargando || buscando">
                        </div>
                        <div class="mb-2">
                            <label for="filtroProveedorModalInput" class="form-label">
                                <i class="fas fa-user-tag text-primary me-1"></i> Filtrar Proveedor (Opcional)
                            </label>
                            <input type="text" 
                                   class="form-control" 
                                   id="filtroProveedorModalInput" 
                                   v-model="filtroProveedorModal" 
                                   placeholder="Código o nombre (ej: 04, Norberto)..." 
                                   v-bind:disabled="cargando || buscando" />
                            <small class="text-muted">Si lo deja vacío, se mostrarán todos los proveedores de las fechas seleccionadas.</small>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary me-2" v-on:click="limpiarFiltroFechas" v-bind:disabled="cargando || buscando">
                            <i class="fas fa-times me-1"></i> Limpiar Filtros
                        </button>
                        <button type="button" class="btn btn-primary" v-on:click="filtrarPorFechas" v-bind:disabled="cargando || buscando || !fechaDesde || !fechaHasta" data-bs-dismiss="modal">
                            <i class="fas fa-search me-1"></i> Aplicar Filtro
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Panel de Búsqueda Combinada (Activo cuando hay fechas o "Todos") -->
    <div v-if="filtrandoPorFechas || mostrarPorDias" class="card shadow-sm border-0 my-3" style="border-radius: 12px; background: #ffffff; border: 1.5px solid #bbdefb !important;">
        <div class="card-header py-2 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2" style="background: linear-gradient(135deg, #1565c0 0%, #1e88e5 100%); color: white; border-top-left-radius: 10px; border-top-right-radius: 10px;">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="badge bg-white text-primary px-3 py-2 fs-6 fw-bold">
                    <i class="fas fa-calendar-check me-1"></i> [[ textoRangoFechasActivo ]]
                </span>
                <span class="badge bg-light text-dark px-2 py-2" v-if="todosLosPagosRango.length > 0">
                    <i class="fas fa-receipt me-1"></i> [[ todosLosPagosRango.length ]] pagos en total
                </span>
                <span class="badge bg-warning text-dark px-2 py-2" v-if="filtroProveedorEnRango">
                    <i class="fas fa-filter me-1"></i> Proveedor: "[[ filtroProveedorEnRango ]]" ([[ resultadosFiltrados.length ]] encontrados)
                </span>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-light text-primary fw-semibold" data-bs-toggle="modal" data-bs-target="#filtroFechasModal">
                    <i class="fas fa-calendar-alt me-1"></i> Cambiar fechas
                </button>
                <button type="button" class="btn btn-sm btn-outline-light" v-on:click="limpiarFiltroFechas">
                    <i class="fas fa-times me-1"></i> Quitar filtros
                </button>
            </div>
        </div>
        <div class="card-body p-3 bg-light">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-6">
                    <label class="form-label mb-1 text-secondary small fw-bold">
                        <i class="fas fa-search me-1 text-primary"></i> Filtrar por Proveedor en este rango:
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-white text-primary"><i class="fas fa-user-tag"></i></span>
                        <input type="text"
                               class="form-control"
                               v-model="filtroProveedorEnRango"
                               v-on:input="filtrarResultadosPorProveedor"
                               placeholder="Escriba código o nombre de proveedor..."
                               autocomplete="off" />
                        <button class="btn btn-outline-secondary" type="button" v-if="filtroProveedorEnRango" v-on:click="limpiarFiltroProveedorEnRango" title="Ver todos los proveedores de estas fechas">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label mb-1 text-secondary small fw-bold">
                        <i class="fas fa-list-ul me-1 text-primary"></i> O seleccionar de los disponibles ([[ proveedoresDisponiblesEnRango.length ]]):
                    </label>
                    <select class="form-select" v-model="filtroProveedorSeleccionado" v-on:change="seleccionarProveedorDeLista">
                        <option value="">-- Todos los proveedores del rango ([[ proveedoresDisponiblesEnRango.length ]]) --</option>
                        <option v-for="prov in proveedoresDisponiblesEnRango" :key="prov.co_prov" :value="prov.co_prov">
                            [[ prov.nombreCompleto ]] ([[ prov.cantidad ]] pago(s) - $[[ formatNumero(prov.total) ]])
                        </option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Mensaje cuando no hay resultados en la búsqueda combinada -->
    <div v-if="(mostrarPorDias || filtrandoPorFechas) && resultadosFiltrados.length === 0 && !cargando && !buscando" class="alert alert-warning text-center my-4 shadow-sm" style="border-radius: 12px;">
        <i class="fas fa-search fa-2x mb-2 d-block text-warning"></i>
        <h5 class="mb-1">No se encontraron pagos para los criterios seleccionados</h5>
        <p class="mb-2 text-muted" v-if="filtroProveedorEnRango">
            No hay registros para el proveedor <strong>"[[ filtroProveedorEnRango ]]"</strong> en el rango de fechas seleccionado.
        </p>
        <p class="mb-2 text-muted" v-else>
            No hay registros de pagos en el rango de fechas seleccionado.
        </p>
        <div class="d-flex justify-content-center gap-2 mt-3">
            <button class="btn btn-sm btn-outline-primary" v-if="filtroProveedorEnRango" v-on:click="limpiarFiltroProveedorEnRango">
                <i class="fas fa-users me-1"></i> Ver todos los proveedores del rango
            </button>
            <button class="btn btn-sm btn-outline-secondary" v-on:click="limpiarFiltroFechas">
                <i class="fas fa-times me-1"></i> Limpiar todos los filtros
            </button>
        </div>
    </div>

    <!-- Vista por dias (cuando se presiona "Todos" o se filtra por fechas) -->
    <div v-if="mostrarPorDias && pagosAgrupadosPorDia.length > 0" class="pagos-por-dia">
        <!-- Mensaje informativo -->
        <div class="alert alert-info mb-3" style="margin-top: 24px;">
            <i class="fa fa-info-circle mr-2"></i>
            <strong>Pagos agrupados por dia</strong> - Haga clic en cualquier fila para ver el detalle completo del pago.
        </div>
        
        <div v-for="(grupo, index) in pagosAgrupadosPorDia" :key="grupo.fecha" class="dia-card mb-4">
            <div class="card border-primary shadow-sm">
                <div class="card-header bg-primary text-white">
                    <div class="text-center">
                        <i class="fa fa-calendar mr-2"></i>
                        <strong>[[ formatFechaCompleta(grupo.fecha) ]]</strong>
                    </div>
                </div>
                <div class="card-body p-0">
                    <!-- Seccion ADEL -->
                    <div v-if="grupo.pagosADEL.length > 0" class="mb-3 seccion-adel">
                        <div class="alert alert-success mb-0" style="border-radius: 0; background: linear-gradient(135deg, #4caf50 0%, #66bb6a 100%); border: none;">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <i class="fa fa-forward mr-2"></i>
                                    <strong>ADELANTOS (ADEL)</strong>
                                </div>
                                <div>
                                    <span class="badge bg-white text-success" style="font-size: 1rem; padding: 8px 12px;">
                                        [[ grupo.cantidadADEL ]] pago(s) | Total: [[ formatNumero(grupo.totalADEL) ]]
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm table-hover table-striped mb-0">
                                <thead class="thead-light">
                                    <tr>
                                        <th class="text-center">Nro. Pago</th>
                                        <th class="text-center">Codigo</th>
                                        <th class="text-center">Proveedor</th>
                                        <th class="text-center">Dias</th>
                                                        <th class="text-center">Nro Doc</th>
                                        <th class="text-end">Total</th>
                                        <th class="text-center">Tasa</th>
                                        <th class="text-end" style="width: 100px;">Total $</th>
                                        <th class="text-center">Img</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr v-for="(pago, pagoIndex) in grupo.pagosADEL"
                                        :key="pago.cob_num + '-adel-' + pagoIndex"
                                        style="cursor:pointer;"
                                        v-on:click="verDetallePago(pago)">
                                        <td class="text-center" v-html="highlight(pago.cob_num)"></td>
                                        <td v-html="highlight(pago.co_prov)"></td>
                                        <td v-html="highlight(pago.prov_des)"></td>
                                        <td class="text-center" v-html="highlight(pago.Dias)"></td>
                                        <td class="text-center" v-html="mostrarValorOpcional(pago.num_doc)"></td>
                                        <td class="text-end documento-adel">
                                            [[ formatNumero(pago.Total) ]]
                                        </td>
                                        <td class="text-center font-weight-bold" style="color: #2e7d32;">
                                            [[ formatNumero(pago.tasa) ]]
                                        </td>
                                        <td class="text-end font-weight-bold" style="color: #e65100; width: 100px;">
                                            [[ formatNumero(calcularTotalTasa(pago.Total, pago.tasa)) ]]
                                        </td>
                                        <td class="text-center">
                                            <span v-if="pago.tiene_imagen" 
                                                  v-on:click.stop="verImagenPago(pago.cob_num)"
                                                  style="cursor: pointer; color: #28a745; font-size: 18px; padding: 5px; border-radius: 4px; background-color: #e8f5e8;"
                                                  title="Ver imagen del pago">
                                                <i class="fa fa-image icono-imagen"></i>
                                            </span>
                                            <span v-else style="color: #ccc;">
                                                <i class="fa fa-image"></i>
                                            </span>
                                        </td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr class="table-success">
                                        <td colspan="5" class="text-end font-weight-bold">
                                            <i class="fa fa-calculator"></i> TOTAL ADELANTOS:
                                        </td>
                                        <td class="text-end font-weight-bold documento-adel">
                                            [[ formatNumero(grupo.totalADEL) ]]
                                        </td>
                                        <td colspan="3"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <!-- Seccion FACT -->
                    <div v-if="grupo.pagosFACT.length > 0" class="seccion-fact">
                        <div class="alert alert-danger mb-0" style="border-radius: 0; background: linear-gradient(135deg, #f44336 0%, #ef5350 100%); border: none;">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <i class="fa fa-file-invoice mr-2"></i>
                                    <strong>FACTURAS (FACT)</strong>
                                </div>
                                <div>
                                    <span class="badge bg-white text-danger" style="font-size: 1rem; padding: 8px 12px;">
                                        [[ grupo.cantidadFACT ]] pago(s) | Total: [[ formatNumero(grupo.totalFACT) ]]
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm table-hover table-striped mb-0">
                                <thead class="thead-light">
                                    <tr>
                                        <th class="text-center">Nro. Pago</th>
                                        <th class="text-center">Codigo</th>
                                        <th class="text-center">Proveedor</th>
                                        <th class="text-center">Dias</th>
                                        <th class="text-center">Nro Doc</th>
                                        <th class="text-end">Total</th>
                                        <th class="text-center">Tasa</th>
                                        <th class="text-end" style="width: 100px;">Total $</th>
                                        <th class="text-center">Img</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr v-for="(pago, pagoIndex) in grupo.pagosFACT" 
                                        :key="pago.cob_num + '-fact-' + pagoIndex"
                                        style="cursor:pointer;"
                                        v-on:click="verDetallePago(pago)">
                                        <td class="text-center" v-html="highlight(pago.cob_num)"></td>
                                        <td v-html="highlight(pago.co_prov)"></td>
                                        <td v-html="highlight(pago.prov_des)"></td>
                                        <td class="text-center" v-html="highlight(pago.Dias)"></td>
                                        <td class="text-center" v-html="mostrarValorOpcional(pago.num_doc)"></td>
                                        <td class="text-end documento-fact">
                                            [[ formatNumero(pago.Total) ]]
                                        </td>
                                        <td class="text-center font-weight-bold" style="color: #2e7d32;">
                                            [[ formatNumero(pago.tasa) ]]
                                        </td>
                                        <td class="text-end font-weight-bold" style="color: #e65100; width: 100px;">
                                            [[ formatNumero(calcularTotalTasa(pago.Total, pago.tasa)) ]]
                                        </td>
                                        <td class="text-center">
                                            <span v-if="pago.tiene_imagen" 
                                                  v-on:click.stop="verImagenPago(pago.cob_num)"
                                                  style="cursor: pointer; color: #28a745; font-size: 18px; padding: 5px; border-radius: 4px; background-color: #e8f5e8;"
                                                  title="Ver imagen del pago">
                                                <i class="fa fa-image icono-imagen"></i>
                                            </span>
                                            <span v-else style="color: #ccc;">
                                                <i class="fa fa-image"></i>
                                            </span>
                                        </td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr class="table-danger">
                                        <td colspan="5" class="text-end font-weight-bold">
                                            <i class="fa fa-calculator"></i> TOTAL FACTURAS:
                                        </td>
                                        <td class="text-end font-weight-bold documento-fact">
                                            [[ formatNumero(grupo.totalFACT) ]]
                                        </td>
                                        <td colspan="3"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            
        </div>
    </div>

    <!-- Tabla de resultados normal (búsquedas específicas) -->
    <div v-if="!mostrarPorDias && resultadosPaginados.length > 0" class="table-responsive">
        <!-- Mensaje informativo -->
        <div class="alert alert-info mb-3" style="margin-top: 24px;">
            <i class="fa fa-info-circle mr-2"></i>
            <strong>Haga clic en cualquier fila</strong> para ver el detalle completo del pago.
        </div>
        <table class="table table-bordered table-striped mt-3">
            <thead>
                <tr>
                    <th class="cabecera-azul-claro" v-on:click="ordenarPor('cob_num')" style="cursor:pointer;">
                        <i class="fa fa-hashtag"></i> Nro. Pago
                        <span v-if="columnaOrden==='cob_num'">
                            <span v-if="ordenAscendente">&#9650;</span>
                            <span v-else>&#9660;</span>
                        </span>
                    </th>
                    <th class="cabecera-azul-claro" v-on:click="ordenarPor('co_prov')" style="cursor:pointer;">
                        <i class="fa fa-id-card"></i> Codigo
                        <span v-if="columnaOrden==='co_prov'">
                            <span v-if="ordenAscendente">&#9650;</span>
                            <span v-else>&#9660;</span>
                        </span>
