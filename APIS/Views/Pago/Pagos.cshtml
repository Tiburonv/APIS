<style>
    /* En Index.cshtml (Clientes) */
    body {
        /* Mejoras para scroll móvil */
        -webkit-overflow-scrolling: touch;
        scroll-behavior: smooth;
    }

    /* Contenedor principal con scroll optimizado para móvil */
    .container {
        overflow-x: hidden;
        -webkit-overflow-scrolling: touch;
    }

    /* Scroll personalizado para móviles */
    ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
    }

    ::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 4px;
    }

    ::-webkit-scrollbar-thumb {
        background: #1565c0;
        border-radius: 4px;
    }

    ::-webkit-scrollbar-thumb:hover {
        background: #0d47a1;
    }

    /* Scroll horizontal para tablas en móvil */
    .table-responsive {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: thin;
        scrollbar-color: #1565c0 #f1f1f1;
    }

    /* Indicador de scroll para móviles */
    .scroll-indicator {
        position: fixed;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(21, 101, 192, 0.8);
        color: white;
        padding: 8px 4px;
        border-radius: 20px;
        font-size: 12px;
        z-index: 1000;
        opacity: 0;
        transition: opacity 0.3s;
        pointer-events: none;
    }

    .scroll-indicator.show {
        opacity: 1;
    }

    /* Mejoras para navegacion tactil */
    .table tbody tr {
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
    }

    .btn {
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
    }

    /* Scroll suave para secciones */
    .scroll-smooth {
        scroll-behavior: smooth;
        -webkit-overflow-scrolling: touch;
    }

    h4 {
        color: #1565c0;
    }

    .search-container {
        margin: 32px auto 24px auto;
        max-width: 520px;
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 2px 16px rgba(21,101,192,0.10);
        padding: 28px 36px 20px 36px;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .search-flex {
        display: flex;
        align-items: center;
        width: 100%;
        max-width: 400px;
    }

    .search-flex .form-control {
        width: 100%;
    }

        .search-flex img {
            height: 38px;
            margin-right: 14px;
            border-radius: 6px;
        }

    .cabecera-azul-claro {
        background-color: #1565c0 !important;
        color: #fff;
        border-radius: 6px 6px 0 0;
        font-size: 1.1rem;
        letter-spacing: 0.5px;
    }

    .row-seleccionada, .table-active {
        background-color: #ffe082 !important;
        font-weight: bold;
    }

    .table-hover tbody tr:hover {
        background-color: #e3f2fd !important;
        transition: background 0.2s;
    }

    .table-striped tbody tr:nth-of-type(odd) {
        background-color: #f8f9fa;
    }

    .table-striped tbody tr:nth-of-type(even) {
        background-color: #ffffff;
    }

    /* Diferenciación más clara de renglones */
    .table tbody tr {
        border-bottom: 1px solid #e9ecef;
        transition: all 0.2s ease;
    }

    .table tbody tr:nth-of-type(odd) {
        background-color: #f8f9fa;
        border-left: 3px solid #e3f2fd;
    }

    .table tbody tr:nth-of-type(even) {
        background-color: #ffffff;
        border-left: 3px solid #f0f8ff;
    }

    /* Efecto hover mejorado */
    .table tbody tr:hover {
        background-color: #e3f2fd !important;
        transform: translateY(-1px);
        box-shadow: 0 2px 8px rgba(21, 101, 192, 0.15);
        border-left-color: #1565c0;
    }

    /* Estilos para las tablas dentro de las tarjetas por día - DEPRECADO, los estilos ahora son específicos por sección */
