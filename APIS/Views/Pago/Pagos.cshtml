    /* Estilos para el modal de filtro de fechas */
    .modal-content {
        border-radius: 8px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    }

    .modal-header {
        background: linear-gradient(135deg, #1565c0 0%, #1976d2 100%);
        color: white;
        border-bottom: none;
        border-radius: 8px 8px 0 0;
    }

    .modal-title {
