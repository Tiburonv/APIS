@{
    ViewBag.Title = "Proveedores";
    var co_prov = ViewBag.co_prov as string;
    var prov_des = ViewBag.prov_des as string;
}

<style>
    /* Proveedores v2.0 - inherits from Site.css globals */
    body { -webkit-overflow-scrolling: touch; scroll-behavior: smooth; }

    .table tbody tr { touch-action: manipulation; -webkit-tap-highlight-color: transparent; }
    .btn { touch-action: manipulation; -webkit-tap-highlight-color: transparent; }

    /* Search container override for prov module */
    .search-container {
        margin: 20px auto;
        max-width: 640px;
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(15,23,42,0.09);
        padding: 26px 30px 22px;
        border: 1px solid #e2e8f0;
    }
    .search-container h4 {
        font-size: 1.15rem;
        font-weight: 700;
        color: #1565c0;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
        letter-spacing: -0.02em;
    }
    .search-container h4 .ph-icon {
        width: 36px; height: 36px;
        background: linear-gradient(135deg, #1565c0 0%, #1e88e5 100%);
        color: #fff; border-radius: 8px;
        display: inline-flex; align-items: center; justify-content: center;
        font-size: 0.95rem; flex-shrink: 0;
    }

    .search-flex { display: flex; align-items: center; gap: 10px; }
    .search-flex input.form-control {
        flex: 1;
        padding: 11px 14px;
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        font-size: 0.95rem;
        transition: all 0.2s ease;
    }
    .search-flex input.form-control:focus {
        border-color: #1565c0;
        box-shadow: 0 0 0 3.5px rgba(21,101,192,0.12);
        outline: none;
    }

    .btn-todos-prov {
        background: linear-gradient(135deg, #1565c0 0%, #1e88e5 100%);
        border: none; color: #fff; font-weight: 600; font-size: 0.9rem;
        padding: 10px 20px; border-radius: 10px; white-space: nowrap;
        box-shadow: 0 3px 10px rgba(21,101,192,0.3);
        transition: all 0.2s ease; display: flex; align-items: center; gap: 7px;
        height: 44px;
    }
    .btn-todos-prov:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(21,101,192,0.45);
        background: linear-gradient(135deg, #0d47a1 0%, #1565c0 100%);
        color: #fff;
    }
    .btn-todos-prov:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

    .autocomplete-list {
        position: absolute; z-index: 1000; width: 100%;
        max-height: 220px; overflow-y: auto;
        box-shadow: 0 8px 24px rgba(15,23,42,0.12);
        border-radius: 10px; border: 1px solid #e2e8f0;
        -webkit-overflow-scrolling: touch;
        animation: fadeInDropdown 0.2s ease;
    }
    @@keyframes fadeInDropdown { from { opacity:0; transform:translateY(6px); } to { opacity:1; transform:translateY(0); } }
    .autocomplete-item { cursor: pointer; transition: background 0.15s; padding: 9px 14px; font-size: 0.9rem; }
    .autocomplete-item:hover { background: #e3f2fd; color: #1565c0; }

    .table-responsive {
        margin-top: 20px;
        border-radius: 16px;
        box-shadow: 0 4px 14px rgba(15,23,42,0.07);
        background: #fff;
        overflow-x: auto;
        border: 1px solid #e2e8f0;
    }

    /* Stat summary strip */
    .prov-stat-strip {
        display: flex; gap: 12px; flex-wrap: wrap;
        margin: 16px 0 8px;
    }
    .prov-stat-strip .stat-chip {
        font-size: 0.82rem;
    }

    .document-link { color: #1565c0 !important; text-decoration: none; font-weight: 600; transition: color 0.2s ease; }
    .document-link:hover { color: #0d47a1 !important; text-decoration: underline; }

    .scroll-to-top {
        position: fixed; bottom: 24px; right: 24px;
        background: linear-gradient(135deg, #1565c0 0%, #1e88e5 100%);
        color: #fff; border: none; border-radius: 50%;
        width: 48px; height: 48px; font-size: 18px; cursor: pointer;
        opacity: 0; transition: opacity 0.3s, transform 0.3s; z-index: 1000;
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 4px 14px rgba(21,101,192,0.4);
    }
    .scroll-to-top.show { opacity: 1; }
    .scroll-to-top:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(21,101,192,0.5); }

    @@media (max-width: 768px) {
        .table-responsive { margin: 14px 0; border-radius: 12px; }
        .table { font-size: 0.82rem; }
        .table td, .table th { padding: 0.45rem 0.35rem; white-space: nowrap; }
        .search-flex { flex-direction: column; align-items: stretch; }
        .btn-todos-prov { width: 100%; }
    }
</style>

<script>
    var initialCoCli = '@(co_prov ?? "")';
    var initialCliDes = '@(prov_des ?? "")';
</script>


<div class="container-fluid" id="root">
    <!-- Indicador de carga global -->
    <div v-if="cargando" class="loading-overlay">
        <div class="loading-spinner">
            <div class="spinner-border spinner-border-custom text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <div class="loading-text">[[ textoCargar ]]</div>
        </div>
    </div>

    <div class="search-container">
        <h4>
            <span class="ph-icon"><i class="fas fa-truck-moving"></i></span>
            Buscar Proveedor
        </h4>
        <div class="search-meta" v-if="totalProveedoresEncontrados > 0" style="font-size:0.84rem;color:#64748b;margin-bottom:12px;">
            <strong style="color:#0d47a1;font-size:1rem;">[[ totalProveedoresEncontrados ]]</strong> proveedores encontrados
        </div>
        <div style="position:relative;">
            <div class="search-flex">
                <input type="text"
                       :class="['form-control', {'search-loading': buscando}]"
                       v-model="txtBusqueda"
                       v-on:focus="limpiarBusqueda"
                       v-on:input="buscarSugerenciasDebounced"
                       v-on:keyup.enter="getBsuqueda()"
                       placeholder="Código o nombre del proveedor..."
                       autocomplete="off"
                       v-bind:disabled="buscando || cargando" />
                <button class="btn-todos-prov"
                        v-on:click="cargarTodos()"
                        v-bind:disabled="buscando || cargando">
                    <i class="fas fa-list" v-if="!buscando && !cargando"></i>
                    <i class="fas fa-spinner fa-spin" v-else></i>
                    <span v-if="!buscando && !cargando">Todos</span>
                    <span v-else>...</span>
                </button>
            </div>
            <ul v-if="sugerencias.length > 0" class="list-group autocomplete-list">
                <li class="list-group-item autocomplete-item"
                    v-for="(s, i) in sugerencias"
                    :key="i"
                    v-on:click="seleccionarSugerencia(s)">
                    <i class="fas fa-building me-2" style="color:#94a3b8;"></i> [[ s ]]
                </li>
            </ul>
        </div>
    </div>

    <div class="table-responsive" v-if="resultadosPaginados.length > 0">
        <table class="table table-bordered mt-3">
            <thead>
                <tr>
                    <th class="cabecera-azul-claro" v-on:click="ordenarPor('co_prov')" style="cursor:pointer;">
                        <i class="fa fa-id-card"></i> Código Proveedor
                        <span v-if="columnaOrden==='co_prov'">
                            <span v-if="ordenAscendente">&#9650;</span>
                            <span v-else>&#9660;</span>
                        </span>
                    </th>
                    <th class="cabecera-azul-claro" v-on:click="ordenarPor('prov_des')" style="cursor:pointer;">
                        <i class="fa fa-user"></i> Nombre Proveedor
                        <span v-if="columnaOrden==='prov_des'">
                            <span v-if="ordenAscendente">&#9650;</span>
                            <span v-else>&#9660;</span>
                        </span>
                    </th>
                    <th class="cabecera-azul-claro text-center" v-on:click="ordenarPor('cant_documentos')" style="cursor:pointer;">
                        <i class="fa fa-file-alt"></i> Cant. Docs
                        <span v-if="columnaOrden==='cant_documentos'">
                            <span v-if="ordenAscendente">&#9650;</span>
                            <span v-else>&#9660;</span>
                        </span>
                    </th>
                    <th class="cabecera-azul-claro text-end" v-on:click="ordenarPor('total_saldo')" style="cursor:pointer;">
                        <i class="fa fa-dollar-sign"></i> Total Saldo
                        <span v-if="columnaOrden==='total_saldo'">
                            <span v-if="ordenAscendente">&#9650;</span>
                            <span v-else>&#9660;</span>
                        </span>
                    </th>
                </tr>
            </thead>
            <tbody>
                <tr v-for="(item, index) in resultadosPaginados"
                    :key="item.co_prov + '-' + index"
                    :class="{
                        'table-active': clienteSeleccionado
                            && clienteSeleccionado.co_prov === item.co_prov
                            && clienteSeleccionado.prov_des === item.prov_des,
                        'row-seleccionada': clienteSeleccionado
                            && clienteSeleccionado.co_prov === item.co_prov
                            && clienteSeleccionado.prov_des === item.prov_des
                    }"
                    style="cursor:pointer;"
                    v-on:click="seleccionarCliente(item)">
                    <td v-html="highlight(item.co_prov)"></td>
                    <td v-html="highlight(item.prov_des)"></td>
                    <td class="text-center"><strong>[[ item.cant_documentos || 0 ]]</strong></td>
                    <td class="text-end"><strong>[[ formatNumero(item.total_saldo) ]]</strong></td>
                </tr>
            </tbody>
        </table>
    </div>

    <nav v-if="totalPaginas > 1">
        <ul class="pagination justify-content-center">
            <li :class="['page-item', {disabled: paginaActual === 1}]">
                <a class="page-link" href="#" v-on:click.prevent="cambiarPagina(paginaActual - 1)">Anterior</a>
            </li>
            <li v-for="n in totalPaginas" :key="n" :class="['page-item', {active: paginaActual === n}]">
                <a class="page-link" href="#" v-on:click.prevent="cambiarPagina(n)">[[ n ]]</a>
            </li>
            <li :class="['page-item', {disabled: paginaActual === totalPaginas}]">
                <a class="page-link" href="#" v-on:click.prevent="cambiarPagina(paginaActual + 1)">Siguiente</a>
            </li>
        </ul>
    </nav>

    <div v-if="resultadosFiltrados.length === 0 && txtBusqueda" class="alert alert-info mt-3">
        <i class="fa fa-info-circle"></i> No se encontraron documentos para el proveedor.
    </div>

    <!-- RESULTADOS SELECCIONADOS MEJORADOS -->
    <div v-if="clienteSeleccionado" class="mt-4">
        @*<div class="alert alert-info" role="alert">
                <i class="fas fa-info-circle me-2"></i>
                <strong>Tip:</strong> Haz clic en el número de documento para ver los detalles completos del documento de compra.
            </div>*@
        <div class="card border-primary shadow-sm">
            <div class="card-header bg-primary text-white d-flex align-items-center" style="font-size:1.15rem;">
                <i class="fa fa-list-alt mr-2"></i>
                <span class="ml-2">Resultados para los Proveedores seleccionado</span>
            </div>
            <div class="card-body p-3" style="background:#f8fafc;">
                <div class="table-responsive">
                    <table class="table table-sm table-bordered table-hover table-striped mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>Tipo Doc</th>
                                <th>Nro Doc</th>
                                <th>Nro Prov</th>
                                <th>Fecha</th>
                                <th>Días</th>
                                @*<th>Estatus</th>*@
                                <th class="text-center">IVA 25%</th>
                                <th class="text-center">IVA 75%</th>
                                <th class="text-center">Monto Sin IVA</th>
                                <th class="text-center">IVA</th>
                                <th class="text-center">Saldo</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr v-for="(item, idx) in resultadosPorCliente" :key="item.co_prov + '-' + idx" :class="{'fila-roja': Number(item.Dias) > 40}">
                                <td class="truncate text-center" :title="item.co_tipo_doc" v-html="highlight(item.co_tipo_doc)"></td>
                                @*<td class="text-center">
                                        <a :href="'/DocumentoCP/DetalleDocumento?co_tipo_doc=' + item.co_tipo_doc + '&nro_doc=' + item.nro_doc + '&co_prov=' + item.co_prov + '&prov_des=' + encodeURIComponent(item.prov_des)"
                                           class="document-link"
                                           :title="'Ver detalles de ' + item.co_tipo_doc + ' ' + item.nro_doc"
                                           v-html="highlight(item.nro_doc)">
                                        </a>
                                    </td>*@

                                <td class="text-center">
                                    <a href="javascript:void(0)"
                                       class="text-decoration-none"
                                       v-on:click="navigateToDocument(item)"
                                       v-html="highlight(item.nro_doc)">
                                    </a>
                                </td>

                                <td class="text-center" v-html="highlight(item.nro_fact)"></td>
                                <td class="text-center">[[ formatFecha(item.fec_emis) ]]</td>
                                <td class="text-center" v-html="highlight(item.Dias)"></td>
                                @*<td class="text-center" v-html="highlight(item.estado_retencion)"></td>*@
                                <td class="text-end">[[ formatNumero(item.IVA25) ]]</td>
                                @*<td class="text-end">[[ formatNumero(item.Ret75) ]]</td>*@
                                <td class="text-end" v-html="highlight(item.estado_retencion)"></td>
                                <td class="text-end">[[ formatNumero(item.monto_bru) ]]</td>
                                <td class="text-end">[[ formatNumero(item.monto_imp) ]]</td>
                                <td class="text-end">[[ formatNumero(item.saldo) ]]</td>
                            </tr>
                        </tbody>
                        <tfoot v-if="resultadosPorCliente.length > 1">
                            <tr style="font-weight:bold; background:#e3f2fd;">
                                <td colspan="5" class="text-right">Totales:</td>
                                <td class="text-end">[[ sumaCol('IVA25') ]]</td>
                                <td class="text-end">[[ sumaCol('estado_retencion') ]]</td>
                                <td class="text-end">[[ sumaCol('monto_bru') ]]</td>
                                <td class="text-end">[[ sumaCol('monto_imp') ]]</td>
                                <td class="text-end">[[ sumaCol('saldo') ]]</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <!-- FIN RESULTADOS SELECCIONADOS MEJORADOS -->
</div>

<!-- Botón de scroll hacia arriba -->
<button class="scroll-to-top" id="scrollToTop" title="Ir arriba">
    <i class="fa fa-arrow-up"></i>
</button>

<!-- Indicador de scroll -->
<div class="scroll-indicator" id="scrollIndicator">
    <i class="fa fa-chevron-up"></i><br>
    <i class="fa fa-chevron-down"></i>
</div>

@section scripts{
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/vue@2/dist/vue.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.9.0/axios.min.js"></script>

    <script>
        function debounce(func, wait) {
            let timeout;
            return function (...args) {
                clearTimeout(timeout);
                timeout = setTimeout(() => func.apply(this, args), wait);
            };
        }

        var app = new Vue({
            el: "#root",
            delimiters: ['[[', ']]'],
            data: {
                txtBusqueda: '',
                sugerencias: [],
                resultadosFiltrados: [],
                todosLosDocumentos: [], // Almacenar todos los documentos originales
                clienteSeleccionado: null,
                resultadosPorCliente: [],
                paginaActual: 1,
                resultadosPorPagina: 20, // Changed to 20
                totalRecords: 0, // Added totalRecords
                columnaOrden: '',
                ordenAscendente: true,
                cargando: false,
                buscando: false,
                textoCargar: 'Cargando...'
            },
            computed: {
                resultadosPaginados() {
                    // Si no hay búsqueda activa (modo "Todos"), mostrar todos sin paginar
                    if (this.txtBusqueda.trim() === '') {
                        return this.resultadosFiltrados;
                    }
                    // Si hay búsqueda, retornar los resultados paginados del servidor
                    return this.resultadosFiltrados;
                },
                totalPaginas() {
                    // Solo mostrar paginación si hay búsqueda activa
                    if (this.txtBusqueda.trim() === '') {
                        return 1;
                    }
                    return Math.ceil(this.totalRecords / this.resultadosPorPagina);
                }
            },
            methods: {
                cargarTodos() {
                    this.buscando = true;
                    this.cargando = true;
                    this.textoCargar = 'Cargando todos los proveedores...';
                    this.txtBusqueda = '';
                    this.sugerencias = [];
                    this.paginaActual = 1;

                    axios.get('/DocumentoCP/buscarPorDocumCP', {
                        params: {
                            nombre: '',
                            page: 1,
                            pageSize: 999999 // Cargar todos los registros sin paginación
                        }
                    })
                        .then((response) => {
                            const todosLosDatos = response.data.datos || [];
                            
                            // Guardar todos los documentos originales
                            this.todosLosDocumentos = todosLosDatos;
                            
                            // Agrupar por proveedor y calcular estadísticas
                            const proveedoresMap = {};
                            
                            todosLosDatos.forEach(item => {
                                const coProv = item.co_prov || '';
                                const provDes = item.prov_des || '';
                                const key = coProv + '|' + provDes;
                                
                                if (!proveedoresMap[key]) {
                                    proveedoresMap[key] = {
                                        co_prov: coProv,
                                        prov_des: provDes,
                                        cant_documentos: 0,
                                        total_saldo: 0
                                    };
                                }
                                
                                proveedoresMap[key].cant_documentos++;
                                proveedoresMap[key].total_saldo += Number(item.saldo) || 0;
                            });
                            
                            // Convertir el mapa a array
                            this.resultadosFiltrados = Object.values(proveedoresMap);
                            this.totalRecords = this.resultadosFiltrados.length;
                            this.clienteSeleccionado = null;
                            this.resultadosPorCliente = [];
                            this.buscando = false;
                            this.cargando = false;
                        })
                        .catch(() => {
                            this.resultadosFiltrados = [];
                            this.todosLosDocumentos = [];
                            this.totalRecords = 0;
                            this.clienteSeleccionado = null;
                            this.resultadosPorCliente = [];
                            this.buscando = false;
                            this.cargando = false;
                        });
                },
                getBsuqueda(page) {
                    if (this.txtBusqueda.trim() !== '') {
                        let cadena = this.txtBusqueda.trim();
                        
                        this.buscando = true;
                        this.cargando = true;
                        this.textoCargar = 'Buscando proveedores...';

                        axios.get('/DocumentoCP/buscarPorDocumCP', {
                            params: {
                                nombre: cadena,
                                page: page || this.paginaActual,
                                pageSize: this.resultadosPorPagina
                            }
                        })
                            .then((response) => {
                                const todosLosDatos = response.data.datos || [];
                                this.totalRecords = response.data.totalRecords || 0;
                                
                                // Guardar todos los documentos originales
                                this.todosLosDocumentos = todosLosDatos;
                                
                                // Agrupar por proveedor y calcular estadísticas
                                const proveedoresMap = {};
                                
                                todosLosDatos.forEach(item => {
                                    const coProv = item.co_prov || '';
                                    const provDes = item.prov_des || '';
                                    const key = coProv + '|' + provDes;
                                    
                                    if (!proveedoresMap[key]) {
                                        proveedoresMap[key] = {
                                            co_prov: coProv,
                                            prov_des: provDes,
                                            cant_documentos: 0,
                                            total_saldo: 0
                                        };
                                    }
                                    
                                    proveedoresMap[key].cant_documentos++;
                                    proveedoresMap[key].total_saldo += Number(item.saldo) || 0;
                                });
                                
                                // Convertir el mapa a array
                                this.resultadosFiltrados = Object.values(proveedoresMap);

                                this.clienteSeleccionado = null;
                                this.resultadosPorCliente = [];
                                this.sugerencias = [];

                                if (initialCoCli && initialCliDes) {
                                    const cliente = this.resultadosFiltrados.find(x => {
                                        const xCoProv = x.co_prov || '';
                                        const xProvDes = x.prov_des || '';
                                        return xCoProv === initialCoCli && xProvDes === initialCliDes;
                                    });
                                    if (cliente) {
                                        this.seleccionarCliente(cliente);
                                    }
                                }
                                this.buscando = false;
                                this.cargando = false;
                            })
                            .catch(() => {
                                this.resultadosFiltrados = [];
                                this.todosLosDocumentos = [];
                                this.totalRecords = 0;
                                this.clienteSeleccionado = null;
                                this.resultadosPorCliente = [];
                                this.sugerencias = [];
                                this.buscando = false;
                                this.cargando = false;
                            });
                    } else {
                        this.resultadosFiltrados = [];
                        this.todosLosDocumentos = [];
                        this.totalRecords = 0;
                        this.clienteSeleccionado = null;
                        this.resultadosPorCliente = [];
                        this.sugerencias = [];
                        this.buscando = false;
                        this.cargando = false;
                    }
                },
                buscarSugerencias() {
                    if (this.txtBusqueda.length < 2) {
                        this.sugerencias = [];
                        return;
                    }
                    // This method needs to be adapted for server-side search if the list is too large
                    const texto = this.txtBusqueda.toLowerCase();
                    const sugerenciasSet = new Set();
                    this.resultadosFiltrados.forEach(item => {
                        const provDes = item.prov_des || '';
                        const coProv = item.co_prov || '';

                        if (provDes && provDes.toLowerCase().includes(texto)) {
                            sugerenciasSet.add(provDes);
                        }
                        if (coProv && coProv.toLowerCase().includes(texto)) {
                            sugerenciasSet.add(coProv);
                        }
                    });
                    this.sugerencias = Array.from(sugerenciasSet).slice(0, 10);
                },
                seleccionarSugerencia(s) {
                    this.txtBusqueda = s;
                    this.sugerencias = [];
                    this.paginaActual = 1;
                    this.getBsuqueda();
                },
                seleccionarCliente(item) {
                    this.cargando = true;
                    this.textoCargar = 'Cargando documentos del proveedor...';
                    
                    setTimeout(() => {
                        this.clienteSeleccionado = item;
                        // Filtrar documentos desde todosLosDocumentos en lugar de resultadosFiltrados
                        this.resultadosPorCliente = this.todosLosDocumentos.filter(x => {
                            const xCoProv = x.co_prov || '';
                            const xProvDes = x.prov_des || '';
                            const itemCoProv = item.co_prov || '';
                            const itemProvDes = item.prov_des || '';

                            return xCoProv === itemCoProv && xProvDes === itemProvDes;
                        });

                        this.resultadosFiltrados = [item];
                        this.paginaActual = 1;
                        this.totalRecords = 1;
                        this.cargando = false;
                    }, 300);
                },
                cambiarPagina(pagina) {
                    if (página > 0 && página <= this.totalPaginas) {
                        this.paginaActual = pagina;
                        this.getBsuqueda(pagina);
                    }
                },
                ordenarPor(columna) {
                    if (this.columnaOrden === columna) {
                        this.ordenAscendente = !this.ordenAscendente;
                    } else {
                        this.columnaOrden = columna;
                        this.ordenAscendente = true;
                    }
                    this.resultadosFiltrados.sort((a, b) => {
                        let valA = a[columna];
                        let valB = b[columna];
                        
                        // Para columnas numéricas, convertir a número
                        if (columna === 'cant_documentos' || columna === 'total_saldo') {
                            valA = Number(valA) || 0;
                            valB = Number(valB) || 0;
                        }
                        
                        if (valA < valB) return this.ordenAscendente ? -1 : 1;
                        if (valA > valB) return this.ordenAscendente ? 1 : -1;
                        return 0;
                    });
                },
                formatNumero(valor) {
                    if (valor == null || valor === '' || Number(valor) === 0) return '';
                    return Number(valor).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                },
                formatFecha(valor) {
                    if (!valor) return '';
                    let fecha;

                    if (typeof valor === 'string' && valor.match(/\/Date\((\d+)\)\//)) {
                        const ms = parseInt(valor.match(/\/Date\((\d+)\)\//)[1], 10);
                        fecha = new Date(ms);
                    } else if (typeof valor === 'string' && valor.length === 10 && valor.match(/^\d{4}-\d{2}-\d{2}$/)) {
                        const [anio, mes, dia] = valor.split('-');
                        fecha = new Date(Number(anio), Number(mes) - 1, Number(dia));
                    } else {
                        fecha = new Date(valor);
                    }

                    if (isNaN(fecha)) return valor;

                    const dia = ('0' + fecha.getDate()).slice(-2);
                    const mes = ('0' + (fecha.getMonth() + 1)).slice(-2);
                    const anio = fecha.getFullYear();
                    return `${dia}/${mes}/${anio}`;
                },
                navigateToDocument(item) {
                    this.cargando = true;
                    this.textoCargar = 'Cargando detalle del documento...';
                    
                    setTimeout(() => {
                        window.location.href = '/DocumentoCP/DetalleDocumento?co_tipo_doc=' + 
                            encodeURIComponent(item.co_tipo_doc.trim()) + 
                            '&nro_doc=' + encodeURIComponent(item.nro_doc.trim()) + 
                            '&co_prov=' + encodeURIComponent(this.clienteSeleccionado.co_prov.trim()) + 
                            '&prov_des=' + encodeURIComponent(this.clienteSeleccionado.prov_des.trim());
                    }, 300);
                },
                limpiarBusqueda() {
                    this.txtBusqueda = '';
                    this.sugerencias = [];
                    this.resultadosFiltrados = [];
                    this.todosLosDocumentos = [];
                    this.totalRecords = 0;
                    this.clienteSeleccionado = null;
                    this.resultadosPorCliente = [];
                    this.paginaActual = 1;
                    this.buscando = false;
                    this.cargando = false;
                },
                sumaCol(campo) {
                    return this.resultadosPorCliente.reduce((acc, item) => {
                        let val = Number(item[campo]);
                        return acc + (isNaN(val) ? 0 : val);
                    }, 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                },
                highlight(text) {
                    if (!this.txtBusqueda) return text;
                    if (text == null || text === undefined) return '';

                    const regex = new RegExp(`(${this.txtBusqueda})`, 'gi');
                    return text.toString().replace(regex, '<span class="highlight">$1</span>');
                },
                setupMobileScroll() {
                    const scrollToTopBtn = document.getElementById('scrollToTop');
                    const scrollIndicator = document.getElementById('scrollIndicator');
                    let scrollTimeout;

                    window.addEventListener('scroll', () => {
                        if (window.pageYOffset > 300) {
                            scrollToTopBtn.classList.add('show');
                        } else {
                            scrollToTopBtn.classList.remove('show');
                        }

                        clearTimeout(scrollTimeout);
                        scrollIndicator.classList.add('show');
                        
                        scrollTimeout = setTimeout(() => {
                            scrollIndicator.classList.remove('show');
                        }, 2000);
                    });

                    scrollToTopBtn.addEventListener('click', () => {
                        window.scrollTo({
                            top: 0,
                            behavior: 'smooth'
                        });
                    });

                    const tables = document.querySelectorAll('.table-responsive');
                    tables.forEach(table => {
                        let isScrolling = false;
                        let startX, startScrollLeft;

                        table.addEventListener('touchstart', (e) => {
                            isScrolling = true;
                            startX = e.touches[0].pageX - table.offsetLeft;
                            startScrollLeft = table.scrollLeft;
                        });

                        table.addEventListener('touchmove', (e) => {
                            if (!isScrolling) return;
                            e.preventDefault();
                            const x = e.touches[0].pageX - table.offsetLeft;
                            const walk = (x - startX) * 2;
                            table.scrollLeft = startScrollLeft - walk;
                        });

                        table.addEventListener('touchend', () => {
                            isScrolling = false;
                        });
                    });
                }
            },
            created() {
                this.buscarSugerenciasDebounced = debounce(this.buscarSugerencias, 300);
                if (initialCoCli && initialCliDes) {
                    this.txtBusqueda = initialCliDes;
                    this.getBsuqueda();
                }
            },
            mounted() {
                this.setupMobileScroll();
            }
        });
    </script>
}