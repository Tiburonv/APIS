@{
    ViewBag.Title = "Proveedores";
    var co_prov = ViewBag.co_prov as string;
    var prov_des = ViewBag.prov_des as string;
}

<style>
    /* En Index.cshtml (Clientes) */
    body {
        background: #f4f6fb;
        /* Mejoras para scroll móvil */
        -webkit-overflow-scrolling: touch;
        scroll-behavior: smooth;
    }

    /* Contenedor principal con scroll optimizado para móvil */
    .container {
        overflow-x: hidden;
        -webkit-overflow-scrolling: touch;
    }

    /* Scroll personalizado para móviles */
    ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
    }

    ::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 4px;
    }

    ::-webkit-scrollbar-thumb {
        background: #1565c0;
        border-radius: 4px;
    }

    ::-webkit-scrollbar-thumb:hover {
        background: #0d47a1;
    }

    /* Scroll horizontal para tablas en móvil */
    .table-responsive {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: thin;
        scrollbar-color: #1565c0 #f1f1f1;
    }

    /* Indicador de scroll para móviles */
    .scroll-indicator {
        position: fixed;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(21, 101, 192, 0.8);
        color: white;
        padding: 8px 4px;
        border-radius: 20px;
        font-size: 12px;
        z-index: 1000;
        opacity: 0;
        transition: opacity 0.3s;
        pointer-events: none;
    }

    .scroll-indicator.show {
        opacity: 1;
    }

    /* Mejoras para navegación táctil */
    .table tbody tr {
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
    }

    .btn {
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
    }

    /* Scroll suave para secciones */
    .scroll-smooth {
        scroll-behavior: smooth;
        -webkit-overflow-scrolling: touch;
    }

    h4 {
        color: #1565c0;
    }

    .search-container {
        margin: 32px auto 24px auto;
        max-width: 520px;
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 2px 16px rgba(21,101,192,0.10);
        padding: 28px 36px 20px 36px;
    }

    .search-flex {
        display: flex;
        align-items: center;
    }

        .search-flex img {
            height: 38px;
            margin-right: 14px;
            border-radius: 6px;
        }

    .cabecera-azul-claro {
        background-color: #1565c0 !important;
        color: #fff;
        border-radius: 6px 6px 0 0;
        font-size: 1.1rem;
        letter-spacing: 0.5px;
    }

    .row-seleccionada, .table-active {
        background-color: #ffe082 !important;
        font-weight: bold;
    }

    .table-hover tbody tr:hover {
        background-color: #e3f2fd !important;
        transition: background 0.2s;
    }

    .table-striped tbody tr:nth-of-type(odd) {
        background-color: #f9f9f9;
    }

    .truncate {
        max-width: 120px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .highlight {
        background-color: #ffff66;
        padding: 0 2px;
        border-radius: 2px;
    }

    .autocomplete-list {
        position: absolute;
        z-index: 1000;
        width: 100%;
        max-height: 200px;
        overflow-y: auto;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        border-radius: 0 0 6px 6px;
        -webkit-overflow-scrolling: touch;
    }

    .autocomplete-item {
        cursor: pointer;
        transition: background 0.2s;
        touch-action: manipulation;
    }

        .autocomplete-item:hover {
            background: #e3f2fd;
        }

    .table-responsive {
        margin-top: 24px;
        border-radius: 8px;
        box-shadow: 0 2px 12px rgba(21,101,192,0.08);
        background: #fff;
        padding: 16px;
    }

    .pagination {
        margin-top: 20px;
    }

    .alert-info {
        margin-top: 24px;
        border-radius: 6px;
    }

    h4, h5 {
        color: #1565c0;
        font-weight: 600;
        margin-bottom: 18px;
    }

    /* Mejoras para el card de resultados seleccionados */
    .card.border-primary {
        border: 1.5px solid #1565c0 !important;
    }

    .card-header.bg-primary {
        background: #1565c0 !important;
        color: #fff !important;
        font-weight: 600;
        font-size: 1.15rem;
        letter-spacing: 0.5px;
        border-radius: 8px 8px 0 0;
    }

    .card {
        border-radius: 8px;
        box-shadow: 0 2px 12px rgba(21,101,192,0.10);
    }

    .table tfoot tr {
        background: #e3f2fd !important;
    }

    /* Estilos para enlaces de documentos */
    .document-link {
        color: #1565c0 !important;
        text-decoration: none;
        font-weight: 600;
        transition: color 0.2s ease;
    }

        .document-link:hover {
            color: #0d47a1 !important;
            text-decoration: underline;
        }

        .document-link:focus {
            outline: 2px solid #1565c0;
            outline-offset: 2px;
        }

        /* Indicador de que es clickeable */
        .document-link::after {
            content: " 🔗";
            font-size: 0.8em;
            opacity: 0.7;
        }

        .document-link:hover::after {
            opacity: 1;
        }

    /* Botón de scroll hacia arriba para móviles */
    .scroll-to-top {
        position: fixed;
        bottom: 20px;
        right: 20px;
        background: #1565c0;
        color: white;
        border: none;
        border-radius: 50%;
        width: 50px;
        height: 50px;
        font-size: 20px;
        cursor: pointer;
        opacity: 0;
        transition: opacity 0.3s, transform 0.3s;
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 12px rgba(21, 101, 192, 0.3);
    }

    .scroll-to-top.show {
        opacity: 1;
    }

    .scroll-to-top:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(21, 101, 192, 0.4);
    }

    /* Mejoras para móviles */
    @@media (max-width: 768px) {
        /* Scroll horizontal mejorado para móviles */
        .table-responsive {
            margin: 16px -16px;
            padding: 16px;
            border-radius: 0;
        }

        /* Indicador de scroll visible en móviles */
        .scroll-indicator {
            opacity: 1;
            right: 5px;
            padding: 6px 3px;
            font-size: 10px;
        }

        /* Mejoras para tablas en móvil */
        .table {
            font-size: 0.875rem;
        }

        .table td, .table th {
            padding: 0.5rem 0.25rem;
            white-space: nowrap;
        }

        /* Scroll suave para navegación móvil */
        html {
            scroll-behavior: smooth;
        }

        .scroll-to-top {
            bottom: 15px;
            right: 15px;
            width: 45px;
            height: 45px;
            font-size: 18px;
        }
    }
</style>

<script>
    var initialCoCli = '@(co_prov ?? "")';
    var initialCliDes = '@(prov_des ?? "")';
</script>

<div class="container" id="root">
    <div class="search-container">
        <h4><i class="fa fa-search"></i> Buscar Proveedor</h4>
        <div style="position:relative;">
            <div class="search-flex">
                <img src="~/Content/Zulia_log.bmp" alt="Logo" />
                <input type="text"
                       class="form-control"
                       v-model="txtBusqueda"
                       v-on:focus="limpiarBusqueda"
                       v-on:input="buscarSugerenciasDebounced"
                       v-on:keyup.enter="getBsuqueda()"
                       placeholder="Buscar Proveedor..."
                       autocomplete="off" />
            </div>
            <ul v-if="sugerencias.length > 0" class="list-group autocomplete-list">
                <li class="list-group-item autocomplete-item"
                    v-for="(s, i) in sugerencias"
                    :key="i"
                    v-on:click="seleccionarSugerencia(s)">
                    <i class="fa fa-user"></i> [[ s ]]
                </li>
            </ul>
        </div>
    </div>

    <div class="table-responsive" v-if="resultadosPaginados.length > 0">
        <table class="table table-bordered mt-3">
            <thead>
                <tr>
                    <th class="cabecera-azul-claro" v-on:click="ordenarPor('co_prov')" style="cursor:pointer;">
                        <i class="fa fa-id-card"></i> Código Proveedor
                        <span v-if="columnaOrden==='co_prov'">
                            <span v-if="ordenAscendente">&#9650;</span>
                            <span v-else>&#9660;</span>
                        </span>
                    </th>
                    <th class="cabecera-azul-claro" v-on:click="ordenarPor('prov_des')" style="cursor:pointer;">
                        <i class="fa fa-user"></i> Nombre Proveedor
                        <span v-if="columnaOrden==='prov_des'">
                            <span v-if="ordenAscendente">&#9650;</span>
                            <span v-else>&#9660;</span>
                        </span>
                    </th>
                </tr>
            </thead>
            <tbody>
                <tr v-for="(item, index) in resultadosPaginados"
                    :key="item.co_prov + '-' + index"
                    :class="{
                        'table-active': clienteSeleccionado
                            && clienteSeleccionado.co_prov === item.co_prov
                            && clienteSeleccionado.prov_des === item.prov_des,
                        'row-seleccionada': clienteSeleccionado
                            && clienteSeleccionado.co_prov === item.co_prov
                            && clienteSeleccionado.prov_des === item.prov_des
                    }"
                    style="cursor:pointer;"
                    v-on:click="seleccionarCliente(item)">
                    <td v-html="highlight(item.co_prov)"></td>
                    <td v-html="highlight(item.prov_des)"></td>
                </tr>
            </tbody>
        </table>
    </div>

    <nav v-if="totalPaginas > 1">
        <ul class="pagination justify-content-center">
            <li :class="['page-item', {disabled: paginaActual === 1}]">
                <a class="page-link" href="#" v-on:click.prevent="cambiarPagina(paginaActual - 1)">Anterior</a>
            </li>
            <li v-for="n in totalPaginas" :key="n" :class="['page-item', {active: paginaActual === n}]">
                <a class="page-link" href="#" v-on:click.prevent="cambiarPagina(n)">[[ n ]]</a>
            </li>
            <li :class="['page-item', {disabled: paginaActual === totalPaginas}]">
                <a class="page-link" href="#" v-on:click.prevent="cambiarPagina(paginaActual + 1)">Siguiente</a>
            </li>
        </ul>
    </nav>

    <div v-if="resultadosFiltrados.length === 0 && txtBusqueda" class="alert alert-info mt-3">
        <i class="fa fa-info-circle"></i> No se encontraron documentos para el proveedor.
    </div>

    <!-- RESULTADOS SELECCIONADOS MEJORADOS -->
    <div v-if="clienteSeleccionado" class="mt-4">
        @*<div class="alert alert-info" role="alert">
                <i class="fas fa-info-circle me-2"></i>
                <strong>Tip:</strong> Haz clic en el número de documento para ver los detalles completos del documento de compra.
            </div>*@
        <div class="card border-primary shadow-sm">
            <div class="card-header bg-primary text-white d-flex align-items-center" style="font-size:1.15rem;">
                <i class="fa fa-list-alt mr-2"></i>
                <span class="ml-2">Resultados para los Proveedores seleccionado</span>
            </div>
            <div class="card-body p-3" style="background:#f8fafc;">
                <div class="table-responsive">
                    <table class="table table-sm table-bordered table-hover table-striped mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>Tipo Doc</th>
                                <th>Nro Doc</th>
                                <th>Nro Prov</th>
                                <th>Fecha</th>
                                <th>Días</th>
                                @*<th>Estatus</th>*@
                                <th class="text-center">IVA 25%</th>
                                <th class="text-center">IVA 75%</th>
                                <th class="text-center">Monto Sin IVA</th>
                                <th class="text-center">IVA</th>
                                <th class="text-center">Saldo</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr v-for="(item, idx) in resultadosPorCliente" :key="item.co_prov + '-' + idx" :class="{'fila-roja': Number(item.Dias) > 40}">
                                <td class="truncate text-center" :title="item.co_tipo_doc" v-html="highlight(item.co_tipo_doc)"></td>
                                @*<td class="text-center">
                                        <a :href="'/DocumentoCP/DetalleDocumento?co_tipo_doc=' + item.co_tipo_doc + '&nro_doc=' + item.nro_doc + '&co_prov=' + item.co_prov + '&prov_des=' + encodeURIComponent(item.prov_des)"
                                           class="document-link"
                                           :title="'Ver detalles de ' + item.co_tipo_doc + ' ' + item.nro_doc"
                                           v-html="highlight(item.nro_doc)">
                                        </a>
                                    </td>*@

                                <td class="text-center">
                                    <a :href="'/DocumentoCP/DetalleDocumento?co_tipo_doc=' + encodeURIComponent(item.co_tipo_doc.trim()) + '&nro_doc=' + encodeURIComponent(item.nro_doc.trim()) + '&co_prov=' + encodeURIComponent(clienteSeleccionado.co_prov.trim()) + '&prov_des=' + encodeURIComponent(clienteSeleccionado.prov_des.trim())"
                                       class="text-decoration-none"
                                       v-html="highlight(item.nro_doc)">
                                    </a>
                                </td>

                                <td class="text-center" v-html="highlight(item.nro_fact)"></td>
                                <td class="text-center">[[ formatFecha(item.fec_emis) ]]</td>
                                <td class="text-center" v-html="highlight(item.Dias)"></td>
                                @*<td class="text-center" v-html="highlight(item.estado_retencion)"></td>*@
                                <td class="text-end">[[ formatNumero(item.IVA25) ]]</td>
                                @*<td class="text-end">[[ formatNumero(item.Ret75) ]]</td>*@
                                <td class="text-end" v-html="highlight(item.estado_retencion)"></td>
                                <td class="text-end">[[ formatNumero(item.monto_bru) ]]</td>
                                <td class="text-end">[[ formatNumero(item.monto_imp) ]]</td>
                                <td class="text-end">[[ formatNumero(item.saldo) ]]</td>
                            </tr>
                        </tbody>
                        <tfoot v-if="resultadosPorCliente.length > 1">
                            <tr style="font-weight:bold; background:#e3f2fd;">
                                <td colspan="5" class="text-right">Totales:</td>
                                <td class="text-end">[[ sumaCol('IVA25') ]]</td>
                                <td class="text-end">[[ sumaCol('estado_retencion') ]]</td>
                                <td class="text-end">[[ sumaCol('monto_bru') ]]</td>
                                <td class="text-end">[[ sumaCol('monto_imp') ]]</td>
                                <td class="text-end">[[ sumaCol('saldo') ]]</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <!-- FIN RESULTADOS SELECCIONADOS MEJORADOS -->
</div>

<!-- Botón de scroll hacia arriba -->
<button class="scroll-to-top" id="scrollToTop" title="Ir arriba">
    <i class="fa fa-arrow-up"></i>
</button>

<!-- Indicador de scroll -->
<div class="scroll-indicator" id="scrollIndicator">
    <i class="fa fa-chevron-up"></i><br>
    <i class="fa fa-chevron-down"></i>
</div>

@section scripts{
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/vue@2/dist/vue.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.9.0/axios.min.js"></script>

    <script>
        function debounce(func, wait) {
            let timeout;
            return function (...args) {
                clearTimeout(timeout);
                timeout = setTimeout(() => func.apply(this, args), wait);
            };
        }

        var app = new Vue({
            el: "#root",
            delimiters: ['[[', ']]'],
            data: {
                txtBusqueda: '',
                sugerencias: [],
                todosResultados: [],
                resultadosFiltrados: [],
                clienteSeleccionado: null,
                resultadosPorCliente: [],
                paginaActual: 1,
                resultadosPorPagina: 10,
                columnaOrden: '',
                ordenAscendente: true
            },
            computed: {
                resultadosPaginados() {
                    const inicio = (this.paginaActual - 1) * this.resultadosPorPagina;
                    return this.resultadosFiltrados.slice(inicio, inicio + this.resultadosPorPagina);
                },
                totalPaginas() {
                    return Math.ceil(this.resultadosFiltrados.length / this.resultadosPorPagina);
                }
            },
            methods: {
                getBsuqueda() {
                    if (this.txtBusqueda.trim() !== '') {
                        let cadena = this.txtBusqueda.trim();
                        let cantidad = 1000;

                        axios.get('/DocumentoCP/buscarPorDocumCP', {
                            params: {
                                nombre: cadena,
                                cantidad: cantidad
                            }
                        })
                            .then((response) => {
                                this.todosResultados = response.data.datos || [];
                                const seen = {};
                                this.resultadosFiltrados = this.todosResultados.filter(item => {
                                    // Agregar validaciones para evitar errores null
                                    const coProv = item.co_prov || '';
                                    const provDes = item.prov_des || '';
                                    const key = coProv + '|' + provDes;
                                    if (seen[key]) return false;
                                    seen[key] = true;
                                    return true;
                                });
                                this.clienteSeleccionado = null;
                                this.resultadosPorCliente = [];
                                this.paginaActual = 1;
                                this.sugerencias = [];
                                // Selección automática si hay parámetros iniciales
                                if (initialCoCli && initialCliDes) {
                                    const cliente = this.todosResultados.find(x => {
                                        const xCoProv = x.co_prov || '';
                                        const xProvDes = x.prov_des || '';
                                        return xCoProv === initialCoCli && xProvDes === initialCliDes;
                                    });
                                    if (cliente) {
                                        this.seleccionarCliente(cliente);
                                    }
                                }
                            })
                            .catch(() => {
                                this.todosResultados = [];
                                this.resultadosFiltrados = [];
                                this.clienteSeleccionado = null;
                                this.resultadosPorCliente = [];
                                this.paginaActual = 1;
                                this.sugerencias = [];
                            });
                    } else {
                        this.todosResultados = [];
                        this.resultadosFiltrados = [];
                        this.clienteSeleccionado = null;
                        this.resultadosPorCliente = [];
                        this.paginaActual = 1;
                        this.sugerencias = [];
                    }
                },
                buscarSugerencias() {
                    if (this.txtBusqueda.length < 2) {
                        this.sugerencias = [];
                        return;
                    }
                    const texto = this.txtBusqueda.toLowerCase();
                    const sugerenciasSet = new Set();
                    this.todosResultados.forEach(item => {
                        // Agregar validaciones para evitar errores null
                        const provDes = item.prov_des || '';
                        const coProv = item.co_prov || '';

                        if (provDes && provDes.toLowerCase().includes(texto)) {
                            sugerenciasSet.add(provDes);
                        }
                        if (coProv && coProv.toLowerCase().includes(texto)) {
                            sugerenciasSet.add(coProv);
                        }
                    });
                    this.sugerencias = Array.from(sugerenciasSet).slice(0, 10);
                },
                seleccionarSugerencia(s) {
                    this.txtBusqueda = s;
                    this.sugerencias = [];
                    this.getBsuqueda();
                },
                seleccionarCliente(item) {
                    this.clienteSeleccionado = item;
                    this.resultadosPorCliente = this.todosResultados.filter(x => {
                        // Agregar validaciones para evitar errores null
                        const xCoProv = x.co_prov || '';
                        const xProvDes = x.prov_des || '';
                        const itemCoProv = item.co_prov || '';
                        const itemProvDes = item.prov_des || '';

                        return xCoProv === itemCoProv && xProvDes === itemProvDes;
                    });

                    // Dejar solo el cliente seleccionado en los resultados filtrados
                    this.resultadosFiltrados = [item];
                    this.paginaActual = 1;
                },
                cambiarPagina(pagina) {
                    if (pagina > 0 && pagina <= this.totalPaginas) {
                        this.paginaActual = pagina;
                    }
                },
                ordenarPor(columna) {
                    if (this.columnaOrden === columna) {
                        this.ordenAscendente = !this.ordenAscendente;
                    } else {
                        this.columnaOrden = columna;
                        this.ordenAscendente = true;
                    }
                    this.resultadosFiltrados.sort((a, b) => {
                        if (a[columna] < b[columna]) return this.ordenAscendente ? -1 : 1;
                        if (a[columna] > b[columna]) return this.ordenAscendente ? 1 : -1;
                        return 0;
                    });
                    this.paginaActual = 1;
                },
                formatNumero(valor) {
                    if (valor == null || valor === '' || Number(valor) === 0) return '';
                    return Number(valor).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                },


                formatFecha(valor) {
                    if (!valor) return '';
                    let fecha;

                    // Si es formato /Date(1234567890)/
                    if (typeof valor === 'string' && valor.match(/\/Date\((\d+)\)\//)) {
                        const ms = parseInt(valor.match(/\/Date\((\d+)\)\//)[1], 10);
                        fecha = new Date(ms);
                    } else if (typeof valor === 'string' && valor.length === 10 && valor.match(/^\d{4}-\d{2}-\d{2}$/)) {
                        // Si es formato YYYY-MM-DD, parsear manualmente como local
                        const [anio, mes, dia] = valor.split('-');
                        fecha = new Date(Number(anio), Number(mes) - 1, Number(dia));
                    } else {
                        fecha = new Date(valor);
                    }

                    if (isNaN(fecha)) return valor;

                    const dia = ('0' + fecha.getDate()).slice(-2);
                    const mes = ('0' + (fecha.getMonth() + 1)).slice(-2);
                    const anio = fecha.getFullYear();
                    return `${dia}/${mes}/${anio}`;


                },
                limpiarBusqueda() {
                    this.txtBusqueda = '';
                    this.sugerencias = [];
                    this.resultadosFiltrados = [];
                    this.clienteSeleccionado = null;
                    this.resultadosPorCliente = [];
                    this.paginaActual = 1;
                },
                sumaCol(campo) {
                    return this.resultadosPorCliente.reduce((acc, item) => {
                        let val = Number(item[campo]);
                        return acc + (isNaN(val) ? 0 : val);
                    }, 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                },
                highlight(text) {
                    if (!this.txtBusqueda) return text;
                    // Agregar validación para evitar errores null
                    if (text == null || text === undefined) return '';

                    const regex = new RegExp(`(${this.txtBusqueda})`, 'gi');
                    return text.toString().replace(regex, '<span class="highlight">$1</span>');
                },

                setupMobileScroll() {
                    const scrollToTopBtn = document.getElementById('scrollToTop');
                    const scrollIndicator = document.getElementById('scrollIndicator');
                    let scrollTimeout;

                    // Mostrar/ocultar botón de scroll hacia arriba
                    window.addEventListener('scroll', () => {
                        if (window.pageYOffset > 300) {
                            scrollToTopBtn.classList.add('show');
                        } else {
                            scrollToTopBtn.classList.remove('show');
                        }

                        // Mostrar indicador de scroll
                        clearTimeout(scrollTimeout);
                        scrollIndicator.classList.add('show');
                        
                        scrollTimeout = setTimeout(() => {
                            scrollIndicator.classList.remove('show');
                        }, 2000);
                    });

                    // Scroll hacia arriba
                    scrollToTopBtn.addEventListener('click', () => {
                        window.scrollTo({
                            top: 0,
                            behavior: 'smooth'
                        });
                    });

                    // Scroll horizontal para tablas en móvil
                    const tables = document.querySelectorAll('.table-responsive');
                    tables.forEach(table => {
                        let isScrolling = false;
                        let startX, startScrollLeft;

                        table.addEventListener('touchstart', (e) => {
                            isScrolling = true;
                            startX = e.touches[0].pageX - table.offsetLeft;
                            startScrollLeft = table.scrollLeft;
                        });

                        table.addEventListener('touchmove', (e) => {
                            if (!isScrolling) return;
                            e.preventDefault();
                            const x = e.touches[0].pageX - table.offsetLeft;
                            const walk = (x - startX) * 2;
                            table.scrollLeft = startScrollLeft - walk;
                        });

                        table.addEventListener('touchend', () => {
                            isScrolling = false;
                        });
                    });
                }
            },

            created() {
                this.buscarSugerenciasDebounced = debounce(this.buscarSugerencias, 300);
                // Si hay parámetros iniciales, realiza la búsqueda y selecciona el cliente automáticamente
                if (initialCoCli && initialCliDes) {
                    this.txtBusqueda = initialCliDes;
                    this.getBsuqueda();
                }
            },

            mounted() {
                // Configurar funcionalidad de scroll para móviles
                this.setupMobileScroll();
            }
        });
    </script>
}