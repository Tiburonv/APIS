@{
    ViewBag.Title = "Detalle del Pedido";
    var doc_num = ViewBag.doc_num as string;
}

<div class="container mt-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-2">
        <h2 class="mb-2 mb-md-0">Pedido #@doc_num</h2>
                <div class="d-flex gap-2">
             <button type="button" class="btn btn-outline-primary" onclick="volverAPedidos()">
                 <i class="fas fa-arrow-left me-1"></i> Volver a Pedidos
             </button>
         </div>
    </div>

    <!-- Informacion del Cliente -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Informacion del Cliente</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-12 col-md-6">
                    <p><strong>Nombre:</strong> <span id="cli_des">Cargando...</span></p>
                    <p><strong>Codigo de Cliente:</strong> <span id="co_cli">Cargando...</span></p>
                    <p><strong>Codigo del Vendedor:</strong> <span id="co_ven">Cargando...</span></p>
                </div>
                <div class="col-12 col-md-6">
                    <p><strong>Fecha de Emision:</strong> <span id="fec_emis">Cargando...</span></p>
                    <p>
                        <strong>Tasa:</strong>
                        <span class="badge bg-info text-dark" id="tasa">0.00</span>
                    </p>
                    @*<p>
                        <strong>Total Neto:</strong>
                        <span class="badge bg-success text-dark" id="totalNeto">0.00</span>
                    </p>*@
                </div>
            </div>
        </div>
    </div>

    <!-- Renglones del Pedido -->
    <div class="card">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Renglones del Pedido</h5>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-light text-dark">Total Renglones: <span id="totalRenglones">0</span></span>
                <button id="toggleCurrency" class="btn btn-sm btn-light">
                    <i class="fas fa-exchange-alt me-1"></i> Mostrar en Bs
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0" id="tablaRenglones">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Codigo</th>
                            <th>Descripcion</th>
                            <th class="text-end">Cantidad</th>
                            <!-- Headers for USD -->
                            <th class="text-end bs-currency">Precio Unit. ($)</th>
                            <th class="text-end bs-currency">IVA ($)</th>
                            <th class="text-end bs-currency">Total ($)</th>
                            <!-- Headers for Bs -->
                            <th class="text-end usd-currency">Precio Unit. (Bs.)</th>
                            <th class="text-end usd-currency">IVA (Bs.)</th>
                            <th class="text-end usd-currency">Total (Bs.)</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyRenglones">
                        <!-- Los renglones se cargaran dinamicamente aqui -->
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                           <td colspan="6" class="text-end fw-bold">Subtotal:</td>
                           <td class="text-end fw-bold bs-currency" id="subtotalNetoUSD">0.00</td>
                           <td class="text-end fw-bold usd-currency" id="subtotalNeto">0.00</td>


                        </tr>
                        <tr>
                            <td colspan="6" class="text-end fw-bold">IVA 16%:</td>
                            <td class="text-end fw-bold bs-currency" id="totalIvaUSD">0.00</td>
                            <td class="text-end fw-bold usd-currency" id="totalIva">0.00</td>
                          
                        </tr>
                        <tr class="table-active">
                            <td colspan="6" class="text-end fw-bold">Total Neto (Subtotal + IVA):</td>
                            <td class="text-end fw-bold bs-currency" id="totalNetoFinalUSD">0.00</td>
                            <td class="text-end fw-bold usd-currency" id="totalNeto">0.00</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.9.0/axios.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

    <script>
        // Funcion para formatear numeros con separadores de miles
        function formatearNumero(numero, decimales = 2) {
            if (isNaN(numero) || numero === null || numero === undefined) {
                return '0.00';
            }
            
            const numeroFormateado = parseFloat(numero).toFixed(decimales);
            const partes = numeroFormateado.split('.');
            const parteEntera = partes[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
            
            return partes.length > 1 ? parteEntera + '.' + partes[1] : parteEntera;
        }

        $(document).ready(function() {
            cargarDetallePedido();
        });

        // Variables para almacenar los parámetros del cliente
        let clienteCodigo = '';
        let clienteDescripcion = '';

        function cargarDetallePedido() {
            const docNum = '@doc_num';
            
            console.log('=== INICIO DE CARGA DEL PEDIDO ===');
            console.log('Iniciando carga del pedido:', docNum);
            console.log('ViewBag.doc_num:', '@doc_num');
            console.log('URL actual:', window.location.href);
            console.log('Parametros de la URL:', new URLSearchParams(window.location.search));

            if (!docNum || docNum === 'undefined' || docNum === 'null') {
                console.error('No se proporciono numero de pedido valido:', docNum);
                mostrarError('No se proporciono un numero de pedido valido. Por favor, regrese a la lista de pedidos.');
                return;
            }

            $('#tbodyRenglones').html('<tr><td colspan="7" class="text-center"><i class="fas fa-spinner fa-spin"></i> Cargando renglones...</td></tr>');

            console.log('Realizando peticion a /Pedidos/buscarRengPedidos con doc_num:', docNum);

            axios.post('/Pedidos/buscarRengPedidos', null, {
                params: { doc_num: docNum }
            })
            .then(function(response) {
                console.log('Respuesta completa recibida:', response);
                console.log('Datos de la respuesta:', response.data);
                
                if (response.data.success) {
                    const renglones = response.data.datos || [];
                    console.log('Renglones encontrados:', renglones);
                    
                    if (renglones.length === 0) {
                        console.warn('No se encontraron renglones para el pedido');
                        mostrarError('No se encontraron renglones para este pedido');
                        return;
                    }

                    mostrarRenglones(renglones);
                    actualizarInformacionCliente(renglones);

                    console.log('=== CARGA DEL PEDIDO COMPLETADA ===');
                } else {
                    console.error('Error en la respuesta:', response.data.mensaje);
                    mostrarError(response.data.mensaje || 'No se pudieron cargar los renglones del pedido');
                }
            })
            .catch(function(error) {
                console.error('Error completo al cargar el pedido:', error);
                console.error('Respuesta del servidor:', error.response);
                console.error('Estado de la respuesta:', error.response?.status);
                console.error('Datos de la respuesta:', error.response?.data);
                
                let mensajeError = 'Error al cargar el pedido. ';
                if (error.response?.status === 404) {
                    mensajeError += 'El pedido no fue encontrado.';
                } else if (error.response?.status === 500) {
                    mensajeError += 'Error interno del servidor.';
                } else if (error.code === 'ECONNABORTED') {
                    mensajeError += 'La peticion tardo demasiado.';
                } else {
                    mensajeError += 'Por favor, intente de nuevo.';
                }
                
                mostrarError(mensajeError);
            });
        }

        function mostrarRenglones(renglones) {
            console.log('Mostrando renglones:', renglones);
            
            if (renglones.length === 0) {
                $('#tbodyRenglones').html('<tr><td colspan="10" class="text-center text-muted">No se encontraron renglones para este pedido</td></tr>');
                return;
            }

            let html = '';
            let subtotalIva = 0;
            let subtotalNeto = 0;
            let tasa = parseFloat(renglones[0].tasa) || 1;

            renglones.forEach(function(reng, index) {
                console.log(`Procesando renglon ${index + 1}:`, reng);
                
                const cantidad = parseFloat(reng.total_art) || 0;
                const precio = parseFloat(reng.prec_vta) || 0;
                const iva = parseFloat(reng.monto_imp) || 0;
                const neto = parseFloat(reng.reng_neto) || 0;

                // Calcular valores en USD
                const precioUSD = precio / tasa;
                const ivaUSD = iva / tasa;
                const netoUSD = neto / tasa;

                subtotalIva += iva;
                subtotalNeto += neto;

                html += `
                    <tr>
                        <td>${index + 1}</td>
                        <td><code>${reng.co_art || ''}</code></td>
                        <td>${reng.art_des || ''}</td>
                        <td class="text-end">${formatearNumero(cantidad, 3)}</td>
                        <!-- Valores en USD -->
                        <td class="text-end bs-currency">$${formatearNumero(precioUSD)}</td>
                        <td class="text-end bs-currency">$${formatearNumero(ivaUSD)}</td>
                        <td class="text-end bs-currency">$${formatearNumero(netoUSD)}</td>
                        <!-- Valores en Bs -->
                        <td class="text-end usd-currency">${formatearNumero(precio)}</td>
                        <td class="text-end usd-currency">${formatearNumero(iva)}</td>
                        <td class="text-end usd-currency">${formatearNumero(neto)}</td>
                    </tr>
                `;
            });

            $('#tbodyRenglones').html(html);
            $('#totalRenglones').text(renglones.length);
            
            // Actualizar totales en ambas monedas
            $('#subtotalNetoUSD').text('$' + formatearNumero(subtotalNeto / tasa));
            $('#subtotalIvaUSD').text('$' + formatearNumero(subtotalIva / tasa));
            $('#subtotalIva').text(formatearNumero(subtotalIva));
            $('#subtotalNeto').text(formatearNumero(subtotalNeto));
            $('#totalIvaUSD').text('$' + formatearNumero(subtotalIva / tasa));
            $('#totalIva').text(formatearNumero(subtotalIva));
            
            // Calcular total neto como subtotal neto + total IVA
            const totalNeto = subtotalNeto + subtotalIva;
            const totalNetoUSD = (subtotalNeto + subtotalIva) / tasa;
            
            $('#totalNetoFinalUSD').text('$' + formatearNumero(totalNetoUSD));
            $('#totalNeto').text(formatearNumero(totalNeto));
            
            console.log('Renglones mostrados correctamente. Totales:', {
                totalRenglones: renglones.length,
                subtotalIva: formatearNumero(subtotalIva),
                subtotalNeto: formatearNumero(subtotalNeto),
                tasa: formatearNumero(tasa)
            });
        }

        function actualizarInformacionCliente(renglones) {
            if (renglones.length > 0) {
                const primerReng = renglones[0];
                
                console.log('Actualizando informacion del cliente con:', primerReng);
                
                // Actualizar informacion del cliente
                $('#co_cli').text(primerReng.co_cli || 'N/A');
                $('#cli_des').text(primerReng.cli_des || 'N/A');
                $('#co_ven').text(primerReng.co_ven || 'N/A');
                
                // Almacenar los datos del cliente para el regreso
                clienteCodigo = primerReng.co_cli || '';
                clienteDescripcion = primerReng.cli_des || '';
                
                // Formatear fecha de emision
                let fechaEmision = 'N/A';
                if (primerReng.fec_emis) {
                    try {
                        let fecha;
                        // Si es formato /Date(1234567890)/
                        if (typeof primerReng.fec_emis === 'string' && primerReng.fec_emis.match(/\/Date\((\d+)\)\//)) {
                            const ms = parseInt(primerReng.fec_emis.match(/\/Date\((\d+)\)\//)[1], 10);
                            fecha = new Date(ms);
                        } else if (typeof primerReng.fec_emis === 'string' && primerReng.fec_emis.length === 10 && primerReng.fec_emis.match(/^\d{4}-\d{2}-\d{2}$/)) {
                            // Si es formato YYYY-MM-DD
                            const [anio, mes, dia] = primerReng.fec_emis.split('-');
                            fecha = new Date(Number(anio), Number(mes) - 1, Number(dia));
                        } else {
                            fecha = new Date(primerReng.fec_emis);
                        }
                        
                        if (!isNaN(fecha)) {
                            fechaEmision = fecha.toLocaleDateString('es-ES');
                        }
                    } catch (e) {
                        console.warn('Error al formatear fecha:', e);
                        fechaEmision = primerReng.fec_emis || 'N/A';
                    }
                }
                
                $('#fec_emis').text(fechaEmision);
                
                // Actualizar tasa
                $('#tasa').text(formatearNumero(primerReng.tasa || 0,5));
                
                // Calcular total neto (subtotal neto + total IVA)
                const subtotalNeto = renglones.reduce((sum, reng) => sum + (parseFloat(reng.reng_neto) || 0), 0);
                const totalIva = renglones.reduce((sum, reng) => sum + (parseFloat(reng.monto_imp) || 0), 0);
                const totalNeto = subtotalNeto + totalIva;
                $('#totalNeto').text(formatearNumero(totalNeto));
                
                console.log('Informacion del cliente actualizada:', {
                    co_cli: primerReng.co_cli,
                    cli_des: primerReng.cli_des,
                    co_ven: primerReng.co_ven,
                    fec_emis: fechaEmision,
                    tasa: formatearNumero(primerReng.tasa),
                    totalNeto: formatearNumero(totalNeto)
                });
            } else {
                console.warn('No hay renglones para actualizar la informacion del cliente');
            }
        }

        function mostrarError(mensaje) {
            $('#tbodyRenglones').html(`
                <tr>
                    <td colspan="10" class="text-center text-danger">
                        <i class="fas fa-exclamation-triangle"></i> ${mensaje}
                    </td>
                </tr>
            `);
        }

        // Función para regresar a la página de pedidos con filtros aplicados
        function volverAPedidos() {
            // Intentar obtener los parámetros del cliente desde la URL actual
            const urlParams = new URLSearchParams(window.location.search);
            let co_cli = urlParams.get('co_cli');
            let cli_des = urlParams.get('cli_des');
            
            // Si no hay parámetros en la URL, usar los datos almacenados del cliente
            if (!co_cli && !cli_des) {
                co_cli = clienteCodigo;
                cli_des = clienteDescripcion;
            }
            
            // Construir la URL de regreso
            let urlRegreso = '/Pedidos/Ped';
            if (co_cli && cli_des) {
                urlRegreso += `?co_cli=${encodeURIComponent(co_cli)}&cli_des=${encodeURIComponent(cli_des)}`;
            }
            
            // Redirigir a la página de pedidos
            window.location.href = urlRegreso;
        }

        // Toggle entre monedas
        $(document).ready(function() {
            const toggleBtn = document.getElementById('toggleCurrency');
            const table = document.getElementById('tablaRenglones');
            
            if (toggleBtn && table) {
                toggleBtn.addEventListener('click', function() {
                    table.classList.toggle('show-usd');
                    
                    if (table.classList.contains('show-usd')) {
                        toggleBtn.innerHTML = '<i class="fas fa-exchange-alt me-1"></i> Mostrar en Bs';
                    } else {
                        toggleBtn.innerHTML = '<i class="fas fa-exchange-alt me-1"></i> Mostrar en USD';
                    }
                });
            }
        });
    </script>
}

<style>
    .table th {
        font-weight: 600;
        white-space: nowrap;
    }

    .table td {
        vertical-align: middle;
    }

    .card {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        margin-bottom: 1.5rem;
    }

    .card-header {
        font-weight: 600;
    }

    .badge {
        font-size: 0.875em;
    }

    /* Responsive para moviles */
    @@media (max-width: 768px) {
        .table-responsive {
            font-size: 0.875rem;
        }

        .card-body {
            padding: 1rem;
        }

        .btn {
            font-size: 0.875rem;
            padding: 0.5rem 0.75rem;
        }
    }

    /* Estilos para los botones de navegacion */
    .btn-outline-secondary:hover {
        background-color: #6c757d;
        border-color: #6c757d;
        color: white;
    }

    .btn-outline-primary:hover {
        background-color: #0056b3;
        border-color: #0056b3;
    }

    .btn-primary:hover {
        background-color: #0056b3;
        border-color: #0056b3;
    }

    /* Estilos para el tfoot */
    .table tfoot tr {
        border-top: 2px solid #dee2e6;
    }

    .table tfoot tr:last-child {
        border-bottom: 2px solid #dee2e6;
    }

    .table-active {
        background-color: #e3f2fd !important;
        font-weight: bold;
    }

    .fw-bold {
        font-weight: bold !important;
    }

    /* Estilos para el toggle de moneda */
    .usd-currency {
        display: none;
    }
    
    .bs-currency {
        display: table-cell;
    }
    
    .show-usd .usd-currency {
        display: table-cell;
    }
    
    .show-usd .bs-currency {
        display: none;
    }
</style>

