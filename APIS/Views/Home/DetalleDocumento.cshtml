@model APIS.Models.DetalleDocumentoViewModel
@{
    ViewBag.Title = "Detalle de Documento";
}

<div class="container mt-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-2">
        <h2 class="mb-2 mb-md-0">@Model.Documento.co_tipo_doc-@Model.Documento.nro_doc</h2>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Index", "Home", new {
                   co_cli = Model.Cliente.co_cli != null ? Model.Cliente.co_cli.Trim() : null,
                   cli_des = Model.Cliente.cli_des != null ? Model.Cliente.cli_des.Trim() : null
               })" class="btn btn-outline-primary">
                <i class="fas fa-arrow-left me-1"></i> Volver a Resultados
            </a>
        </div>
    </div>

    <!-- Información del Cliente -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Informacion del Cliente</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-12 col-md-6">
                    <p><strong>Nombre:</strong> @Model.Cliente.cli_des</p>
                    <p><strong>Codigo de Cliente:</strong> @Model.Cliente.co_cli</p>
                    <p><strong>Vendedor:</strong> @Model.Documento.co_ven</p>
                </div>
                <div class="col-12 col-md-6">
                    <p><strong>Fecha de Emision:</strong> @Model.Documento.fec_emis.ToString("dd/MM/yyyy")</p>
                    <p>
                        <strong>Dias:</strong>
                        <span class="badge @(Model.Documento.Dias > 40 ? "bg-danger" : "bg-success")">
                            @Model.Documento.Dias dias
                        </span>
                    </p>
                    <p>
                        <strong>Tasa BCV:</strong>
                        <span class="badge bg-info text-dark">
                            @Model.Cliente.tasa.ToString("N5")
                        </span>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Renglones del Documento -->
    <div class="card">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Renglones del Documento</h5>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-light text-dark">Total Renglones: @Model.Renglones.Count</span>
                <button id="toggleCurrency" class="btn btn-sm btn-light">
                    <i class="fas fa-exchange-alt me-1"></i> Mostrar en USD
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0" id="tablaRenglones">
                    <thead class="table-light">
                        <tr>
                            <th>Codigo</th>
                            <th>Descripcion</th>
                            <th class="text-end">Cantidad</th>
                            <!-- Headers for USD -->
                            <th class="text-end usd-currency">Precio Unit. ($)</th>
                            <th class="text-end usd-currency">IVA ($)</th>
                            <th class="text-end usd-currency">Total ($)</th>
                            <!-- Headers for Bs -->
                            <th class="text-end bs-currency">Precio Unit. (Bs.)</th>
                            <th class="text-end bs-currency">IVA (Bs.)</th>
                            <th class="text-end bs-currency">Total (Bs.)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var renglon in Model.Renglones)
                        {
                            <tr>
                                <td>@renglon.co_art</td>
                                <td>@renglon.art_des</td>
                                <td class="text-end">@renglon.total_art.ToString("N3")</td>
                                <!-- Precio Unitario -->
                                <td class="text-end usd-currency">@((renglon.prec_vta / Model.Cliente.tasa).ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US")))</td>
                                <!-- IVA -->
                                <td class="text-end usd-currency">@((renglon.monto_imp / Model.Cliente.tasa).ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US")))</td>
                                <!-- Total -->
                                <td class="text-end usd-currency">@((renglon.reng_neto / Model.Cliente.tasa).ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US")))</td>
                                <!-- Precio Unitario en Bs -->
                                <td class="text-end bs-currency">@renglon.prec_vta.ToString("N2") Bs</td>
                                <!-- IVA en Bs -->
                                <td class="text-end bs-currency">@renglon.monto_imp.ToString("N2") Bs</td>
                                <!-- Total en Bs -->
                                <td class="text-end bs-currency">@renglon.reng_neto.ToString("N2") Bs</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="5" class="text-end fw-bold">Subtotal :</td>
                            <td class="text-end fw-bold usd-currency">@((Model.Documento.monto_bru).ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US")))</td>
                            <td class="text-end fw-bold bs-currency">@Model.SumaRengNeto.ToString("N2") Bs</td>
                        </tr>
                        <tr>
                            <td colspan="5" class="text-end fw-bold">IVA 16%:</td>
                            <td class="text-end fw-bold usd-currency">@((Model.Documento.monto_imp).ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US")))</td>
                            <td class="text-end fw-bold bs-currency">@Model.SumaMontoImp.ToString("N2") Bs</td>
                        </tr>
                        <tr class="table-active">
                            <td colspan="5" class="text-end fw-bold">Total Neto:</td>
                            <td class="text-end fw-bold usd-currency">@((Model.Documento.monto_net).ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US")))</td>
                            <td class="text-end fw-bold bs-currency">@((Model.SumaRengNeto+Model.SumaMontoImp).ToString("N2")) Bs</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
    <script>
        // Toggle entre monedas
        document.addEventListener('DOMContentLoaded', function() {
            const toggleBtn = document.getElementById('toggleCurrency');
            const table = document.getElementById('tablaRenglones');
            
            toggleBtn.addEventListener('click', function() {
                table.classList.toggle('show-usd');
                
                if (table.classList.contains('show-usd')) {
                    toggleBtn.innerHTML = '<i class="fas fa-exchange-alt me-1"></i> Mostrar en Bs';
                } else {
                    toggleBtn.innerHTML = '<i class="fas fa-exchange-alt me-1"></i> Mostrar en USD';
                }
            });
        });
        
        function exportarAPDF() {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF();

            // Título del documento
            doc.setFontSize(18);
            doc.text('Detalle de Documento: @Model.Documento.co_tipo_doc-@Model.Documento.nro_doc', 14, 22);

            // Información del cliente
            doc.setFontSize(11);
            doc.text('Cliente: @Model.Cliente.cli_des', 14, 32);
            doc.text('Código: @Model.Cliente.co_cli', 14, 37);
            doc.text('Fecha Emisión: @Model.Documento.fec_emis.ToString("dd/MM/yyyy")', 14, 42);

            // Tabla de renglones
            const columns = [
                { header: 'Codigo', dataKey: 'codigo' },
                { header: 'Descripcion', dataKey: 'descripcion' },
                { header: 'Cantidad', dataKey: 'cantidad' },
                { header: 'Precio Unit.', dataKey: 'precio' },
                { header: 'Total', dataKey: 'total' }
            ];

            const rows = [];
            @foreach (var renglon in Model.Renglones)
            {
                <text>
                rows.push({
                    codigo: '@renglon.co_art',
                    descripcion: '@renglon.art_des',
                    cantidad: '@renglon.total_art?.ToString("N2")',
                    precio: '@renglon.prec_vta?.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))',
                    total: '@renglon.reng_neto?.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))'
                });
                </text>
            }

            doc.autoTable({
                head: [columns.map(col => col.header)],
                body: rows.map(row => columns.map(col => row[col.dataKey])),
                startY: 60,
                styles: { fontSize: 8 },
                headStyles: { fillColor: [21, 101, 192] }
            });

            // Guardar el PDF
            doc.save('Detalle_Documento_@(Model.Documento.co_tipo_doc)_@(Model.Documento.nro_doc).pdf');
        }
    </script>
}

<style>
    .table th {
        font-weight: 600;
        white-space: nowrap;
    }

    .table td {
        vertical-align: middle;
    }

    .card {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        margin-bottom: 1.5rem;
    }

    .card-header {
        font-weight: 600;
    }

    .badge {
        font-size: 0.875em;
    }

    /* Responsive para móviles */
    @@media (max-width: 768px) {
        .table-responsive {
            font-size: 0.875rem;
        }

        .card-body {
            padding: 1rem;
        }

        .btn {
            font-size: 0.875rem;
            padding: 0.5rem 0.75rem;
        }
    }

    /* Estilos para los botones de navegación */
    .btn-outline-secondary:hover {
        background-color: #6c757d;
        border-color: #6c757d;
        color: white;
    }

    .btn-outline-info:hover {
        background-color: #17a2b8;
        border-color: #17a2b8;
        color: white;
    }

    .btn-primary:hover {
        background-color: #0056b3;
        border-color: #0056b3;
    }
    
    /* Estilos para el toggle de moneda */
    .usd-currency {
        display: none;
    }
    
    .bs-currency {
        display: table-cell;
    }
    
    .show-usd .usd-currency {
        display: table-cell;
    }
    
    .show-usd .bs-currency {
        display: none;
    }
</style>