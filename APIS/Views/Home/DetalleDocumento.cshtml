@model APIS.Models.DetalleDocumentoViewModel
@{
    ViewBag.Title = "Detalle de Documento";
    var tasaCambio = Model.Cliente.tasa > 0 ? Model.Cliente.tasa : 1;
    var usCulture = System.Globalization.CultureInfo.GetCultureInfo("en-US");
}

<style>
    .detalle-doc {
        --brand: #1565c0;
    }

    .detalle-doc .detalle-sticky {
        position: sticky;
        top: 0;
        z-index: 20;
        background: linear-gradient(180deg, #f4f6fb 70%, rgba(244, 246, 251, 0));
        padding: 12px 0 16px;
        margin-bottom: 8px;
    }

    .detalle-doc .table td,
    .detalle-doc .table th {
        font-variant-numeric: tabular-nums;
        vertical-align: middle;
    }

    .detalle-doc .card {
        box-shadow: 0 2px 12px rgba(21, 101, 192, 0.1);
        border-radius: 10px;
        margin-bottom: 1.25rem;
        border: 1px solid #e2e8f0;
    }

    .detalle-doc .card-header {
        font-weight: 600;
        background: var(--brand) !important;
    }

    .detalle-doc .totales-bar {
        position: sticky;
        bottom: 0;
        z-index: 15;
        background: #fff;
        border-top: 1px solid #e2e8f0;
        box-shadow: 0 -4px 16px rgba(15, 23, 42, 0.08);
        padding: 12px 16px;
        border-radius: 10px 10px 0 0;
        margin-top: 12px;
    }

    .detalle-doc .totales-bar .valor {
        font-weight: 700;
        color: #0d47a1;
        font-variant-numeric: tabular-nums;
    }

    .usd-currency { display: none; }
    .bs-currency { display: table-cell; }
    .show-usd .usd-currency { display: table-cell; }
    .show-usd .bs-currency { display: none; }

    @@media (max-width: 768px) {
        .detalle-doc .table-responsive { font-size: 0.875rem; }
        .detalle-doc .totales-bar { font-size: 0.9rem; }
    }
</style>

<div class="container mt-3 detalle-doc">
    <div class="detalle-sticky">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
            <div>
                <h2 class="mb-1 h3">@Model.Documento.co_tipo_doc-@Model.Documento.nro_doc</h2>
                <div class="text-muted small">@Model.Cliente.cli_des · @Model.Cliente.co_cli</div>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <button id="toggleCurrency" class="btn btn-sm btn-outline-primary" type="button">
                    <i class="fas fa-exchange-alt me-1"></i> Mostrar en USD
                </button>
                <a href="@Url.Action("Index", "Home", new {
                       co_cli = Model.Cliente.co_cli != null ? Model.Cliente.co_cli.Trim() : null,
                       cli_des = Model.Cliente.cli_des != null ? Model.Cliente.cli_des.Trim() : null
                   })" class="btn btn-sm btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i> Volver
                </a>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header text-white">
            <h5 class="mb-0">Información del Cliente</h5>
        </div>
        <div class="card-body">
            <div class="row g-2">
                <div class="col-12 col-md-6">
                    <p class="mb-1"><strong>Nombre:</strong> @Model.Cliente.cli_des</p>
                    <p class="mb-1"><strong>Código:</strong> @Model.Cliente.co_cli</p>
                    <p class="mb-0"><strong>Vendedor:</strong> @Model.Documento.co_ven</p>
                </div>
                <div class="col-12 col-md-6">
                    <p class="mb-1"><strong>Fecha de emisión:</strong> @Model.Documento.fec_emis.ToString("dd/MM/yyyy")</p>
                    <p class="mb-1">
                        <strong>Días:</strong>
                        <span class="badge @(Model.Documento.Dias > 40 ? "bg-danger" : "bg-success")">
                            @Model.Documento.Dias días
                        </span>
                    </p>
                    <p class="mb-0">
                        <strong>Tasa BCV:</strong>
                        <span class="badge bg-info text-dark">@Model.Cliente.tasa.ToString("N5")</span>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Renglones del Documento</h5>
            <span class="badge bg-light text-dark">@Model.Renglones.Count renglones</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0" id="tablaRenglones">
                    <thead class="table-light">
                        <tr>
                            <th>Código</th>
                            <th>Descripción</th>
                            <th class="text-end">Cantidad</th>
                            <th class="text-end usd-currency">Precio Unit. ($)</th>
                            <th class="text-end usd-currency">IVA ($)</th>
                            <th class="text-end usd-currency">Total ($)</th>
                            <th class="text-end bs-currency">Precio Unit. (Bs.)</th>
                            <th class="text-end bs-currency">IVA (Bs.)</th>
                            <th class="text-end bs-currency">Total (Bs.)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var renglon in Model.Renglones)
                        {
                            <tr>
                                <td>@renglon.co_art</td>
                                <td>@renglon.art_des</td>
                                <td class="text-end">@renglon.total_art.ToString("N3")</td>
                                <td class="text-end usd-currency">@((renglon.prec_vta / tasaCambio).ToString("C", usCulture))</td>
                                <td class="text-end usd-currency">@((renglon.monto_imp / tasaCambio).ToString("C", usCulture))</td>
                                <td class="text-end usd-currency">@((renglon.reng_neto / tasaCambio).ToString("C", usCulture))</td>
                                <td class="text-end bs-currency">@renglon.prec_vta.ToString("N2") Bs</td>
                                <td class="text-end bs-currency">@renglon.monto_imp.ToString("N2") Bs</td>
                                <td class="text-end bs-currency">@renglon.reng_neto.ToString("N2") Bs</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="5" class="text-end fw-bold">Subtotal:</td>
                            <td class="text-end fw-bold usd-currency">@((Model.Documento.monto_bru).ToString("C", usCulture))</td>
                            <td class="text-end fw-bold bs-currency">@Model.SumaRengNeto.ToString("N2") Bs</td>
                        </tr>
                        <tr>
                            <td colspan="5" class="text-end fw-bold">IVA 16%:</td>
                            <td class="text-end fw-bold usd-currency">@((Model.Documento.monto_imp).ToString("C", usCulture))</td>
                            <td class="text-end fw-bold bs-currency">@Model.SumaMontoImp.ToString("N2") Bs</td>
                        </tr>
                        <tr class="table-active">
                            <td colspan="5" class="text-end fw-bold">Total neto:</td>
                            <td class="text-end fw-bold usd-currency">@((Model.Documento.monto_net).ToString("C", usCulture))</td>
                            <td class="text-end fw-bold bs-currency">@((Model.SumaRengNeto + Model.SumaMontoImp).ToString("N2")) Bs</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="totales-bar d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <span class="text-muted small">Total neto</span>
            <div class="valor bs-currency-total">@((Model.SumaRengNeto + Model.SumaMontoImp).ToString("N2")) Bs</div>
            <div class="valor usd-currency-total" style="display:none;">@((Model.Documento.monto_net).ToString("C", usCulture))</div>
        </div>
        <div class="text-muted small">Tasa BCV @Model.Cliente.tasa.ToString("N5")</div>
    </div>
</div>

@section scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var toggleBtn = document.getElementById('toggleCurrency');
            var table = document.getElementById('tablaRenglones');
            var bsTotal = document.querySelector('.bs-currency-total');
            var usdTotal = document.querySelector('.usd-currency-total');

            toggleBtn.addEventListener('click', function () {
                table.classList.toggle('show-usd');
                var showUsd = table.classList.contains('show-usd');
                toggleBtn.innerHTML = showUsd
                    ? '<i class="fas fa-exchange-alt me-1"></i> Mostrar en Bs'
                    : '<i class="fas fa-exchange-alt me-1"></i> Mostrar en USD';
                if (bsTotal && usdTotal) {
                    bsTotal.style.display = showUsd ? 'none' : 'block';
                    usdTotal.style.display = showUsd ? 'block' : 'none';
                }
            });
        });
    </script>
}
