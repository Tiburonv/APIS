@{
    ViewBag.Title = "Clientes";
    var co_cli = ViewBag.co_cli as string;
    var cli_des = ViewBag.cli_des as string;
}

<link href="~/Content/home-index.css?v=20260714" rel="stylesheet" />
<script>
    document.body.classList.add('home-index-page');
    var initialCoCli = '@(co_cli ?? "")';
    var initialCliDes = '@(cli_des ?? "")';
    var cargarAutomaticamente = @(ViewBag.CargarAutomaticamente == true ? "true" : "false");
</script>

<div class="container home-index" id="root" v-cloak>
    <div v-if="cargando" class="loading-overlay" aria-busy="true">
        <div class="loading-spinner" v-bind:class="{'has-progress': mostrarProgreso}">
            <div class="spinner-border spinner-border-custom text-primary" role="status" v-if="!mostrarProgreso || progresoCarga < 100">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <div class="loading-text">[[ textoCargar ]]</div>
            <div v-if="mostrarProgreso" class="loading-progress-wrap">
                <div class="progress" style="height: 22px;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                         role="progressbar"
                         v-bind:style="{ width: progresoCarga + '%' }"
                         v-bind:aria-valuenow="progresoCarga"
                         aria-valuemin="0"
                         aria-valuemax="100">
                    </div>
                </div>
                <div class="loading-progress-pct">[[ progresoCarga ]]%</div>
            </div>
        </div>
    </div>

    <div class="search-container">
        <h4><i class="fa fa-search" aria-hidden="true"></i> Buscar Clientes</h4>
        <div class="search-meta" role="status" aria-live="polite">
            <span v-if="totalClientesEncontrados > 0"><strong>[[ totalClientesEncontrados ]]</strong> clientes encontrados</span>
            <span v-else>Busca por código o nombre del cliente.</span>
        </div>
        <div class="search-box-wrap">
            <div class="search-flex">
                <input type="text"
                       :class="['form-control', {'search-loading': buscando}]"
                       v-model="txtBusqueda"
                       v-on:focus="onFocusBusqueda"
                       v-on:input="buscarSugerenciasDebounced"
                       v-on:keydown.down.prevent="moverSugerencia(1)"
                       v-on:keydown.up.prevent="moverSugerencia(-1)"
                       v-on:keydown.enter.prevent="confirmarSugerenciaOBuscar"
                       v-on:keydown.esc="sugerencias = []; sugerenciaIndex = -1"
                       placeholder="Código o nombre del cliente..."
                       autocomplete="off"
                       aria-autocomplete="list"
                       aria-controls="lista-sugerencias"
                       v-bind:aria-expanded="sugerencias.length > 0 ? 'true' : 'false'"
                       v-bind:disabled="buscando || cargando" />
                <button type="button"
                        class="btn todos-clientes-btn"
                        v-on:click="cargarTodosClientes"
                        v-bind:disabled="cargando || buscando"
                        v-bind:class="{'btn-loading': cargando || buscando}">
                    <i class="fa fa-list me-1" v-if="!cargando && !buscando" aria-hidden="true"></i>
                    <i class="fa fa-spinner fa-spin me-1" v-if="cargando || buscando" aria-hidden="true"></i>
                    <span v-if="!cargando && !buscando">Todos</span>
                    <span v-else>...</span>
                </button>
            </div>
            <ul id="lista-sugerencias"
                v-if="sugerencias.length > 0"
                class="list-group autocomplete-list"
                role="listbox">
                <li class="list-group-item autocomplete-item"
                    v-for="(s, i) in sugerencias"
                    :key="i"
                    role="option"
                    :class="{'is-active': i === sugerenciaIndex}"
                    v-on:click="seleccionarSugerencia(s)"
                    v-on:mouseenter="sugerenciaIndex = i">
                    <i class="fa fa-user" aria-hidden="true"></i> [[ s ]]
                </li>
            </ul>
        </div>
    </div>

    <div class="clientes-table-wrap table-responsive" v-if="resultadosPaginados.length > 0">
        <table class="table table-bordered table-hover mb-0">
            <thead>
                <tr>
                    <th class="cabecera-azul-claro is-sortable" v-on:click="ordenarPor('co_cli')">
                        <i class="fa fa-id-card" aria-hidden="true"></i> Código
                        <span class="sort-indicator" v-if="columnaOrden==='co_cli'">[[ ordenAscendente ? '▲' : '▼' ]]</span>
                    </th>
                    <th class="cabecera-azul-claro is-sortable" v-on:click="ordenarPor('cli_des')">
                        <i class="fa fa-user" aria-hidden="true"></i> Nombre
                        <span class="sort-indicator" v-if="columnaOrden==='cli_des'">[[ ordenAscendente ? '▲' : '▼' ]]</span>
                    </th>
                    <th class="cabecera-azul-claro text-center">FACT/PED</th>
                </tr>
            </thead>
            <tbody>
                <tr v-for="(item, index) in resultadosPaginados"
                    :key="item.co_cli + '-' + index"
                    :class="{
                        'table-active': esClienteActivo(item),
                        'row-seleccionada': esClienteActivo(item),
                        'row-clickable': true
                    }">
                    <td v-on:click="seleccionarCliente(item)" v-html="highlight(item.co_cli)"></td>
                    <td v-on:click="seleccionarCliente(item)" v-html="highlight(item.cli_des)"></td>
                    <td class="text-center">
                        <span class="fact-ped-badge">[[ contarFactPed(item) ]]</span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <nav v-if="totalPaginas > 1" aria-label="Paginación de clientes">
        <ul class="pagination justify-content-center home-pagination">
            <li :class="['page-item', {disabled: paginaActual === 1}]">
                <a class="page-link" href="#" v-on:click.prevent="cambiarPagina(paginaActual - 1)">Anterior</a>
            </li>
            <li v-for="(n, idx) in paginasVisibles" :key="'p-' + idx"
                :class="['page-item', {active: n === paginaActual, disabled: n === '…'}]">
                <a class="page-link" href="#" v-on:click.prevent="n !== '…' && cambiarPagina(n)">[[ n ]]</a>
            </li>
            <li :class="['page-item', {disabled: paginaActual === totalPaginas}]">
                <a class="page-link" href="#" v-on:click.prevent="cambiarPagina(paginaActual + 1)">Siguiente</a>
            </li>
        </ul>
    </nav>

    <div v-if="busquedaSinResultados" class="alert alert-info mt-3">
        <i class="fa fa-info-circle" aria-hidden="true"></i>
        No se encontraron clientes para «[[ txtBusqueda ]]».
    </div>

    <div v-if="mensajeAuto" class="alert alert-success mt-3" role="status">
        <i class="fa fa-check-circle" aria-hidden="true"></i> [[ mensajeAuto ]]
    </div>

    <div v-if="clienteSeleccionado" class="mt-4" id="panel-cliente">
        <div class="card border-primary shadow-sm">
            <div class="card-header bg-primary text-white d-flex align-items-center justify-content-between flex-wrap">
                <div>
                    <i class="fa fa-list-alt me-2" aria-hidden="true"></i>
                    Documentos del cliente
                </div>
                <small class="opacity-75">[[ clienteSeleccionado.co_cli ]] · [[ clienteSeleccionado.cli_des ]]</small>
            </div>
            <div class="card-body p-3 panel-cliente-body">
                <div class="cliente-resumen">
                    <div class="cliente-resumen__item">
                        <span class="cliente-resumen__label">Cliente</span>
                        <span class="cliente-resumen__value cliente-resumen__value--muted">[[ clienteSeleccionado.cli_des ]]</span>
                    </div>
                    <div class="cliente-resumen__item">
                        <span class="cliente-resumen__label">Documentos</span>
                        <span class="cliente-resumen__value">[[ resultadosPorCliente.length ]]</span>
                    </div>
                    <div class="cliente-resumen__item">
                        <span class="cliente-resumen__label">Con imagen</span>
                        <span class="cliente-resumen__value">[[ totalImagenesCliente ]]</span>
                    </div>
                    <div class="cliente-resumen__item">
                        <span class="cliente-resumen__label">Vencidos (+40 días)</span>
                        <span class="cliente-resumen__value">[[ totalVencidosCliente ]]</span>
                    </div>
                    <div class="cliente-resumen__item">
                        <span class="cliente-resumen__label">Saldo total</span>
                        <span class="cliente-resumen__value">[[ totalSaldoCliente ]]</span>
                    </div>
                </div>

                <div class="leyenda-filas">
                    <span class="leg-vencido">Vencido (+40)</span>
                    <span class="leg-imagen">Con imagen</span>
                    <span class="leg-ambos">Vencido + imagen</span>
                </div>

                <div class="docs-toolbar">
                    <div class="docs-filters" role="group" aria-label="Filtros de documentos">
                        <button type="button" class="btn btn-outline-primary" :class="{active: filtroDocs==='todos'}" v-on:click="filtroDocs='todos'">Todos ([[ documentosStats.total ]])</button>
                        <button type="button" class="btn btn-outline-primary" :class="{active: filtroDocs==='vencidos'}" v-on:click="filtroDocs='vencidos'">Vencidos ([[ documentosStats.vencidos ]])</button>
                        <button type="button" class="btn btn-outline-primary" :class="{active: filtroDocs==='conImagen'}" v-on:click="filtroDocs='conImagen'">Con imagen ([[ documentosStats.conImagen ]])</button>
                        <button type="button" class="btn btn-outline-primary" :class="{active: filtroDocs==='FACT'}" v-on:click="filtroDocs='FACT'">FACT ([[ documentosStats.FACT ]])</button>
                        <button type="button" class="btn btn-outline-primary" :class="{active: filtroDocs==='PED'}" v-on:click="filtroDocs='PED'">PED ([[ documentosStats.PED ]])</button>
                        <button type="button" class="btn btn-outline-primary" :class="{active: filtroDocs==='N/CR'}" v-on:click="filtroDocs='N/CR'">N/CR ([[ documentosStats.NCR ]])</button>
                    </div>
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary d-none d-md-inline-block"
                            v-on:click="mostrarDetalleMontos = !mostrarDetalleMontos">
                        <i class="fa fa-columns" aria-hidden="true"></i>
                        [[ mostrarDetalleMontos ? 'Ocultar montos extra' : 'Mostrar montos extra' ]]
                    </button>
                </div>

                <div v-if="documentosFiltrados.length === 0" class="alert alert-warning mb-0">
                    No hay documentos con el filtro seleccionado.
                </div>

                <!-- Desktop table -->
                <div class="table-responsive docs-table-wrap docs-table-desktop p-0" v-if="documentosFiltrados.length > 0">
                    <table class="table table-bordered table-hover table-striped mb-0 tabla-docs"
                           :class="{'show-extras': mostrarDetalleMontos}">
                        <thead>
                            <tr>
                                <th class="cabecera-azul-claro text-center">Tipo</th>
                                <th class="cabecera-azul-claro text-center">Nro / IMPFISCAL</th>
                                <th class="cabecera-azul-claro text-center">Fecha</th>
                                <th class="cabecera-azul-claro text-center">Días</th>
                                <th class="cabecera-azul-claro text-end col-extra">IVA 25%</th>
                                <th class="cabecera-azul-claro text-end col-extra">IVA 75%</th>
                                <th class="cabecera-azul-claro text-end col-extra">Sub+ IVA25%</th>
                                <th class="cabecera-azul-claro text-end col-extra">Sub Total</th>
                                <th class="cabecera-azul-claro text-end col-extra">IVA</th>
                                <th class="cabecera-azul-claro text-end">Saldo</th>
                                <th class="cabecera-azul-claro text-center">
                                    <i class="fa fa-image" aria-hidden="true"></i>
                                    <div><small>[[ totalImagenesFiltradas ]] / [[ documentosFiltrados.length ]]</small></div>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr v-for="(item, idx) in documentosFiltrados"
                                :key="'doc-' + item.co_tipo_doc + '-' + item.nro_doc + '-' + idx"
                                :class="[obtenerClasesFila(item), 'row-clickable']">
                                <td class="truncate text-center" :title="item.co_tipo_doc" v-html="highlight(item.co_tipo_doc)" v-on:click="navigateToDocument(item, $event)"></td>
                                <td class="text-center" v-on:click="navigateToDocument(item, $event)" v-html="highlight(item.nro_doc)"></td>
                                <td class="text-center" v-on:click="navigateToDocument(item, $event)">[[ formatFecha(item.fec_emis) ]]</td>
                                <td class="text-center" v-on:click="navigateToDocument(item, $event)">
                                    <span class="badge" :class="Number(item.Dias) > 40 ? 'bg-danger' : 'bg-success'">[[ item.Dias ]]</span>
                                </td>
                                <td class="text-end num-tabular col-extra" v-on:click="navigateToDocument(item, $event)">[[ formatNumero(item.IVA25) ]]</td>
                                <td class="text-end col-extra" v-on:click="navigateToDocument(item, $event)" v-html="highlight(item.estado_retencion)"></td>
                                <td class="text-end num-tabular col-extra" v-on:click="navigateToDocument(item, $event)">[[ formatNumero(Number(item.monto_bru) + Number(item.IVA25)) ]]</td>
                                <td class="text-end num-tabular col-extra" v-on:click="navigateToDocument(item, $event)">[[ formatNumero(item.monto_bru) ]]</td>
                                <td class="text-end num-tabular col-extra" v-on:click="navigateToDocument(item, $event)">[[ formatNumero(item.monto_imp) ]]</td>
                                <td class="text-end num-tabular fw-bold" v-on:click="navigateToDocument(item, $event)">[[ formatNumero(item.saldo) ]]</td>
                                <td class="text-center" v-on:click.stop>
                                    <i v-if="item.tiene_imagen === 1"
                                       class="fa fa-image icono-imagen icono-imagen-doc"
                                       v-on:click="abrirImagenDocumento(item)"
                                       title="Ver imagen"
                                       role="button"
                                       tabindex="0"
                                       v-on:keydown.enter="abrirImagenDocumento(item)"></i>
                                    <span v-else class="text-muted" title="Sin imagen">—</span>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot v-if="documentosFiltrados.length > 1">
                            <tr class="fila-total-docs">
                                <td :colspan="mostrarDetalleMontos ? 9 : 4" class="text-end">Total saldo</td>
                                <td class="text-end num-tabular">[[ totalSaldoFiltrado ]]</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <!-- Mobile cards -->
                <div class="doc-cards" v-if="documentosFiltrados.length > 0">
                    <div v-for="(item, idx) in documentosFiltrados"
                         :key="'card-' + item.co_tipo_doc + '-' + item.nro_doc + '-' + idx"
                         class="doc-card"
                         :class="{
                             'is-vencido': Number(item.Dias) > 40,
                             'has-img': item.tiene_imagen === 1
                         }"
                         v-on:click="navigateToDocument(item, $event)">
                        <div class="doc-card__top">
                            <div>
                                <div class="doc-card__title">[[ item.co_tipo_doc ]] · [[ item.nro_doc ]]</div>
                                <div class="text-muted doc-card__date">[[ formatFecha(item.fec_emis) ]]</div>
                            </div>
                            <div class="d-flex align-items-center doc-card__actions" v-on:click.stop>
                                <span class="badge" :class="Number(item.Dias) > 40 ? 'bg-danger' : 'bg-success'">[[ item.Dias ]] d</span>
                                <i v-if="item.tiene_imagen === 1"
                                   class="fa fa-image icono-imagen icono-imagen-card"
                                   v-on:click="abrirImagenDocumento(item)"
                                   title="Ver imagen"></i>
                            </div>
                        </div>
                        <div class="doc-card__meta">
                            <div>Subtotal: <strong class="num-tabular">[[ formatNumero(item.monto_bru) || '0.00' ]]</strong></div>
                            <div class="text-end">Saldo</div>
                            <div>IVA: <strong class="num-tabular">[[ formatNumero(item.monto_imp) || '0.00' ]]</strong></div>
                            <div class="doc-card__saldo text-end">[[ formatNumero(item.saldo) || '0.00' ]]</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <button v-if="clienteSeleccionado" class="btn btn-primary mt-3" v-on:click="imprimirPDF" v-bind:disabled="generandoPdf">
            <i class="fa fa-print" aria-hidden="true"></i>
            [[ generandoPdf ? 'Generando PDF...' : 'Imprimir PDF' ]]
        </button>
    </div>

    <div v-if="modalImagenVisible" class="modal-imagen-home" v-on:click="cerrarModalImagen" role="dialog" aria-modal="true" aria-label="Imagen del documento">
        <div class="modal-imagen-home__box" v-on:click.stop>
            <button type="button" class="modal-imagen-home__close" v-on:click="cerrarModalImagen" aria-label="Cerrar">&times;</button>
            <img :src="modalImagenSrc" alt="Imagen del documento" />
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Content/Imagen/logoConfig.js?v=20250108"></script>
    <script src="~/Content/Imagen/pdfEncabezado.js?v=20250528"></script>
    <script src="https://cdn.jsdelivr.net/npm/vue@2.7.16/dist/vue.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.9.0/axios.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>

    <script>
        function debounce(func, wait) {
            let timeout;
            return function () {
                const args = arguments;
                const ctx = this;
                clearTimeout(timeout);
                timeout = setTimeout(function () { func.apply(ctx, args); }, wait);
            };
        }

        var app = new Vue({
            el: "#root",
            delimiters: ['[[', ']]'],
            data: {
                txtBusqueda: '',
                sugerencias: [],
                sugerenciaIndex: -1,
                todosResultados: [],
                resultadosPorClienteMap: {},
                conteoFactPedPorClienteMap: {},
                resultadosFiltrados: [],
                clienteSeleccionado: null,
                resultadosPorCliente: [],
                paginaActual: 1,
                resultadosPorPagina: 50,
                columnaOrden: 'co_cli',
                ordenAscendente: true,
                showFullImage: false,
                cargando: false,
                buscando: false,
                textoCargar: 'Cargando...',
                mostrarProgreso: false,
                progresoCarga: 0,
                mostrandoTodos: false,
                filtroDocs: 'todos',
                mostrarDetalleMontos: false,
                modalImagenVisible: false,
                modalImagenSrc: '',
                mensajeAuto: '',
                generandoPdf: false,
                _searchCancelSource: null,
                _progresoTimer: null,
                _escHandler: null
            },
            computed: {
                resultadosPaginados: function () {
                    const inicio = (this.paginaActual - 1) * this.resultadosPorPagina;
                    return this.resultadosFiltrados.slice(inicio, inicio + this.resultadosPorPagina);
                },
                totalPaginas: function () {
                    return Math.ceil(this.resultadosFiltrados.length / this.resultadosPorPagina) || 0;
                },
                totalClientesEncontrados: function () {
                    return this.resultadosFiltrados.length;
                },
                documentosStats: function () {
                    return this.resultadosPorCliente.reduce(function (acc, item) {
                        const tipo = (item.co_tipo_doc || '').toString().trim().toUpperCase();
                        const dias = Number(item.Dias) || 0;
                        acc.total += 1;
                        if (dias > 40) acc.vencidos += 1;
                        if (item.tiene_imagen === 1) acc.conImagen += 1;
                        if (tipo === 'FACT') acc.FACT += 1;
                        if (tipo === 'PED') acc.PED += 1;
                        if (tipo === 'N/CR') acc.NCR += 1;
                        return acc;
                    }, { total: 0, vencidos: 0, conImagen: 0, FACT: 0, PED: 0, NCR: 0 });
                },
                paginasVisibles: function () {
                    const total = this.totalPaginas;
                    const actual = this.paginaActual;
                    if (total <= 7) {
                        const all = [];
                        for (let i = 1; i <= total; i++) all.push(i);
                        return all;
                    }
                    const pages = [1];
                    let start = Math.max(2, actual - 1);
                    let end = Math.min(total - 1, actual + 1);
                    if (actual <= 3) { start = 2; end = 4; }
                    if (actual >= total - 2) { start = total - 3; end = total - 1; }
                    if (start > 2) pages.push('…');
                    for (let i = start; i <= end; i++) pages.push(i);
                    if (end < total - 1) pages.push('…');
                    pages.push(total);
                    return pages;
                },
                documentosFiltrados: function () {
                    const f = this.filtroDocs;
                    return this.resultadosPorCliente.filter(function (item) {
                        const tipo = (item.co_tipo_doc || '').toString().trim().toUpperCase();
                        const dias = Number(item.Dias) || 0;
                        if (f === 'vencidos') return dias > 40;
                        if (f === 'conImagen') return item.tiene_imagen === 1;
                        if (f === 'FACT' || f === 'PED' || f === 'N/CR') return tipo === f;
                        return true;
                    });
                },
                totalImagenesCliente: function () {
                    return this.resultadosPorCliente.reduce(function (acc, item) {
                        return acc + (item.tiene_imagen === 1 ? 1 : 0);
                    }, 0);
                },
                totalImagenesFiltradas: function () {
                    return this.documentosFiltrados.reduce(function (acc, item) {
                        return acc + (item.tiene_imagen === 1 ? 1 : 0);
                    }, 0);
                },
                totalVencidosCliente: function () {
                    return this.resultadosPorCliente.reduce(function (acc, item) {
                        return acc + (Number(item.Dias) > 40 ? 1 : 0);
                    }, 0);
                },
                totalSaldoCliente: function () {
                    return this.formatearTotal(this.resultadosPorCliente);
                },
                totalSaldoFiltrado: function () {
                    return this.formatearTotal(this.documentosFiltrados);
                },
                busquedaSinResultados: function () {
                    return !!this.txtBusqueda &&
                        this.txtBusqueda.trim().length > 0 &&
                        !this.buscando &&
                        !this.cargando &&
                        this.resultadosFiltrados.length === 0 &&
                        !this.clienteSeleccionado;
                }
            },
            methods: {
                notificar: function (tipo, mensaje) {
                    if (typeof window.mostrarNotificacion === 'function') {
                        window.mostrarNotificacion(tipo, mensaje);
                        return;
                    }
                    alert(mensaje);
                },
                formatearTotal: function (lista) {
                    const total = lista.reduce(function (acc, item) {
                        const val = Number(item.saldo);
                        return acc + (isNaN(val) ? 0 : val);
                    }, 0);
                    return total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                },
                normalizarTexto: function (valor) {
                    return (valor || '').toString().trim();
                },
                obtenerClaveCliente: function (item) {
                    return this.normalizarTexto(item.co_cli) + '|' + this.normalizarTexto(item.cli_des);
                },
                esClienteActivo: function (item) {
                    return this.clienteSeleccionado &&
                        this.clienteSeleccionado.co_cli === item.co_cli &&
                        this.clienteSeleccionado.cli_des === item.cli_des;
                },
                construirMapaClientes: function (items) {
                    const mapa = {};
                    const conteoFactPed = {};
                    const self = this;
                    items.forEach(function (item) {
                        const key = self.obtenerClaveCliente(item);
                        if (!mapa[key]) mapa[key] = [];
                        mapa[key].push(item);
                        const tipoDoc = self.normalizarTexto(item.co_tipo_doc).toUpperCase();
                        if (tipoDoc === 'FACT' || tipoDoc === 'PED') {
                            conteoFactPed[key] = (conteoFactPed[key] || 0) + 1;
                        }
                    });
                    this.resultadosPorClienteMap = mapa;
                    this.conteoFactPedPorClienteMap = conteoFactPed;
                },
                cancelarBusquedaPendiente: function () {
                    if (this._searchCancelSource) {
                        this._searchCancelSource.cancel('Nueva búsqueda');
                        this._searchCancelSource = null;
                    }
                },
                getBusqueda: function () {
                    const cadena = this.txtBusqueda.trim();
                    if (!cadena) {
                        this.limpiarResultadosBusqueda();
                        return;
                    }

                    this.cancelarBusquedaPendiente();
                    this._searchCancelSource = axios.CancelToken.source();

                    this.buscando = true;
                    this.cargando = true;
                    this.textoCargar = 'Buscando clientes...';
                    this.mensajeAuto = '';

                    const self = this;
                    axios.get('/Home/buscarPorDocumCC1', {
                        params: { nombre: cadena, cantidad: 50, incluirImagen: false },
                        cancelToken: this._searchCancelSource.token
                    })
                        .then(function (response) {
                            self.aplicarResultadosBusqueda(response.data.datos || [], false);
                            if (initialCoCli && initialCliDes) {
                                const cliente = self.todosResultados.find(function (x) {
                                    return x.co_cli && x.co_cli.trim() === initialCoCli.trim() &&
                                        x.cli_des && x.cli_des.trim() === initialCliDes.trim();
                                });
                                if (cliente) self.seleccionarCliente(cliente);
                            }
                        })
                        .catch(function (err) {
                            if (axios.isCancel(err)) return;
                            self.limpiarResultadosBusqueda();
                        })
                        .finally(function () {
                            self.buscando = false;
                            self.cargando = false;
                            self._searchCancelSource = null;
                        });
                },
                getBsuqueda: function () { this.getBusqueda(); },
                aplicarResultadosBusqueda: function (datos, esTodos) {
                    this.todosResultados = datos;
                    this.construirMapaClientes(this.todosResultados);
                    const seen = {};
                    const self = this;
                    this.resultadosFiltrados = this.todosResultados.filter(function (item) {
                        const key = self.obtenerClaveCliente(item);
                        if (seen[key]) return false;
                        seen[key] = true;
                        return true;
                    });
                    this.clienteSeleccionado = null;
                    this.resultadosPorCliente = [];
                    this.filtroDocs = 'todos';
                    this.paginaActual = 1;
                    this.sugerencias = [];
                    this.sugerenciaIndex = -1;
                    this.mostrandoTodos = !!esTodos;
                },
                limpiarResultadosBusqueda: function () {
                    this.todosResultados = [];
                    this.resultadosFiltrados = [];
                    this.clienteSeleccionado = null;
                    this.resultadosPorCliente = [];
                    this.resultadosPorClienteMap = {};
                    this.conteoFactPedPorClienteMap = {};
                    this.paginaActual = 1;
                    this.sugerencias = [];
                    this.sugerenciaIndex = -1;
                    this.buscando = false;
                    this.cargando = false;
                },
                buscarSugerencias: function () {
                    if (this.txtBusqueda.length < 2) {
                        this.sugerencias = [];
                        this.sugerenciaIndex = -1;
                        return;
                    }
                    const texto = this.txtBusqueda.toLowerCase();
                    const set = {};
                    this.todosResultados.forEach(function (item) {
                        if (item.cli_des && item.cli_des.toLowerCase().indexOf(texto) !== -1) set[item.cli_des] = true;
                        if (item.co_cli && item.co_cli.toLowerCase().indexOf(texto) !== -1) set[item.co_cli] = true;
                    });
                    this.sugerencias = Object.keys(set).slice(0, 10);
                    this.sugerenciaIndex = this.sugerencias.length ? 0 : -1;
                },
                moverSugerencia: function (delta) {
                    if (!this.sugerencias.length) return;
                    const max = this.sugerencias.length - 1;
                    let next = this.sugerenciaIndex + delta;
                    if (next < 0) next = max;
                    if (next > max) next = 0;
                    this.sugerenciaIndex = next;
                },
                confirmarSugerenciaOBuscar: function () {
                    if (this.sugerencias.length && this.sugerenciaIndex >= 0) {
                        this.seleccionarSugerencia(this.sugerencias[this.sugerenciaIndex]);
                    } else {
                        this.getBusqueda();
                    }
                },
                seleccionarSugerencia: function (s) {
                    this.txtBusqueda = s;
                    this.sugerencias = [];
                    this.sugerenciaIndex = -1;
                    this.getBusqueda();
                },
                seleccionarCliente: function (item) {
                    this.clienteSeleccionado = item;
                    this.showFullImage = false;
                    this.filtroDocs = 'todos';
                    const key = this.obtenerClaveCliente(item);
                    this.resultadosPorCliente = this.resultadosPorClienteMap[key] || [];
                    this.resultadosFiltrados = [item];
                    this.paginaActual = 1;

                    if (cargarAutomaticamente) {
                        this.mensajeAuto = 'Cliente cargado: ' + item.cli_des;
                        const self = this;
                        setTimeout(function () { self.mensajeAuto = ''; }, 3500);
                    }

                    this.$nextTick(function () {
                        const el = document.getElementById('panel-cliente');
                        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    });
                },
                cambiarPagina: function (pagina) {
                    if (pagina > 0 && pagina <= this.totalPaginas) {
                        this.paginaActual = pagina;
                    }
                },
                ordenarPor: function (columna) {
                    if (this.columnaOrden === columna) {
                        this.ordenAscendente = !this.ordenAscendente;
                    } else {
                        this.columnaOrden = columna;
                        this.ordenAscendente = true;
                    }
                    const asc = this.ordenAscendente;
                    this.resultadosFiltrados.sort(function (a, b) {
                        if (a[columna] < b[columna]) return asc ? -1 : 1;
                        if (a[columna] > b[columna]) return asc ? 1 : -1;
                        return 0;
                    });
                    this.paginaActual = 1;
                },
                formatNumero: function (valor) {
                    if (valor == null || valor === '' || Number(valor) === 0) return '';
                    return Number(valor).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                },
                formatFecha: function (valor) {
                    if (!valor) return '';
                    let fecha;
                    if (typeof valor === 'string' && valor.match(/\/Date\((\d+)\)\//)) {
                        const ms = parseInt(valor.match(/\/Date\((\d+)\)\//)[1], 10);
                        fecha = new Date(ms);
                    } else if (typeof valor === 'string' && valor.length === 10 && /^\d{4}-\d{2}-\d{2}$/.test(valor)) {
                        const parts = valor.split('-');
                        fecha = new Date(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2]));
                    } else {
                        fecha = new Date(valor);
                    }
                    if (isNaN(fecha)) return valor;
                    const dia = ('0' + fecha.getDate()).slice(-2);
                    const mes = ('0' + (fecha.getMonth() + 1)).slice(-2);
                    return dia + '/' + mes + '/' + fecha.getFullYear();
                },
                navigateToDocument: function (item, event) {
                    if (event) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    if (this.cargando || !this.clienteSeleccionado) return;

                    this.cargando = true;
                    const tipoDocumento = (item.co_tipo_doc || '').toString().trim().toUpperCase();
                    if (tipoDocumento === 'FACT') this.textoCargar = 'Abriendo factura...';
                    else if (tipoDocumento === 'N/CR') this.textoCargar = 'Abriendo nota de credito...';
                    else if (tipoDocumento === 'N/DB') this.textoCargar = 'Abriendo nota de debito...';
                    else this.textoCargar = 'Cargando detalle del documento...';

                    const url = '/Home/DetalleDocumento?co_tipo_doc=' + encodeURIComponent(item.co_tipo_doc.trim()) +
                        '&nro_doc=' + encodeURIComponent(item.nro_doc.trim()) +
                        '&co_cli=' + encodeURIComponent(this.clienteSeleccionado.co_cli.trim()) +
                        '&cli_des=' + encodeURIComponent(this.clienteSeleccionado.cli_des.trim());

                    requestAnimationFrame(function () {
                        setTimeout(function () { window.location.href = url; }, 60);
                    });
                },
                onFocusBusqueda: function () {
                    // No limpia selección; solo ayuda a reescribir
                },
                limpiarBusqueda: function () {
                    this.cancelarBusquedaPendiente();
                    this.txtBusqueda = '';
                    this.limpiarResultadosBusqueda();
                    this.mostrandoTodos = false;
                    this.mensajeAuto = '';
                    this.cerrarModalImagen();
                },
                escapeHtml: function (text) {
                    return String(text)
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;')
                        .replace(/"/g, '&quot;')
                        .replace(/'/g, '&#39;');
                },
                highlight: function (text) {
                    if (text == null) return '';
                    const safe = this.escapeHtml(text);
                    if (!this.txtBusqueda) return safe;
                    const q = this.escapeHtml(this.txtBusqueda.trim());
                    if (!q) return safe;
                    try {
                        const regex = new RegExp('(' + q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
                        return safe.replace(regex, '<span class="highlight">$1</span>');
                    } catch (e) {
                        return safe;
                    }
                },
                verImagenCompleta: function (imagenData) {
                    if (!imagenData || imagenData === 'undefined' || imagenData === 'null') {
                        this.notificar('warning', 'No hay imagen disponible para mostrar');
                        return;
                    }
                    let srcImagen = '';
                    if (Array.isArray(imagenData) || (imagenData instanceof Uint8Array)) {
                        const bytes = new Uint8Array(imagenData);
                        let binary = '';
                        for (let i = 0; i < bytes.byteLength; i++) binary += String.fromCharCode(bytes[i]);
                        srcImagen = 'data:image/png;base64,' + window.btoa(binary);
                    } else if (typeof imagenData === 'string') {
                        srcImagen = imagenData.indexOf('data:image/') === 0 ? imagenData : ('data:image/png;base64,' + imagenData);
                    } else {
                        this.notificar('error', 'No se pudo cargar la imagen: formato no compatible');
                        return;
                    }
                    this.modalImagenSrc = srcImagen;
                    this.modalImagenVisible = true;
                    const self = this;
                    this._escHandler = function (e) {
                        if (e.key === 'Escape') self.cerrarModalImagen();
                    };
                    document.addEventListener('keydown', this._escHandler);
                },
                cerrarModalImagen: function () {
                    this.modalImagenVisible = false;
                    this.modalImagenSrc = '';
                    if (this._escHandler) {
                        document.removeEventListener('keydown', this._escHandler);
                        this._escHandler = null;
                    }
                },
                abrirImagenDocumento: function (item) {
                    if (!item) return;
                    if (item.Imagen && item.Imagen !== 'undefined' && item.Imagen !== 'null') {
                        this.verImagenCompleta('data:image/png;base64,' + item.Imagen);
                        return;
                    }
                    this.cargando = true;
                    this.textoCargar = 'Cargando imagen del documento...';
                    const self = this;
                    axios.get('/Home/ObtenerImagenDocumento', {
                        params: {
                            co_tipo_doc: (item.co_tipo_doc || '').trim(),
                            nro_doc: (item.nro_doc || '').trim(),
                            co_cli: this.clienteSeleccionado
                                ? (this.clienteSeleccionado.co_cli || '').trim()
                                : (item.co_cli || '').trim()
                        }
                    })
                        .then(function (response) {
                            const data = response.data || {};
                            if (data.success && data.imagen) {
                                item.Imagen = data.imagen;
                                self.verImagenCompleta('data:image/png;base64,' + data.imagen);
                            } else {
                                self.notificar('warning', 'No hay imagen disponible para este documento');
                            }
                        })
                        .catch(function () {
                            self.notificar('warning', 'No hay imagen disponible para este documento');
                        })
                        .finally(function () {
                            self.cargando = false;
                        });
                },
                sumaCol: function (campo) {
                    return this.resultadosPorCliente.reduce(function (acc, item) {
                        const val = Number(item[campo]);
                        return acc + (isNaN(val) ? 0 : val);
                    }, 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                },
                obtenerClasesFila: function (item) {
                    return {
                        'fila-roja': Number(item.Dias) > 40,
                        'fila-con-imagen': item.tiene_imagen === 1
                    };
                },
                contarFactPed: function (cliente) {
                    const key = this.obtenerClaveCliente(cliente);
                    return this.conteoFactPedPorClienteMap[key] || 0;
                },
                imprimirPDF: async function () {
                    if (!this.clienteSeleccionado || this.generandoPdf) return;
                    this.generandoPdf = true;
                    try {
                        if (!window.jspdf || !window.agregarEncabezadoPdf) {
                            this.notificar('error', 'No se pudo cargar el generador de PDF. Recarga la página e intenta de nuevo.');
                            return;
                        }
                        const doc = new window.jspdf.jsPDF();
                        const startY = await window.agregarEncabezadoPdf(doc, {
                            logoWidth: 55,
                            logoMaxHeight: 32,
                            direccionMaxWidth: 85
                        });

                        doc.autoTable({
                            startY: startY + 4,
                            head: [[
                                { content: ' Código Cliente', styles: { fillColor: [21, 101, 192], textColor: 255, fontStyle: 'bold', halign: 'left' } },
                                { content: ' Nombre Cliente', styles: { fillColor: [21, 101, 192], textColor: 255, fontStyle: 'bold', halign: 'left' } }
                            ]],
                            body: [[
                                { content: this.clienteSeleccionado.co_cli, styles: { fillColor: [229, 200, 112], textColor: 20, fontStyle: 'bold' } },
                                { content: this.clienteSeleccionado.cli_des, styles: { fillColor: [229, 200, 112], textColor: 20, fontStyle: 'bold' } }
                            ]],
                            theme: 'plain',
                            styles: { fontSize: 12, cellPadding: 4, lineWidth: 0.5, lineColor: [200, 200, 200] },
                            margin: { left: 10, right: 10 }
                        });

                        const self = this;
                        const lista = this.documentosFiltrados.length ? this.documentosFiltrados : this.resultadosPorCliente;
                        const columns = [
                            { header: 'Tipo Doc', dataKey: 'co_tipo_doc' },
                            { header: 'Nro Doc', dataKey: 'nro_doc' },
                            { header: 'Fecha', dataKey: 'fec_emis' },
                            { header: 'Dias', dataKey: 'Dias' },
                            { header: 'IVA 25%', dataKey: 'IVA25' },
                            { header: 'IVA 75%', dataKey: 'estado_retencion' },
                            { header: 'Sub+ IVA25%', dataKey: 'sub_iva25' },
                            { header: 'Sub Total', dataKey: 'monto_bru' },
                            { header: 'IVA', dataKey: 'monto_imp' },
                            { header: 'Saldo', dataKey: 'saldo' }
                        ];
                        const rows = lista.map(function (item) {
                            return {
                                co_tipo_doc: item.co_tipo_doc,
                                nro_doc: item.nro_doc,
                                fec_emis: self.formatFecha(item.fec_emis),
                                Dias: item.Dias,
                                IVA25: self.formatNumero(item.IVA25),
                                estado_retencion: item.estado_retencion,
                                sub_iva25: self.formatNumero(Number(item.monto_bru) + Number(item.IVA25)),
                                monto_bru: self.formatNumero(item.monto_bru),
                                monto_imp: self.formatNumero(item.monto_imp),
                                saldo: self.formatNumero(item.saldo)
                            };
                        });

                        let foot = [];
                        if (lista.length > 1) {
                            foot = [[
                                { content: 'Totales:', colSpan: 9, styles: { halign: 'right', fontStyle: 'bold' } },
                                { content: this.formatearTotal(lista), styles: { fontStyle: 'bold' } }
                            ]];
                        }

                        doc.autoTable({
                            startY: doc.lastAutoTable.finalY + 8,
                            head: [columns.map(function (c) { return c.header; })],
                            body: rows.map(function (row) { return columns.map(function (col) { return row[col.dataKey]; }); }),
                            foot: foot,
                            styles: { fontSize: 9, cellPadding: 2 },
                            headStyles: { fillColor: [21, 101, 192], textColor: 255, fontStyle: 'bold' },
                            footStyles: { fillColor: [227, 242, 253], textColor: 0, fontStyle: 'bold' },
                            alternateRowStyles: { fillColor: [249, 249, 249] }
                        });

                        doc.setFontSize(10);
                        doc.text('Fecha de impresion: ' + new Date().toLocaleString(), 10, doc.lastAutoTable.finalY + 10);
                        doc.save('Cliente_' + this.clienteSeleccionado.co_cli + '.pdf');
                    } catch (e) {
                        console.error(e);
                        this.notificar('error', 'Error al generar el PDF.');
                    } finally {
                        this.generandoPdf = false;
                    }
                },
                iniciarProgresoCarga: function (mensajeBase) {
                    this.mostrarProgreso = true;
                    this.progresoCarga = 0;
                    this.textoCargar = mensajeBase + ' 0%';
                    this.detenerProgresoTimer();
                    const self = this;
                    this._progresoTimer = setInterval(function () {
                        if (self.progresoCarga < 85) {
                            self.progresoCarga += 1;
                            self.textoCargar = mensajeBase + ' ' + self.progresoCarga + '%';
                        }
                    }, 180);
                },
                detenerProgresoTimer: function () {
                    if (this._progresoTimer) {
                        clearInterval(this._progresoTimer);
                        this._progresoTimer = null;
                    }
                },
                actualizarProgresoDescarga: function (progressEvent, mensajeBase) {
                    if (!progressEvent.total) return;
                    this.detenerProgresoTimer();
                    const pct = Math.min(99, Math.round((progressEvent.loaded * 100) / progressEvent.total));
                    this.progresoCarga = pct;
                    this.textoCargar = mensajeBase + ' ' + pct + '%';
                },
                finalizarProgresoCarga: function (callback) {
                    this.detenerProgresoTimer();
                    this.progresoCarga = 100;
                    this.textoCargar = 'Completado 100%';
                    const self = this;
                    setTimeout(function () {
                        self.mostrarProgreso = false;
                        self.progresoCarga = 0;
                        if (typeof callback === 'function') callback();
                    }, 350);
                },
                cancelarProgresoCarga: function () {
                    this.detenerProgresoTimer();
                    this.mostrarProgreso = false;
                    this.progresoCarga = 0;
                },
                cargarTodosClientes: function () {
                    const mensajeBase = 'Cargando todos los clientes';
                    this.cancelarBusquedaPendiente();
                    this._searchCancelSource = axios.CancelToken.source();
                    this.cargando = true;
                    this.buscando = true;
                    this.iniciarProgresoCarga(mensajeBase);

                    const self = this;
                    axios.get('/Home/buscarPorDocumCC1', {
                        params: { nombre: '', cantidad: 1000, incluirImagen: false },
                        cancelToken: this._searchCancelSource.token,
                        onDownloadProgress: function (pe) { self.actualizarProgresoDescarga(pe, mensajeBase); }
                    })
                        .then(function (response) {
                            self.detenerProgresoTimer();
                            self.progresoCarga = 96;
                            self.textoCargar = 'Procesando clientes... 96%';
                            self.aplicarResultadosBusqueda(response.data.datos || [], true);
                            self.txtBusqueda = '';
                            self.finalizarProgresoCarga(function () {
                                self.buscando = false;
                                self.cargando = false;
                            });
                        })
                        .catch(function (error) {
                            if (axios.isCancel(error)) return;
                            console.error(error);
                            self.cancelarProgresoCarga();
                            self.limpiarResultadosBusqueda();
                            self.txtBusqueda = '';
                            self.textoCargar = 'Error al cargar los clientes';
                            self.buscando = false;
                            self.cargando = false;
                        })
                        .finally(function () {
                            self._searchCancelSource = null;
                        });
                }
            },
            created: function () {
                this.buscarSugerenciasDebounced = debounce(this.buscarSugerencias, 300);
                if (cargarAutomaticamente && initialCoCli && initialCliDes) {
                    this.txtBusqueda = initialCliDes;
                    this.getBusqueda();
                }
            },
            mounted: function () {
                if (cargarAutomaticamente && initialCoCli && initialCliDes) {
                    let intentos = 0;
                    const self = this;
                    const interval = setInterval(function () {
                        intentos++;
                        if (self.todosResultados.length > 0) {
                            const cliente = self.todosResultados.find(function (x) {
                                return x.co_cli && x.co_cli.trim() === initialCoCli.trim() &&
                                    x.cli_des && x.cli_des.trim() === initialCliDes.trim();
                            });
                            if (cliente) {
                                self.seleccionarCliente(cliente);
                                clearInterval(interval);
                            }
                        }
                        if (intentos >= 10) clearInterval(interval);
                    }, 500);
                }
            },
            beforeDestroy: function () {
                this.cancelarBusquedaPendiente();
                this.detenerProgresoTimer();
                this.cerrarModalImagen();
            }
        });
    </script>
}
