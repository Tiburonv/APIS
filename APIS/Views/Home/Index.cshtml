@{
    ViewBag.Title = "Clientes";
    var co_cli = ViewBag.co_cli as string;
    var cli_des = ViewBag.cli_des as string;
}
@*<h2>Clientes</h2>
    <p>Bienvenido a la página de clientes.</p>*@

<style>
    /* En Index.cshtml (Clientes) */
    body {
        background: #f4f6fb;
    }

    h4 {
        color: #1565c0;
    }

    .search-container {
        margin: 32px auto 24px auto;
        max-width: 520px;
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 2px 16px rgba(21,101,192,0.10);
        padding: 28px 36px 20px 36px;
    }

    .search-flex {
        display: flex;
        align-items: center;
    }

        .search-flex img {
            height: 38px;
            margin-right: 14px;
            border-radius: 6px;
        }

    .cabecera-azul-claro {
        background-color: #1565c0 !important;
        color: #fff;
        border-radius: 6px 6px 0 0;
        font-size: 1.1rem;
        letter-spacing: 0.5px;
    }

    .row-seleccionada, .table-active {
        background-color: #ffe082 !important;
        font-weight: bold;
    }

    .table-hover tbody tr:hover {
        background-color: #e3f2fd !important;
        transition: background 0.2s;
    }

    .table-striped tbody tr:nth-of-type(odd) {
        background-color: #f9f9f9;
    }

    .truncate {
        max-width: 120px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .highlight {
        background-color: #ffff66;
        padding: 0 2px;
        border-radius: 2px;
    }

    .autocomplete-list {
        position: absolute;
        z-index: 1000;
        width: 100%;
        max-height: 200px;
        overflow-y: auto;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        border-radius: 0 0 6px 6px;
    }

    .autocomplete-item {
        cursor: pointer;
        transition: background 0.2s;
    }

        .autocomplete-item:hover {
            background: #e3f2fd;
        }

    .table-responsive {
        margin-top: 24px;
        border-radius: 8px;
        box-shadow: 0 2px 12px rgba(21,101,192,0.08);
        background: #fff;
        padding: 16px;
    }

    .pagination {
        margin-top: 20px;
    }

    .alert-info {
        margin-top: 24px;
        border-radius: 6px;
    }

    h4, h5 {
        color: #1565c0;
        font-weight: 600;
        margin-bottom: 18px;
    }

    /* Mejoras para el card de resultados seleccionados */
    .card.border-primary {
        border: 1.5px solid #1565c0 !important;
    }

    .card-header.bg-primary {
        background: #1565c0 !important;
        color: #fff !important;
        font-weight: 600;
        font-size: 1.15rem;
        letter-spacing: 0.5px;
        border-radius: 8px 8px 0 0;
    }

    .card {
        border-radius: 8px;
        box-shadow: 0 2px 12px rgba(21,101,192,0.10);
    }

    .table tfoot tr {
        background: #e3f2fd !important;
    }

    /* Estilos para los enlaces de navegación */
    .btn-group .btn {
        margin: 0 2px;
    }

    .btn-outline-primary:hover {
        background-color: #1565c0;
        border-color: #1565c0;
        color: white;
    }

    .btn-outline-info:hover {
        background-color: #17a2b8;
        border-color: #17a2b8;
        color: white;
    }

    /* Mejoras para móviles */
    @@media (max-width: 768px) {
        .btn-group {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

            .btn-group .btn {
                margin: 0;
                font-size: 0.75rem;
                padding: 0.25rem 0.5rem;
            }

        .card-header .btn {
            font-size: 0.875rem;
            padding: 0.375rem 0.75rem;
        }

        .d-flex.justify-content-between {
            flex-direction: column;
            gap: 5px;
        }
    }

    /* Estilos para los enlaces en la tabla principal */
    .table td .btn-sm {
        font-size: 0.75rem;
        padding: 0.25rem 0.5rem;
    }

    .table td .d-flex {
        min-height: 30px;
    }
</style>

<script>
    var initialCoCli = '@(co_cli ?? "")';
    var initialCliDes = '@(cli_des ?? "")';
    var cargarAutomaticamente = @(ViewBag.CargarAutomaticamente == true ? "true" : "false");
</script>

<div class="container" id="root">
    <div class="search-container">
        <h4><i class="fa fa-search"></i> Buscar Clientes</h4>
        <div style="position:relative;">
            <div class="search-flex">
                <img src="~/Content/Zulia_log.bmp" alt="Logo" />
                <input type="text"
                       class="form-control"
                       v-model="txtBusqueda"
                       v-on:focus="limpiarBusqueda"
                       v-on:input="buscarSugerenciasDebounced"
                       v-on:keyup.enter="getBsuqueda()"
                       placeholder="Buscar Cliente..."
                       autocomplete="off" />
            </div>
            <ul v-if="sugerencias.length > 0" class="list-group autocomplete-list">
                <li class="list-group-item autocomplete-item"
                    v-for="(s, i) in sugerencias"
                    :key="i"
                    v-on:click="seleccionarSugerencia(s)">
                    <i class="fa fa-user"></i> [[ s ]]
                </li>
            </ul>
        </div>
    </div>

    <div class="table-responsive" v-if="resultadosPaginados.length > 0">
        <table class="table table-bordered mt-3">
            <thead>
                <tr>
                    <th class="cabecera-azul-claro" v-on:click="ordenarPor('co_cli')" style="cursor:pointer;">
                        <i class="fa fa-id-card"></i> Código Cliente
                        <span v-if="columnaOrden==='co_cli'">
                            <span v-if="ordenAscendente">&#9650;</span>
                            <span v-else>&#9660;</span>
                        </span>
                    </th>
                    <th class="cabecera-azul-claro" v-on:click="ordenarPor('cli_des')" style="cursor:pointer;">
                        <i class="fa fa-user"></i> Nombre Cliente
                        <span v-if="columnaOrden==='cli_des'">
                            <span v-if="ordenAscendente">&#9650;</span>
                            <span v-else>&#9660;</span>
                        </span>
                    </th>
                </tr>
            </thead>
            <tbody>
                <tr v-for="(item, index) in resultadosPaginados"
                    :key="item.co_cli + '-' + index"
                    :class="{
                        'table-active': clienteSeleccionado
                            && clienteSeleccionado.co_cli === item.co_cli
                            && clienteSeleccionado.cli_des === item.cli_des,
                        'row-seleccionada': clienteSeleccionado
                            && clienteSeleccionado.co_cli === item.co_cli
                            && clienteSeleccionado.cli_des === item.cli_des
                    }"
                    style="cursor:pointer;">
                    <td v-on:click="seleccionarCliente(item)" v-html="highlight(item.co_cli)"></td>
                    <td>
                        <div class="d-flex justify-content-between align-items-center">
                            <span v-on:click="seleccionarCliente(item)" v-html="highlight(item.cli_des)" style="cursor:pointer;"></span>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <nav v-if="totalPaginas > 1">
        <ul class="pagination justify-content-center">
            <li :class="['page-item', {disabled: paginaActual === 1}]">
                <a class="page-link" href="#" v-on:click.prevent="cambiarPagina(paginaActual - 1)">Anterior</a>
            </li>
            <li v-for="n in totalPaginas" :key="n" :class="['page-item', {active: paginaActual === n}]">
                <a class="page-link" href="#" v-on:click.prevent="cambiarPagina(n)">[[ n ]]</a>
            </li>
            <li :class="['page-item', {disabled: paginaActual === totalPaginas}]">
                <a class="page-link" href="#" v-on:click.prevent="cambiarPagina(paginaActual + 1)">Siguiente</a>
            </li>
        </ul>
    </nav>

    <div v-if="resultadosFiltrados.length === 0 && txtBusqueda" class="alert alert-info mt-3">
        <i class="fa fa-info-circle"></i> El cliente tiene Documentos.
    </div>

    <!-- Mensaje de carga cuando hay parámetros iniciales -->
    <div v-if="cargarAutomaticamente && initialCoCli && initialCliDes && !clienteSeleccionado && todosResultados.length === 0" class="alert alert-warning mt-3">
        <i class="fa fa-spinner fa-spin"></i> Cargando detalles del cliente...
    </div>

    <!-- Mensaje de éxito cuando se carga automáticamente -->
    <div v-if="cargarAutomaticamente && clienteSeleccionado" class="alert alert-success mt-3" style="display: none;" id="mensajeExito">
        <i class="fa fa-check-circle"></i> Cliente cargado automáticamente: <strong>[[ clienteSeleccionado.cli_des ]]</strong>
    </div>

    <!-- RESULTADOS SELECCIONADOS MEJORADOS -->
    <div v-if="clienteSeleccionado" class="mt-4">
        <div class="card border-primary shadow-sm">
            <div class="card-header bg-primary text-white d-flex align-items-center justify-content-between" style="font-size:1.15rem;">
                <div>
                    <i class="fa fa-list-alt mr-2"></i>
                    <span class="ml-2">Resultados para el cliente seleccionado</span>
                </div>
                
            </div>
            <div class="card-body p-3" style="background:#f8fafc;">
                <!-- Imagen del cliente -->
                <div v-if="clienteSeleccionado && clienteSeleccionado.IMAGEN">
                    <h5>Imagen del Cliente</h5>
                    <img :src="'data:image/png;base64,' + clienteSeleccionado.IMAGEN" alt="Imagen del Cliente" style="max-width: 200px; max-height: 200px; border: 1px solid #ccc; border-radius: 8px;" />
                </div>


                <!-- Tabla de resultados -->
                <div class="table-responsive">
                    <table class="table table-sm table-bordered table-hover table-striped mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th class="text-center">Tipo Doc</th>
                                <th class="text-center">Nro Doc</th>
                                <th class="text-center">Fecha</th>
                                <th class="text-center">Días</th>
                                <th class="text-end">IVA 25%</th>
                                <th class="text-end">IVA 75%</th>
                                <th class="text-end">Sub+ IVA25%</th>
                                <th class="text-end">Sub Total</th>
                                <th class="text-end">IVA</th>
                                <th class="text-end">Saldo</th>
                                <th class="text-center">IMG</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr v-for="(item, idx) in resultadosPorCliente" :key="item.co_cli + '-' + idx" :class="{'fila-roja': Number(item.Dias) > 40}" style="cursor: pointer;">
                                <td class="truncate text-center clickable-cell" :title="item.co_tipo_doc" v-html="highlight(item.co_tipo_doc)" v-on:click="navigateToDocument(item)"></td>
                                <td class="text-center">
                                    <a :href="'/Home/DetalleDocumento?co_tipo_doc=' + encodeURIComponent(item.co_tipo_doc.trim()) + '&nro_doc=' + encodeURIComponent(item.nro_doc.trim()) + '&co_cli=' + encodeURIComponent(clienteSeleccionado.co_cli.trim()) + '&cli_des=' + encodeURIComponent(clienteSeleccionado.cli_des.trim())"
                                       class="text-decoration-none"
                                       v-html="highlight(item.nro_doc)">
                                    </a>
                                </td>
                                <td class="text-center clickable-cell" v-on:click="navigateToDocument(item)">[[ formatFecha(item.fec_emis) ]]</td>
                                <td class="text-center clickable-cell" v-on:click="navigateToDocument(item)" v-html="highlight(item.Dias)"></td>
                                <td class="text-end clickable-cell" v-on:click="navigateToDocument(item)">[[ formatNumero(item.IVA25) ]]</td>
                                <td class="text-end clickable-cell" v-on:click="navigateToDocument(item)" v-html="highlight(item.estado_retencion)"></td>
                                <td class="text-end clickable-cell" v-on:click="navigateToDocument(item)">[[ formatNumero(item.monto_bru+item.IVA25) ]]</td>
                                <td class="text-end clickable-cell" v-on:click="navigateToDocument(item)">[[ formatNumero(item.monto_bru) ]]</td>
                                <td class="text-end clickable-cell" v-on:click="navigateToDocument(item)">[[ formatNumero(item.monto_imp) ]]</td>
                                <td class="text-end clickable-cell" v-on:click="navigateToDocument(item)">[[ formatNumero(item.saldo) ]]</td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <div v-if="item.IMAGEN && item.IMAGEN.length > 0">
                                            <i class="fa fa-eye"
                                               style="font-size: 16px; color: #1565c0; cursor: pointer; margin-left: 5px;"
                                               v-on:click="verImagenCompleta('data:image/png;base64,' + item.IMAGEN)"
                                               title="Haz clic para ver la imagen completa"></i>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        <tfoot v-if="resultadosPorCliente.length > 1">
                            <tr style="font-weight:bold; background:#e3f2fd;">
                                <td colspan="9"></td>
                                <td class="text-end">[[ sumaCol('saldo') ]]</td>

                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
        <button v-if="clienteSeleccionado" class="btn btn-primary mt-3" v-on:click="imprimirPDF">
            <i class="fa fa-print"></i> Imprimir PDF
        </button>
    </div>
    <!-- FIN RESULTADOS SELECCIONADOS MEJORADOS -->
</div>


@section scripts{
    <script src="~/Content/Imagen/logoConfig.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/vue@2/dist/vue.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.9.0/axios.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>

    <script>
        function debounce(func, wait) {
            let timeout;
            return function (...args) {
                clearTimeout(timeout);
                timeout = setTimeout(() => func.apply(this, args), wait);
            };
        }

        var app = new Vue({
            el: "#root",
            delimiters: ['[[', ']]'],
            data: {
                txtBusqueda: '',
                sugerencias: [],
                todosResultados: [],
                resultadosFiltrados: [],
                clienteSeleccionado: null,
                resultadosPorCliente: [],
                paginaActual: 1,
                resultadosPorPagina: 10,
                columnaOrden: 'co_cli',
                ordenAscendente: true,
                debugMode: true
            },
            computed: {
                resultadosPaginados() {
                    const inicio = (this.paginaActual - 1) * this.resultadosPorPagina;
                    return this.resultadosFiltrados.slice(inicio, inicio + this.resultadosPorPagina);
                },
                totalPaginas() {
                    return Math.ceil(this.resultadosFiltrados.length / this.resultadosPorPagina);
                }
            },
            methods: {
                getBsuqueda() {
                    if (this.txtBusqueda.trim() !== '') {
                        let cadena = this.txtBusqueda.trim();
                        let cantidad = 1000;

                        axios.get('/Home/buscarPorDocumCC1', {
                            params: {
                                nombre: cadena,
                                cantidad: cantidad
                            }
                        })
                            .then((response) => {
                                console.log('API Response:', response.data);
                                this.todosResultados = response.data.datos || [];
                                // Log the first item to check if Imagen property exists
                                if (this.todosResultados.length > 0) {
                                    console.log('First item in response:', this.todosResultados[0]);
                                }
                                const seen = {};
                                this.resultadosFiltrados = this.todosResultados.filter(item => {
                                    const key = item.co_cli + '|' + item.cli_des;
                                    if (seen[key]) return false;
                                    seen[key] = true;
                                    return true;
                                });
                                this.clienteSeleccionado = null;
                                this.resultadosPorCliente = [];
                                this.paginaActual = 1;
                                this.sugerencias = [];
                                // Selección automática si hay parámetros iniciales
                                if (initialCoCli && initialCliDes) {
                                    const cliente = this.todosResultados.find(x => 
                                        x.co_cli && x.co_cli.trim() === initialCoCli.trim() && 
                                        x.cli_des && x.cli_des.trim() === initialCliDes.trim()
                                    );
                                    if (cliente) {
                                        this.seleccionarCliente(cliente);
                                    }
                                }
                            })
                            .catch(() => {
                                this.todosResultados = [];
                                this.resultadosFiltrados = [];
                                this.clienteSeleccionado = null;
                                this.resultadosPorCliente = [];
                                this.paginaActual = 1;
                                this.sugerencias = [];
                            });
                    } else {
                        this.todosResultados = [];
                        this.resultadosFiltrados = [];
                        this.clienteSeleccionado = null;
                        this.resultadosPorCliente = [];
                        this.paginaActual = 1;
                        this.sugerencias = [];
                    }
                },
                buscarSugerencias() {
                    if (this.txtBusqueda.length < 2) {
                        this.sugerencias = [];
                        return;
                    }
                    const texto = this.txtBusqueda.toLowerCase();
                    const sugerenciasSet = new Set();
                    this.todosResultados.forEach(item => {
                        if (item.cli_des && item.cli_des.toLowerCase().includes(texto)) {
                            sugerenciasSet.add(item.cli_des);
                        }
                        if (item.co_cli && item.co_cli.toLowerCase().includes(texto)) {
                            sugerenciasSet.add(item.co_cli);
                        }
                    });
                    this.sugerencias = Array.from(sugerenciasSet).slice(0, 10);
                },
                seleccionarSugerencia(s) {
                    this.txtBusqueda = s;
                    this.sugerencias = [];
                    this.getBsuqueda();
                },
                seleccionarCliente(item) {
                    this.clienteSeleccionado = item;
                    this.resultadosPorCliente = this.todosResultados.filter(x =>
                        x.co_cli && x.co_cli.trim() === item.co_cli.trim() && 
                        x.cli_des && x.cli_des.trim() === item.cli_des.trim()
                    );

                    // Dejar solo el cliente seleccionado en los resultados filtrados
                    this.resultadosFiltrados = [item];
                    this.paginaActual = 1;
                    
                    // Mostrar mensaje de éxito si se cargó automáticamente
                    if (cargarAutomaticamente) {
                        setTimeout(() => {
                            const mensajeExito = document.getElementById('mensajeExito');
                            if (mensajeExito) {
                                mensajeExito.style.display = 'block';
                                setTimeout(() => {
                                    mensajeExito.style.display = 'none';
                                }, 3000);
                            }
                        }, 500);
                    }
                    
                    // Scroll hacia la sección de resultados del cliente
                    setTimeout(() => {
                        const resultadosSection = document.querySelector('.card.border-primary');
                        if (resultadosSection) {
                            resultadosSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                        }
                    }, 100);
                },
                cambiarPagina(pagina) {
                    if (pagina > 0 && pagina <= this.totalPaginas) {
                        this.paginaActual = pagina;
                    }
                },
                ordenarPor(columna) {
                    if (this.columnaOrden === columna) {
                        this.ordenAscendente = !this.ordenAscendente;
                    } else {
                        this.columnaOrden = columna;
                        this.ordenAscendente = true;
                    }
                    this.resultadosFiltrados.sort((a, b) => {
                        if (a[columna] < b[columna]) return this.ordenAscendente ? -1 : 1;
                        if (a[columna] > b[columna]) return this.ordenAscendente ? 1 : -1;
                        return 0;
                    });
                    this.paginaActual = 1;
                },
                formatNumero(valor) {
                    if (valor == null || valor === '' || Number(valor) === 0) return '';
                    return Number(valor).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                },

                navigateToDocument(item) {
                    window.location.href = `/Home/DetalleDocumento?co_tipo_doc=${encodeURIComponent(item.co_tipo_doc.trim())}&nro_doc=${encodeURIComponent(item.nro_doc.trim())}&co_cli=${encodeURIComponent(this.clienteSeleccionado.co_cli.trim())}&cli_des=${encodeURIComponent(this.clienteSeleccionado.cli_des.trim())}`;
                },
                formatFecha(valor) {
                    if (!valor) return '';
                    let fecha;

                    // Si es formato /Date(1234567890)/
                    if (typeof valor === 'string' && valor.match(/\/Date\((\d+)\)\//)) {
                        const ms = parseInt(valor.match(/\/Date\((\d+)\)\//)[1], 10);
                        fecha = new Date(ms);
                    } else if (typeof valor === 'string' && valor.length === 10 && valor.match(/^\d{4}-\d{2}-\d{2}$/)) {
                        // Si es formato YYYY-MM-DD, parsear manualmente como local
                        const [anio, mes, dia] = valor.split('-');
                        fecha = new Date(Number(anio), Number(mes) - 1, Number(dia));
                    } else {
                        fecha = new Date(valor);
                    }

                    if (isNaN(fecha)) return valor;

                    const dia = ('0' + fecha.getDate()).slice(-2);
                    const mes = ('0' + (fecha.getMonth() + 1)).slice(-2);
                    const anio = fecha.getFullYear();
                    return `${dia}/${mes}/${anio}`;


                },
                limpiarBusqueda() {
                    this.txtBusqueda = '';
                    this.sugerencias = [];
                    this.resultadosFiltrados = [];
                    this.clienteSeleccionado = null;
                    this.resultadosPorCliente = [];
                    this.paginaActual = 1;
                },
                verDetalleSaldo(item) {
                    // Aquí puedes implementar la lógica para mostrar los detalles del saldo
                    // Por ejemplo, podrías mostrar un modal con información detallada
                    alert(`Detalles del saldo para el documento ${item.nro_doc}:\n` +
                        `Tipo: ${item.co_tipo_doc}\n` +
                        `Monto: ${this.formatNumero(item.saldo)}\n` +
                        `Días vencidos: ${item.Dias || '0'}\n` +
                        `Fecha emisión: ${this.formatFecha(item.fec_emis)}`);
                },
                verImagenCompleta(imagenData) {
                    // Convertir la imagen a base64 si es un array de bytes
                    let srcImagen = '';

                    if (Array.isArray(imagenData) || (imagenData instanceof Uint8Array)) {
                        // Es un array de bytes, convertir a base64
                        const bytes = new Uint8Array(imagenData);
                        let binary = '';
                        const len = bytes.byteLength;
                        for (let i = 0; i < len; i++) {
                            binary += String.fromCharCode(bytes[i]);
                        }
                        srcImagen = 'data:image/png;base64,' + window.btoa(binary);
                    } else if (typeof imagenData === 'string') {
                        // Ya es una cadena base64 o una URL de datos
                        if (imagenData.startsWith('data:image/')) {
                            srcImagen = imagenData;
                        } else {
                            srcImagen = 'data:image/png;base64,' + imagenData;
                        }
                    } else {
                        console.error('Formato de imagen no soportado:', imagenData);
                        alert('No se pudo cargar la imagen: Formato no compatible');
                        return;
                    }

                    // Si ya existe un modal, lo removemos primero
                    const modalExistente = document.getElementById('modalImagenCompleta');
                    if (modalExistente) {
                        document.body.removeChild(modalExistente);
                    }

                    // Crear el elemento modal
                    const modal = document.createElement('div');
                    modal.id = 'modalImagenCompleta';
                    modal.style.position = 'fixed';
                    modal.style.top = '0';
                    modal.style.left = '0';
                    modal.style.width = '100%';
                    modal.style.height = '100%';
                    modal.style.backgroundColor = 'rgba(0, 0, 0, 0.9)';
                    modal.style.display = 'flex';
                    modal.style.justifyContent = 'center';
                    modal.style.alignItems = 'center';
                    modal.style.zIndex = '2000';
                    modal.style.cursor = 'zoom-out';

                    // Crear el contenedor de la imagen
                    const imgContainer = document.createElement('div');
                    imgContainer.style.position = 'relative';
                    imgContainer.style.maxWidth = '90%';
                    imgContainer.style.maxHeight = '90%';
                    imgContainer.style.display = 'flex';
                    imgContainer.style.justifyContent = 'center';
                    imgContainer.style.alignItems = 'center';

                    // Crear la imagen
                    const img = document.createElement('img');
                    img.src = srcImagen;
                    img.style.maxWidth = '100%';
                    img.style.maxHeight = '90vh';
                    img.style.objectFit = 'contain';
                    img.style.borderRadius = '8px';
                    img.style.boxShadow = '0 4px 20px rgba(0,0,0,0.5)';

                    // Botón de cerrar
                    const closeBtn = document.createElement('button');
                    closeBtn.innerHTML = '&times;';
                    closeBtn.style.position = 'absolute';
                    closeBtn.style.top = '-15px';
                    closeBtn.style.right = '-15px';
                    closeBtn.style.background = '#dc3545';
                    closeBtn.style.color = 'white';
                    closeBtn.style.border = 'none';
                    closeBtn.style.borderRadius = '50%';
                    closeBtn.style.width = '30px';
                    closeBtn.style.height = '30px';
                    closeBtn.style.fontSize = '20px';
                    closeBtn.style.cursor = 'pointer';
                    closeBtn.style.display = 'flex';
                    closeBtn.style.justifyContent = 'center';
                    closeBtn.style.alignItems = 'center';
                    closeBtn.style.paddingBottom = '3px';
                    closeBtn.style.boxSizing = 'border-box';
                    closeBtn.onclick = (e) => {
                        e.stopPropagation();
                        document.body.removeChild(modal);
                    };

                    // Evitar que el clic en la imagen cierre el modal
                    img.onclick = function (e) {
                        e.stopPropagation();
                    };

                    // Cerrar el modal al hacer clic fuera de la imagen
                    modal.onclick = () => {
                        document.body.removeChild(modal);
                    };

                    // Agregar elementos al DOM
                    imgContainer.appendChild(img);
                    imgContainer.appendChild(closeBtn);
                    modal.appendChild(imgContainer);

                    // Agregar el modal al body
                    document.body.appendChild(modal);

                    // Cerrar con la tecla ESC
                    const keyHandler = (e) => {
                        if (e.key === 'Escape') {
                            document.body.removeChild(modal);
                            document.removeEventListener('keydown', keyHandler);
                        }
                    };
                    document.addEventListener('keydown', keyHandler);
                },
                sumaCol(campo) {
                    return this.resultadosPorCliente.reduce((acc, item) => {
                        let val = Number(item[campo]);
                        return acc + (isNaN(val) ? 0 : val);
                    }, 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                },
                sumaColSuma() {
                    return this.resultadosPorCliente.reduce((acc, item) => {
                        let monto = Number(item.monto_bru) || 0;
                        let iva = Number(item.IVA25) || 0;
                        return acc + monto + iva;
                    }, 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                },

                highlight(text) {
                    if (!this.txtBusqueda) return text;
                    const regex = new RegExp(`(${this.txtBusqueda})`, 'gi');
                    return text != null
                        ? text.toString().replace(regex, '<span class="highlight">$1</span>')
                        : '';
                },


                // Función modificada
                imprimirPDF() {
                    const { jsPDF } = window.jspdf;
                    const doc = new jsPDF();

                    // Logo importado desde logoConfig.js
                    doc.addImage(logoBase64, 'PNG', 10, 8, 40, 40);

                    // Encabezado tipo tabla para cliente
                    doc.autoTable({
                        startY: 60,
                        head: [[
                            { content: ' Código Cliente', styles: { fillColor: [21, 101, 192], textColor: 255, fontStyle: 'bold', halign: 'left' } },
                            { content: ' Nombre Cliente', styles: { fillColor: [21, 101, 192], textColor: 255, fontStyle: 'bold', halign: 'left' } }
                        ]],
                        body: [[
                            { content: this.clienteSeleccionado.co_cli, styles: { fillColor: [229, 200, 112], textColor: 20, fontStyle: 'bold' } },
                            { content: this.clienteSeleccionado.cli_des, styles: { fillColor: [229, 200, 112], textColor: 20, fontStyle: 'bold' } }
                        ]],
                        theme: 'plain',
                        styles: {
                            fontSize: 12,
                            cellPadding: 4,
                            lineWidth: 0.5,
                            lineColor: [200, 200, 200]
                        },
                        headStyles: {
                            fontStyle: 'bold'
                        },
                        margin: { left: 10, right: 10 }
                    });

                    let y = doc.lastAutoTable.finalY + 8;

                    // Definir columnas igual que en la tabla de la página
                    const columns = [
                        { header: 'Tipo Doc', dataKey: 'co_tipo_doc' },
                        { header: 'Nro Doc', dataKey: 'nro_doc' },
                        { header: 'Fecha', dataKey: 'fec_emis' },
                        { header: 'Días', dataKey: 'Dias' },
                        { header: 'IVA 25%', dataKey: 'IVA25' },
                        { header: 'IVA 75%', dataKey: 'estado_retencion' },
                        { header: 'Sub+ IVA25%', dataKey: 'sub_iva25' },
                        { header: 'Sub Total', dataKey: 'monto_bru' },
                        { header: 'IVA', dataKey: 'monto_imp' },
                        { header: 'Saldo', dataKey: 'saldo' }
                    ];

                    // Prepara los datos
                    const rows = this.resultadosPorCliente.map(item => ({
                        co_tipo_doc: item.co_tipo_doc,
                        nro_doc: item.nro_doc,
                        fec_emis: this.formatFecha(item.fec_emis),
                        Dias: item.Dias,
                        IVA25: this.formatNumero(item.IVA25),
                        estado_retencion: item.estado_retencion,
                        sub_iva25: this.formatNumero(Number(item.monto_bru) + Number(item.IVA25)),
                        monto_bru: this.formatNumero(item.monto_bru),
                        monto_imp: this.formatNumero(item.monto_imp),
                        saldo: this.formatNumero(item.saldo)
                    }));

                    // Totales si hay más de un documento
                    let foot = [];

                    if (this.resultadosPorCliente.length > 1) {
                        foot = [[
                            { content: 'Totales:', colSpan: 9, styles: { halign: 'right', fontStyle: 'bold' } },
                            { content: this.sumaCol('saldo'), styles: { fontStyle: 'bold' } }
                        ]];
                    }

                    // Usa AutoTable para crear la tabla con colores
                    doc.autoTable({
                        startY: y,
                        head: [columns.map(col => col.header)],
                        body: rows.map(row => columns.map(col => row[col.dataKey])),
                        foot: foot,
                        styles: {
                            fontSize: 9,
                            cellPadding: 2,
                        },
                        headStyles: {
                            fillColor: [21, 101, 192], // Azul cabecera
                            textColor: 255,
                            fontStyle: 'bold'
                        },
                        footStyles: {
                            fillColor: [227, 242, 253], // Azul claro para totales
                            textColor: 0,
                            fontStyle: 'bold'
                        },
                        alternateRowStyles: {
                            fillColor: [249, 249, 249] // Gris claro para filas impares
                        },
                        bodyStyles: {
                            textColor: 20
                        }
                    });

                    // Log de impresión
                    let finalY = doc.lastAutoTable.finalY + 10;
                    doc.setFontSize(10);
                    //doc.text(`Impreso por: ${window.usuarioActual || 'Usuario'}`, 10, finalY);
                    //finalY += 6;
                    doc.text(`Fecha de impresión: ${new Date().toLocaleString()}`, 10, finalY);

                    doc.save(`Cliente_${this.clienteSeleccionado.co_cli}.pdf`);
                }
            },

            created() {
                this.buscarSugerenciasDebounced = debounce(this.buscarSugerencias, 300);
                // Si hay parámetros iniciales y debe cargar automáticamente, realiza la búsqueda
                if (cargarAutomaticamente && initialCoCli && initialCliDes) {
                    this.txtBusqueda = initialCliDes;
                    this.getBsuqueda();
                }
            },
            mounted() {
                // Asegurar que la selección automática funcione después de que Vue esté completamente montado
                if (cargarAutomaticamente && initialCoCli && initialCliDes) {
                    // Intentar seleccionar el cliente varias veces en caso de que la búsqueda tarde
                    let intentos = 0;
                    const maxIntentos = 10;
                    const interval = setInterval(() => {
                        intentos++;
                        if (this.todosResultados.length > 0) {
                            const cliente = this.todosResultados.find(x => 
                                x.co_cli && x.co_cli.trim() === initialCoCli.trim() && 
                                x.cli_des && x.cli_des.trim() === initialCliDes.trim()
                            );
                            if (cliente) {
                                this.seleccionarCliente(cliente);
                                clearInterval(interval);
                            }
                        }
                        if (intentos >= maxIntentos) {
                            clearInterval(interval);
                            console.warn('No se pudo seleccionar automáticamente el cliente después de varios intentos');
                        }
                    }, 500);
                }
            }
        });
    </script>
}