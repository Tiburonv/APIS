@model APIS.Models.VercotizacionViewModel

@{
    var hoy = DateTime.Today;
    var mostrarTodas = Model.FechaInicio.HasValue || Model.FechaFin.HasValue;
    var cotizacionesFiltradas = mostrarTodas ?
        Model.Cotizaciones :
        Model.Cotizaciones.Where(c => c.fec_emis.Date == hoy).ToList();

    var titulo = mostrarTodas ?
   "Cotizaciones" :
   string.Format("Cotizaciones del Día ({0})", hoy.ToString("dd/MM/yyyy"));
}

<div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@titulo</h2>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#filtroFechasModal">
            <i class="fas fa-calendar-alt me-1"></i> Filtrar por Fechas
        </button>
    </div>

    <!-- Modal para el filtro de fechas -->
    <div class="modal fade" id="filtroFechasModal" tabindex="-1" aria-labelledby="filtroFechasModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="filtroFechasModalLabel">Filtrar por Rango de Fechas</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <form method="get" action="@Url.Action("Vercotizacion", "Cotizacion")">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="fechaInicio" class="form-label">Fecha de Inicio</label>
                            <input type="date" class="form-control" id="fechaInicio" name="fechaInicio" value="@ViewBag.FechaInicio">
                        </div>
                        <div class="mb-3">
                            <label for="fechaFin" class="form-label">Fecha de Fin</label>
                            <input type="date" class="form-control" id="fechaFin" name="fechaFin" value="@(ViewBag.FechaFin ?? DateTime.Today.ToString("yyyy-MM-dd"))">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <a href="@Url.Action("Vercotizacion", "Cotizacion")" class="btn btn-secondary me-2">
                            <i class="fas fa-times me-1"></i> Limpiar Filtros
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-search me-1"></i> Buscar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (cotizacionesFiltradas.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover table-striped">
                <thead class="table-primary">
                    <tr>
                        <th>Nro Cotización</th>
                        <th>Fecha</th>
                        <th>Código Cliente</th>
                        <th>Nombre del Cliente</th>
                        <th class="text-end">Total Neto</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cot in cotizacionesFiltradas)
                    {
                        var docNumLimpio = cot.doc_num.Trim();
                        <tr style="cursor: pointer;" onclick="window.location.href='@Url.Action("DetalleCotizacion", "Cotizacion", new { id = docNumLimpio })'" onmouseover="this.style.backgroundColor='#f5f5f5'" onmouseout="this.style.backgroundColor=''">
                            <td class="fw-bold text-primary">
                                #@docNumLimpio
                            </td>
                            <td>@cot.fec_emis.ToString("dd/MM/yyyy")</td>
                            <td>@cot.co_cli</td>
                            <td>@(Model.Clientes.ContainsKey(cot.co_cli) ? Model.Clientes[cot.co_cli] : cot.co_cli)</td>
                            <td class="text-end">@cot.total_neto.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            @if (mostrarTodas)
            {
                <span>No se encontraron cotizaciones en el rango de fechas seleccionado.</span>
            }
            else
            {
                <span>No hay cotizaciones registradas para el día de hoy.</span>
            }
        </div>
    }
</div>

<style>
    .table th {
        font-weight: 600;
    }

    .table td {
        vertical-align: middle;
    }

    .table-hover tbody tr:hover {
        background-color: #f5f5f5;
    }
</style>