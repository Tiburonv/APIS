@model APIS.Models.DetalleCotizacionViewModel
@using Newtonsoft.Json
@{
    ViewBag.Title = "Detalle de Cotización";
    var cotizacion = Model.Cotizacion;
    var usCulture = System.Globalization.CultureInfo.GetCultureInfo("en-US");
    var totalBs = cotizacion.total_neto * cotizacion.tasa;
}

<style>
    /* DetalleCotizacion v2.0 */
    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 14px;
        margin-bottom: 4px;
    }
    .info-field {
        display: flex; flex-direction: column; gap: 3px;
    }
    .info-field__label {
        font-size: 0.72rem; font-weight: 700; text-transform: uppercase;
        letter-spacing: 0.07em; color: #94a3b8;
    }
    .info-field__value {
        font-size: 0.97rem; font-weight: 600; color: #1e293b;
    }
    .info-field__value.mono {
        font-family: monospace; font-size: 0.88rem;
        background: #f1f5f9; padding: 2px 8px; border-radius: 5px;
        display: inline-block; color: #64748b;
    }
    .tasa-pill {
        display: inline-flex; align-items: center; gap: 6px;
        background: linear-gradient(135deg, #0284c7 0%, #0ea5e9 100%);
        color: #fff; border-radius: 999px; padding: 4px 14px;
        font-size: 0.85rem; font-weight: 700;
        box-shadow: 0 2px 8px rgba(2,132,199,0.3);
        font-variant-numeric: tabular-nums;
    }

    .totals-card {
        background: linear-gradient(135deg, #eff6ff 0%, #f0fdf4 100%);
        border: 1.5px solid #bfdbfe; border-radius: 14px;
        padding: 18px 22px; margin-top: 4px;
    }
    .total-row {
        display: flex; align-items: center; justify-content: space-between;
        padding: 7px 0; border-bottom: 1px solid rgba(226,232,240,0.7);
        font-size: 0.92rem;
    }
    .total-row:last-child { border-bottom: none; }
    .total-row__label { color: #64748b; font-weight: 500; }
    .total-row__usd { font-weight: 700; color: #1e293b; font-variant-numeric: tabular-nums; }
    .total-row__bs  { font-size: 0.82rem; color: #64748b; font-variant-numeric: tabular-nums; min-width: 120px; text-align: right; }
    .total-row.is-grand .total-row__label { font-size: 1rem; font-weight: 700; color: #1565c0; }
    .total-row.is-grand .total-row__usd   { font-size: 1.15rem; color: #059669; }
    .total-row.is-grand .total-row__bs    { font-size: 0.9rem; color: #059669; font-weight: 600; }

    .item-code {
        font-family: monospace; font-size: 0.82rem;
        background: #f1f5f9; padding: 2px 7px; border-radius: 4px; color: #64748b;
    }
    .iva-badge {
        background: #fffbeb; border: 1px solid #fde68a; color: #b45309;
        border-radius: 5px; padding: 2px 8px; font-size: 0.8rem; font-weight: 600;
        font-variant-numeric: tabular-nums;
    }
    .row-num {
        width: 24px; height: 24px; border-radius: 50%;
        background: #e0e7ff; color: #3730a3; font-size: 0.72rem; font-weight: 700;
        display: inline-flex; align-items: center; justify-content: center;
    }
</style>

<div class="container-fluid">

    <!-- Page Header -->
    <div class="page-header">
        <div>
            <h1 class="page-header__title">
                <span class="ph-icon"><i class="fas fa-file-invoice"></i></span>
                Cotización <span style="color:#1e88e5;">#@cotizacion.doc_num.Trim()</span>
            </h1>
            <p class="page-header__subtitle">
                @cotizacion.fec_emis.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-ES"))
            </p>
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;">
            <button type="button" class="btn btn-success" id="btnImprimirPdfDetalle">
                <i class="fas fa-file-pdf"></i> Exportar PDF
            </button>
            <a href="@Url.Action("Vercotizacion")" class="btn btn-outline-primary">
                <i class="fas fa-arrow-left"></i> Volver
            </a>
        </div>
    </div>

    <!-- Info General Card -->
    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-info-circle me-2"></i>Información General
        </div>
        <div class="card-body">
            <div class="info-grid">
                <div class="info-field">
                    <span class="info-field__label">Cliente</span>
                    <span class="info-field__value">@Model.DescripcionCliente</span>
                </div>
                <div class="info-field">
                    <span class="info-field__label">Código de Cliente</span>
                    <span class="info-field__value mono">@cotizacion.co_cli</span>
                </div>
                <div class="info-field">
                    <span class="info-field__label">Nro. Cotización</span>
                    <span class="info-field__value" style="color:#1565c0;">#@cotizacion.doc_num.Trim()</span>
                </div>
                <div class="info-field">
                    <span class="info-field__label">Fecha de Emisión</span>
                    <span class="info-field__value">@cotizacion.fec_emis.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="info-field">
                    <span class="info-field__label">Tasa BCV</span>
                    <span class="tasa-pill">
                        <i class="fas fa-exchange-alt" style="font-size:0.75rem;"></i>
                        @cotizacion.tasa.ToString("N5") Bs/$
                    </span>
                </div>
                <div class="info-field">
                    <span class="info-field__label">Total en Bs.</span>
                    <span class="info-field__value" style="color:#059669;font-size:1.1rem;">
                        @totalBs.ToString("N2") Bs.
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Productos Card -->
    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-boxes me-2"></i>
            Productos
            <span class="badge" style="background:rgba(255,255,255,0.2);font-weight:600;margin-left:8px;">
                @Model.Renglones.Count() artículo(s)
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th class="cabecera-azul-claro" style="width:36px;">#</th>
                            <th class="cabecera-azul-claro">Código</th>
                            <th class="cabecera-azul-claro">Descripción</th>
                            <th class="cabecera-azul-claro text-end">Cantidad</th>
                            <th class="cabecera-azul-claro text-end">Precio Unit.</th>
                            <th class="cabecera-azul-claro text-end">IVA</th>
                            <th class="cabecera-azul-claro text-end">Total USD</th>
                            <th class="cabecera-azul-claro text-end">Total Bs.</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int rowNum = 0; }
                        @foreach (var item in Model.Renglones)
                        {
                            rowNum++;
                            var tieneIva = item.tipo_imp == 1;
                            var desc = Model.DescripcionesArticulos.ContainsKey(item.co_art.Trim())
                                ? Model.DescripcionesArticulos[item.co_art.Trim()] : item.co_art;
                            <tr>
                                <td class="text-center">
                                    <span class="row-num">@rowNum</span>
                                </td>
                                <td><span class="item-code">@item.co_art.Trim()</span></td>
                                <td style="font-weight:500;color:#1e293b;">@desc</td>
                                <td class="text-end" style="font-variant-numeric:tabular-nums;">
                                    @item.total_art.ToString("N2")
                                </td>
                                <td class="text-end" style="font-variant-numeric:tabular-nums;">
                                    @item.prec_vta.ToString("C", usCulture)
                                </td>
                                <td class="text-end">
                                    @if (tieneIva)
                                    {
                                        <span class="iva-badge">@item.monto_imp.ToString("C", usCulture)</span>
                                    }
                                    else
                                    {
                                        <span style="color:#cbd5e1;font-size:0.8rem;">—</span>
                                    }
                                </td>
                                <td class="text-end" style="font-weight:600;font-variant-numeric:tabular-nums;">
                                    @item.reng_neto.ToString("C", usCulture)
                                </td>
                                <td class="text-end" style="color:#64748b;font-variant-numeric:tabular-nums;">
                                    @((item.reng_neto * cotizacion.tasa).ToString("N2")) Bs.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Totales -->
    <div class="row justify-content-end">
        <div class="col-12 col-md-5">
            <div class="totals-card">
                <div class="total-row">
                    <span class="total-row__label"><i class="fas fa-calculator me-1" style="color:#94a3b8;"></i>Subtotal</span>
                    <span class="total-row__usd">@cotizacion.total_bruto.ToString("C", usCulture)</span>
                    <span class="total-row__bs">@((cotizacion.total_bruto * cotizacion.tasa).ToString("N2")) Bs.</span>
                </div>
                <div class="total-row">
                    <span class="total-row__label"><i class="fas fa-percent me-1" style="color:#94a3b8;"></i>IVA</span>
                    <span class="total-row__usd">@cotizacion.monto_imp.ToString("C", usCulture)</span>
                    <span class="total-row__bs">@((cotizacion.monto_imp * cotizacion.tasa).ToString("N2")) Bs.</span>
                </div>
                <div class="total-row is-grand">
                    <span class="total-row__label"><i class="fas fa-check-circle me-1"></i>Total Neto</span>
                    <span class="total-row__usd">@cotizacion.total_neto.ToString("C", usCulture)</span>
                    <span class="total-row__bs">@((cotizacion.total_neto * cotizacion.tasa).ToString("N2")) Bs.</span>
                </div>
            </div>
        </div>
    </div>

</div>

@section scripts {
    <script src="~/Content/Imagen/logoConfig.js"></script>
    <script src="~/Content/Imagen/pdfEncabezado.js?v=20250528"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
    <script>
        (function () {
            var docNum      = @Html.Raw(JsonConvert.SerializeObject(cotizacion.doc_num.Trim()));
            var cliente     = @Html.Raw(JsonConvert.SerializeObject(Model.DescripcionCliente));
            var coCli       = @Html.Raw(JsonConvert.SerializeObject(cotizacion.co_cli));
            var fecha       = @Html.Raw(JsonConvert.SerializeObject(cotizacion.fec_emis.ToString("dd/MM/yyyy")));
            var tasa        = @Html.Raw(JsonConvert.SerializeObject(cotizacion.tasa));
            var subtotal    = @Html.Raw(JsonConvert.SerializeObject(cotizacion.total_bruto.ToString("C", usCulture)));
            var impuestos   = @Html.Raw(JsonConvert.SerializeObject(cotizacion.monto_imp.ToString("C", usCulture)));
            var totalNeto   = @Html.Raw(JsonConvert.SerializeObject(cotizacion.total_neto.ToString("C", usCulture)));
            var subtotalNum = @Html.Raw(JsonConvert.SerializeObject(cotizacion.total_bruto));
            var impuestosNum = @Html.Raw(JsonConvert.SerializeObject(cotizacion.monto_imp));
            var totalNetoNum = @Html.Raw(JsonConvert.SerializeObject(cotizacion.total_neto));
            var renglones   = @Html.Raw(JsonConvert.SerializeObject(
                Model.Renglones.Select(item => new {
                    co_art      = item.co_art.Trim(),
                    descripcion = Model.DescripcionesArticulos.ContainsKey(item.co_art.Trim())
                                  ? Model.DescripcionesArticulos[item.co_art.Trim()] : item.co_art.Trim(),
                    cantidad    = item.total_art.ToString("N2"),
                    precio      = item.prec_vta.ToString("C", usCulture),
                    iva         = item.tipo_imp == 1 ? item.monto_imp.ToString("C", usCulture) : "",
                    total       = item.reng_neto.ToString("C", usCulture),
                    reng_neto   = item.reng_neto
                })
            ));

            function montoBs(monto) {
                var t = parseFloat(tasa) || 0;
                var m = parseFloat(monto) || 0;
                if (t <= 0) return '-';
                return (m * t).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' Bs.';
            }

            var estiloPie = { fillColor: [239, 246, 255], textColor: 0, fontStyle: 'bold', halign: 'right' };

            document.getElementById('btnImprimirPdfDetalle').addEventListener('click', function () {
                var jsPDF = window.jspdf.jsPDF;
                var doc = new jsPDF();
                window.agregarEncabezadoPdf(doc).then(function (startY) {
                    doc.setFontSize(16);
                    doc.text('Cotizacion #' + docNum, 14, startY + 4);
                    doc.setFontSize(11);
                    doc.text('Cliente: ' + cliente, 14, startY + 12);
                    doc.text('Codigo: ' + coCli + '   Fecha: ' + fecha + '   Tasa BCV: ' + parseFloat(tasa).toFixed(5), 14, startY + 18);

                    var rows = renglones.map(function (r) {
                        return [r.co_art, r.descripcion, r.cantidad, r.precio, r.iva, r.total, montoBs(r.reng_neto)];
                    });

                    doc.autoTable({
                        startY: startY + 26,
                        head: [['Código', 'Descripción', 'Cantidad', 'Precio Unit.', 'IVA', 'Total USD', 'Total Bs.']],
                        body: rows,
                        foot: [
                            [{ content: '', colSpan: 4, styles: estiloPie }, { content: 'Subtotal:', styles: estiloPie }, { content: subtotal, styles: estiloPie }, { content: montoBs(subtotalNum), styles: estiloPie }],
                            [{ content: 'IVA:', colSpan: 5, styles: estiloPie }, { content: impuestos, styles: estiloPie }, { content: montoBs(impuestosNum), styles: estiloPie }],
                            [{ content: '', colSpan: 4, styles: estiloPie }, { content: 'Total Neto:', styles: estiloPie }, { content: totalNeto, styles: estiloPie }, { content: montoBs(totalNetoNum), styles: estiloPie }]
                        ],
                        styles: { fontSize: 9, cellPadding: 2, textColor: 0 },
                        headStyles: { fillColor: [21, 101, 192], textColor: 255, fontStyle: 'bold' },
                        footStyles: { fillColor: [239, 246, 255], textColor: 0, fontStyle: 'bold' },
                        columnStyles: { 2: { halign: 'right' }, 3: { halign: 'right' }, 4: { halign: 'right' }, 5: { halign: 'right' }, 6: { halign: 'right' } }
                    });

                    doc.save('Cotizacion_' + docNum + '.pdf');
                });
            });
        })();
    </script>
}